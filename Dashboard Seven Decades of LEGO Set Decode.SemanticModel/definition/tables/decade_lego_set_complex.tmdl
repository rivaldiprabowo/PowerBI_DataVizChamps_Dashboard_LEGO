	column AccentColor =
			
			SWITCH(
			    TRUE(),
			    decade_lego_set_complex[Set Complexity] = "Micro", "#008300",
			    decade_lego_set_complex[Set Complexity] = "Small", "#2a78d6",
			    decade_lego_set_complex[Set Complexity] = "Medium", "#eda100",
			    decade_lego_set_complex[Set Complexity] = "Large", "#eb6834",
			    decade_lego_set_complex[Set Complexity] = "Mega", "#e34948"
