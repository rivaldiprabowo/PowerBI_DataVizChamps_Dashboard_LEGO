	column 'Part Count Category'
		lineageTag: fddae8aa-4fed-4701-a629-2fba96ac28f3
		summarizeBy: none
		isNameInferred
		sourceColumn: [Part Count Category]

		annotation SummarizationSetBy = Automatic

	partition decade_lego_set_complex = calculated
		mode: import
		source =
				
				
				SELECTCOLUMNS (
				    SUMMARIZE (
				        sets,
				        sets[decade],
				        sets[decade_order],
				        sets[complexity_tier]
				    ),
				    "Decade", sets[decade],
				    "Decade Order", sets[decade_order],
				    "Set Complexity", sets[complexity_tier],
				    "Set Complexity Order", CALCULATE(MAX('sets'[set_complexity_order])),
				    "Number of Sets", CALCULATE ( COUNT(sets[set_number]) ),
				    "Avg Part per Set", ROUND(CALCULATE ( DIVIDE ( SUM ( sets[number_of_parts] ), COUNT ( sets[set_number] ), 0 ) ),2),
				    "Total Set per Decade", CALCULATE ( COUNT ( sets[set_number] ), ALLEXCEPT ( sets, sets[decade], sets[decade_order] ) ),
				    "Representative Set Name",
				        VAR TopSet =
				            TOPN(
				                1,
				                CALCULATETABLE(sets),
				                sets[number_of_parts], DESC,
				                sets[set_number], ASC        -- tiebreaker: guarantees same row every time
				            )
				        RETURN
				            MAXX(TopSet, sets[set_name]),
				    "Representative Set Image",
				        VAR TopSet =
				            TOPN(
				                1,
				                CALCULATETABLE(sets),
				                sets[number_of_parts], DESC,
				                sets[set_number], ASC
				            )
				        RETURN
				            MAXX(TopSet, sets[img_url]),
				    "Representative Set Total Part",
				        VAR TopSet =
				            TOPN(
				                1,
				                CALCULATETABLE(sets),
				                sets[number_of_parts], DESC,
				                sets[set_number], ASC
				            )
				        RETURN
				            MAXX(TopSet, sets[number_of_parts]),
				    "Part Count Category", SWITCH(
				        TRUE(),
				        sets[complexity_tier] = "Micro", "1-19 Parts",
				        sets[complexity_tier] = "Small", "20-89 Parts",
				        sets[complexity_tier] = "Medium", "90-219 Parts",
				        sets[complexity_tier] = "Large", "220-700 Parts",
				        sets[complexity_tier] = "Mega", ">700 Parts"
				    )
				)

	annotation PBI_Id = 67b1b54c16d44a2d9b3a8682e0446430

