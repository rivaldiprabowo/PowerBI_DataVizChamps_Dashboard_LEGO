		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column complexity_tier =
			
			SWITCH(
			    TRUE(),
			    sets[bin_index] <= 3, "Micro",
			    sets[bin_index] <= 7, "Small",
			    sets[bin_index] <= 10, "Medium",
			    sets[bin_index] <= 13, "Large",
