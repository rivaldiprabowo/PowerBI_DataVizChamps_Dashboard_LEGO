	column total_colors =
			
			VAR txt = TRIM(sets[set_colors])
			VAR CountSeparator =
			    DIVIDE(
			        LEN(txt) - LEN(SUBSTITUTE(txt, "||", "")),
			        2
			    )
			RETURN
			COALESCE(CountSeparator, 0)
		lineageTag: 850d77b6-b913-4c96-97c6-372892617d52
