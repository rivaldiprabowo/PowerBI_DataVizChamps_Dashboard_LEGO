	column total_minifigs =
			
			VAR txt = TRIM(sets[mini_figures])
			VAR CountSeparator =
			    DIVIDE(
			        LEN(txt) - LEN(SUBSTITUTE(txt, "||", "")),
			        2
			    )
			RETURN
			COALESCE(CountSeparator, 0)
		formatString: 0
		lineageTag: a02e20f7-e6a5-4bce-ad0f-c7568d8ab67e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column minifig_tier =
			
			SWITCH(
			    TRUE(),
			    sets[total_minifigs] = 0, "None",
			    sets[total_minifigs] = 1, "Solo",
			    sets[total_minifigs] <= 3, "Small Crew",
			    sets[total_minifigs] <= 6, "Squad",
			    "Large Cast"
			)
		lineageTag: 77b08f60-170b-44d3-a982-34f9bd7eeb79
