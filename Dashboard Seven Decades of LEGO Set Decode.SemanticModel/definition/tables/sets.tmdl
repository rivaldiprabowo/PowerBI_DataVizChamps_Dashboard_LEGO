	column color_group =
			
			VAR c = [set_colors]
			RETURN
			SWITCH(
			    TRUE(),
			    'sets'[set_colors] = BLANK(),BLANK(),
			    CONTAINSSTRING(c,"Unknown") || CONTAINSSTRING(c,"No Color") || CONTAINSSTRING(c,"Any Color"), "Other",
			    CONTAINSSTRING(c,"Glow In Dark White") || CONTAINSSTRING(c,"Glow In Dark Opaque") || CONTAINSSTRING(c,"Milky White"), "White",
			    CONTAINSSTRING(c,"Glow In Dark"), "Other",
			    CONTAINSSTRING(c,"Blue-Violet") || CONTAINSSTRING(c,"Bluish Violet") || CONTAINSSTRING(c,"Reddish Lilac"), "Purple",
			    CONTAINSSTRING(c,"Yellowish Green"), "Green",
			    CONTAINSSTRING(c,"Reddish Orange") || CONTAINSSTRING(c,"Yellowish Orange") || CONTAINSSTRING(c,"Terracotta") || CONTAINSSTRING(c,"Rust"), "Orange",
			    CONTAINSSTRING(c,"Reddish Brown"), "Brown",
			    CONTAINSSTRING(c,"Reddish Gold") || CONTAINSSTRING(c,"Lemon") || CONTAINSSTRING(c,"Curry") || CONTAINSSTRING(c,"Ochre") || CONTAINSSTRING(c,"Gold"), "Yellow",
			    CONTAINSSTRING(c,"Sand Green"), "Green",
			    CONTAINSSTRING(c,"Sand Blue"), "Blue",
			    CONTAINSSTRING(c,"Sand Red"), "Red",
			    CONTAINSSTRING(c,"Sand Purple"), "Purple",
			    CONTAINSSTRING(c,"Blue-Gray") || CONTAINSSTRING(c,"Titanium") || CONTAINSSTRING(c,"Silver"), "Gray",
			    CONTAINSSTRING(c,"Warm Tan") || CONTAINSSTRING(c,"Buff") || CONTAINSSTRING(c,"Nougat"), "Tan",
			    CONTAINSSTRING(c,"Brass") || CONTAINSSTRING(c,"Copper"), "Brown",
			    CONTAINSSTRING(c,"Coral") || CONTAINSSTRING(c,"Salmon") || CONTAINSSTRING(c,"Rose") || CONTAINSSTRING(c,"Magenta") || CONTAINSSTRING(c,"Pink"), "Pink",
			    CONTAINSSTRING(c,"Clear"), "Other",
			    c = "Metal", "Gray",
			    CONTAINSSTRING(c,"Turquoise") || CONTAINSSTRING(c,"Aqua") || CONTAINSSTRING(c,"Azure") || CONTAINSSTRING(c,"Cyan") || CONTAINSSTRING(c,"Teal"), "Turquoise",
			    CONTAINSSTRING(c,"Violet") || CONTAINSSTRING(c,"Lavender") || CONTAINSSTRING(c,"Lilac") || CONTAINSSTRING(c,"Purple"), "Purple",
			    CONTAINSSTRING(c,"Lime") || CONTAINSSTRING(c,"Olive") || CONTAINSSTRING(c,"Green"), "Green",
			    CONTAINSSTRING(c,"Yellow"), "Yellow",
			    CONTAINSSTRING(c,"Orange"), "Orange",
			    CONTAINSSTRING(c,"Red"), "Red",
			    CONTAINSSTRING(c,"Tan"), "Tan",
			    CONTAINSSTRING(c,"Brown") || CONTAINSSTRING(c,"Umber") || CONTAINSSTRING(c,"Sienna"), "Brown",
			    CONTAINSSTRING(c,"Black"), "Black",
			    CONTAINSSTRING(c,"White"), "White",
			    CONTAINSSTRING(c,"Gray") || CONTAINSSTRING(c,"Grey"), "Gray",
			    CONTAINSSTRING(c,"Blue"), "Blue",
			    "Other"
			)
		lineageTag: 55757b2a-7b01-4712-9afa-78837550f947
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column transparent_colors = COALESCE(LOOKUPVALUE('colors'[Is transparent],colors[Color],sets[set_colors]),BLANK())
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 4c86dd9d-93f0-4601-bc0e-766f67c6bead
