	column parts_number =
			
			VAR Names = SUMMARIZE(RELATEDTABLE('inventories'), 'inventories'[part_number])
			RETURN
			CONCATENATEX(Names, 'inventories'[part_number], "||")
		lineageTag: c36b6f60-fc65-4c24-95dd-2cb26fcebe3d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column distinct_count_parts =
			
			VAR txt = SUBSTITUTE ( TRIM ( sets[parts_number] ), "||", "|" )
			VAR NumTokens = IF ( txt = "" || ISBLANK ( txt ), 0, PATHLENGTH ( txt ) )
			VAR TokenTable =
			    ADDCOLUMNS (
			        GENERATESERIES ( 1, NumTokens, 1 ),
			        "PartNum", PATHITEM ( txt, [Value], TEXT )
			    )
			RETURN
			    COALESCE ( COUNTROWS ( DISTINCT ( SELECTCOLUMNS ( TokenTable, "PartNum", [PartNum] ) ) ), 0 )
		lineageTag: db96ecd6-5f4b-41c6-a87b-c035da435a33
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column part_variety_tier =
			
			VAR v = sets[distinct_count_parts]
			RETURN
			    SWITCH (
			        TRUE (),
			        v = 0,   "None",
			        v <= 7,   "Simple Build",
			        v <= 22,  "Mixed Build",
			        v <= 62,  "Varied Build",
			        "Complex Assembly"
			    )
		lineageTag: 344775a9-9fcf-4f8e-ba2a-c6a3d9c92516
		summarizeBy: none
		sortByColumn: part_variety_tier_order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column part_variety_tier_order =
			
			VAR v = sets[distinct_count_parts]
			RETURN
			    SWITCH (
			        TRUE (),
			        v = 0,   1,
			        v <= 7,   2,
			        v <= 22,  3,
			        v <= 62,  4,
			        5
			    )
		formatString: 0
		lineageTag: 933918c4-9442-4780-a37b-6f331c22ee23
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column set_color_age =
			
			VAR Names = SUMMARIZE(RELATEDTABLE('inventories'), 'inventories'[set_color_age])
			RETURN
			CONCATENATEX(Names, 'inventories'[set_color_age], "||")
		lineageTag: 8ebd6cab-81c6-45a3-9d1e-1fc0e0e5c7b4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column avg_color_age =
			
			VAR txt0 = SUBSTITUTE ( TRIM ( sets[set_color_age] ), "||", "|" )
			VAR txt =
			    IF ( LEFT ( txt0, 1 ) = "|", MID ( txt0, 2, LEN ( txt0 ) - 1 ), txt0 )
			VAR NumTokens = IF ( txt = "" || ISBLANK ( txt ), 0, PATHLENGTH ( txt ) )
			VAR TokenTable =
			    FILTER (
			        ADDCOLUMNS (
			            GENERATESERIES ( 1, NumTokens, 1 ),
			            "NumericValue",
			                IFERROR ( VALUE ( PATHITEM ( txt, [Value], TEXT ) ), BLANK () )
			        ),
			        NOT ISBLANK ( [NumericValue] )
			    )
			RETURN
			    COALESCE ( AVERAGEX ( TokenTable, [NumericValue] ), 0 )
		lineageTag: 86f6c800-8627-40c8-a4d3-46e19e26fbc2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column color_age_tier =
			
			VAR v = sets[avg_color_age]
			RETURN
			    SWITCH (
			        TRUE (),
			        v = 0,   "None",
			        v <= 15, "Young Age",
			        v <= 35, "Modern Age",
			        v <= 45, "Mature Age",
			        "Old Age"
			    )
		lineageTag: 42a00033-cf9e-439d-a55d-3211a55ee5f9
		summarizeBy: none
		sortByColumn: color_age_tier_order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column color_age_tier_order =
			
			VAR v = sets[avg_color_age]
			RETURN
			    SWITCH (
			        TRUE (),
			        v = 0,     5,
			        v <= 15,    4,
			        v <= 35, 3,
			        v <= 45, 2,
			        1
			    )
		formatString: 0
		lineageTag: 2f83e635-9f98-4185-b5f8-b0b737b1702e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column minifig_tier_order =
			
			SWITCH(
			    TRUE(),
			    sets[total_minifigs] = 0, 1,
			    sets[total_minifigs] = 1, 2,
			    sets[total_minifigs] <= 3, 3,
			    sets[total_minifigs] <= 6, 4,
			    5
			)
		formatString: 0
		lineageTag: da9e5a36-5a89-44ad-a037-ff2bceb2242f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Weighted Similarity' =
			
			'sets'[set_complexity_order] * 0.25 / 5 +
			'sets'[part_variety_tier_order] * 0.20 /5+
			'sets'[color_variety_order] * 0.20 /5+
			'sets'[minifig_tier_order] * 0.20 /5+
			'sets'[color_age_tier_order] * 0.15 /5
		lineageTag: aeb122c0-8d49-45ad-9ca6-92c3a98a2f5b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Theme Name' = RELATED(themes[theme])
		lineageTag: 09463d96-20b1-4c13-8272-4f0af2111da7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Theme Level 1' = RELATED('themes'[Theme Level 1])
		lineageTag: af0267d9-f37d-499a-8ab0-335097914431
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column set_personality_description =
			
			VAR _SetName      = sets[set_name]
			VAR _Complexity   = sets[complexity_tier]
			VAR _Minifig      = sets[minifig_tier]
			VAR _ColorVariety = sets[color_variety_tier]
			VAR _PartVariety  = sets[part_variety_tier]
			VAR _ColorAge     = sets[color_age_tier]
			VAR _Quote        = UNICHAR(34)
			
			-- ============================================
			-- === COMPONENT-LEVEL DESCRIPTIONS ===========
			-- ============================================
			
			VAR _ComplexityText =
			    SWITCH(
			        _Complexity,
			        "Micro",  "a bite-sized build",
			        "Small",  "a compact build",
			        "Medium", "a mid-sized build",
			        "Large",  "a substantial build",
			        "Mega",   "a monumental build",
			        "a build of unknown scale"
			    )
			
			VAR _MinifigText =
			    SWITCH(
			        _Minifig,
			        "None",       "no minifigures",
			        "Solo",       "a single character",
			        "Small Crew", "a small cast",
			        "Squad",      "a full crew",
			        "Large Cast", "an ensemble cast",
			        "no cast info"
			    )
			
			VAR _ColorVarietyText =
			    SWITCH(
			        _ColorVariety,
			        "Minimal",  "a restrained palette",
			        "Basic",    "a modest palette",
			        "Balanced", "a well-rounded palette",
			        "Colorful", "a vivid palette",
			        "Rainbow",  "an expansive palette",
			        "an unclassified palette"
			    )
			
			VAR _PartVarietyText =
			    SWITCH(
			        _PartVariety,
			        "None",             "no distinct parts recorded",
			        "Simple Build",     "uses just a handful of unique parts",
			        "Mixed Build",      "combines a modest mix of unique parts",
			        "Varied Build",     "draws from a diverse range of unique parts",
			        "Complex Assembly", "assembles a highly varied set of unique parts",
			        "unknown part variety"
			    )
			
			VAR _ColorAgeText =
			    SWITCH(
			        _ColorAge,
			        "None",       "with no color-age data",
			        "Young Age",  "using the newest colors in LEGO's catalog",
			        "Modern Age", "leaning on modern-era colors",
			        "Mature Age", "featuring well-established colors",
			        "Old Age",    "drawing from classic, long-standing colors",
			        "with unspecified color age"
			    )
			
			-- ============================================
			-- === ARCHETYPE (character summary) ==========
			-- ============================================
			
			VAR _Archetype =
			    SWITCH(
			        TRUE(),
			        _Complexity IN { "Large", "Mega" } && _Minifig IN { "Squad", "Large Cast" },
			            "an epic display centerpiece",
			
			        _Complexity IN { "Large", "Mega" } && _Minifig IN { "None", "Solo" },
			            "a collector's showpiece",
			
			        _Complexity IN { "Small", "Medium" } && _Minifig IN { "Small Crew", "Squad" },
			            "a character-driven playset",
			
			        _Complexity = "Micro" && _Minifig = "None",
			            "a small accessory build",
			
			        _ColorAge = "Old Age" && _ColorVariety IN { "Minimal", "Basic" },
			            "a classic-era throwback",
			
			        _ColorAge IN { "Young Age", "Modern Age" } && _ColorVariety IN { "Colorful", "Rainbow" },
			            "a modern-era statement",
			
			        "a well-balanced set"
			    )
			
			-- ============================================
			-- === FINAL NARRATIVE (with set name) ========
			-- ============================================
			
			RETURN
			    _Quote & _SetName & _Quote & " is " & _Archetype & " — " & _ComplexityText &
			    " with " & _MinifigText & ", " &
			    _PartVarietyText & ", and " &
			    _ColorVarietyText & " " & _ColorAgeText & "."
		lineageTag: d8b9c3ae-1180-495c-b68b-acf9077204e3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

