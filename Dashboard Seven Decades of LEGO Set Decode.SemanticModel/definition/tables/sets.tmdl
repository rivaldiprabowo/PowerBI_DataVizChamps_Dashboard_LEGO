			    sets[number_of_parts] < 20, 3,
			    sets[number_of_parts] < 30, 4,
			    sets[number_of_parts] < 45, 5,
			    sets[number_of_parts] < 60, 6,
			    sets[number_of_parts] < 90, 7,
			    sets[number_of_parts] < 120, 8,
			    sets[number_of_parts] < 150, 9,
