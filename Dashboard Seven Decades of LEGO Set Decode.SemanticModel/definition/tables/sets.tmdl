		annotation SummarizationSetBy = Automatic

	column decade_rank =
			
			SWITCH(
			    TRUE(),
			    sets[decade] = "1950s" && sets[set_name] = "LEGO Town Plan Board, Plastic", 1,
			    sets[decade] = "1960s" && sets[set_name] = "Town Plan - Continental European",1,
			    sets[decade] = "1970s" && sets[set_name] = "Rocket Base",1,
			    sets[decade] = "1980s" && sets[set_name] = "Go-Cart" && sets[year_release] = 1985,1,
			    sets[decade] = "1990s" && sets[set_name] = "Imperial Trading Post",1,
			    sets[decade] = "2000s" && sets[set_name] = "Brutaka",1,
			    sets[decade] = "2010s" && sets[set_name] = "Battle for Ninjago City",1,
			    sets[decade] = "2020s" && sets[set_name] = "Titanic",1,
