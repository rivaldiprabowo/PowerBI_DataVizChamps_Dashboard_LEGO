	column event =
			
			SWITCH(
			    TRUE(),
			    sets[set_name] = "Individual 2 x 3 Bricks" && sets[year_release] = 1953, "Small Brick Set first released",
			    sets[set_name] = "Wheel Toy" && sets[year_release] = 1963, "Wheel Set first released",
			    sets[set_name] = "Town Plan" && sets[year_release] = 1969, "Town Plan set released",
			    sets[set_name] = "Auto Chassis" && sets[year_release] = 1977, "LEGO Technic first released",
			    sets[set_name] = "Galaxy Explorer" && sets[year_release] = 1979, "Galaxy Explorer released, consider one of the best LEGO set",
			    sets[set_name] = "King's Castle" && sets[year_release] = 1984, "More realistic theme with redesigned of Castle Set",
			    sets[set_name] = "Pirate Mini Figures" && sets[year_release] = 1989, "Pirates Set first released",
			    sets[set_name] = "Super Car" && sets[year_release] = 1994, "Super Car set released, consider as on the best set in 1990s",
			    sets[set_name] = "Tahu" && sets[year_release] = 2001, "First released of LEGO BIONICLE as one of the most influential themes",
			    sets[set_name] = "Mobile Crane" && sets[year_release] = 2005, "LEGO crisis recovery strategy and returned to profitability",
			    sets[set_name] = "Ninjago: Brickmaster" && sets[year_release] = 2005, "First released of LEGO NINJAGO as one the most successful original theme",
			    sets[set_name] = "Millennium Falcon" && sets[year_release] = 2017, "Millenium Falcon set released as the peak of LEGO's engineering",
			    sets[set_name] = "Pirates of Barracuda Bay" && sets[year_release] = 2020, "Pirates of Barracuda Bay set released as one of the best LEGO sets of 2020s",
			    BLANK()
			)
		lineageTag: 0fed052e-9d4f-4879-a54d-608174f9f011
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column image_line_chart =
			
			SWITCH(
			    TRUE(),
			    'sets'[event] == BLANK(),BLANK(),
			    sets[img_url]
			)
		lineageTag: 046e255f-c46e-49f9-9248-2dab9a2ee919
		dataCategory: ImageUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column total_sets_in_year =
			
