	column color_super_group =
			
			VAR c = [set_colors]
			RETURN
			    SWITCH(
			        TRUE(),
			        sets[set_colors] = BLANK(),BLANK(),
			        [transparent_colors] = TRUE(), "Transparent",
			
			        CONTAINSSTRING(c,"Chrome") || CONTAINSSTRING(c,"Pearl") || CONTAINSSTRING(c,"Metallic")
			            || CONTAINSSTRING(c,"Speckle") || CONTAINSSTRING(c,"Two-tone") || CONTAINSSTRING(c,"Flat")
			            || c = "Metal", "Metallic",
			
			        CONTAINSSTRING(c,"Black") || CONTAINSSTRING(c,"White") || CONTAINSSTRING(c,"Gray")
			            || CONTAINSSTRING(c,"Grey") || CONTAINSSTRING(c,"Titanium") || CONTAINSSTRING(c,"Unknown")
			            || CONTAINSSTRING(c,"No Color") || CONTAINSSTRING(c,"Clear") || CONTAINSSTRING(c,"Glow In Dark") || CONTAINSSTRING(c,"Other"),
			            "Neutral",
			
			        CONTAINSSTRING(c,"Brown") || CONTAINSSTRING(c,"Tan") || CONTAINSSTRING(c,"Nougat")
			            || CONTAINSSTRING(c,"Copper") || CONTAINSSTRING(c,"Rust") || CONTAINSSTRING(c,"Sienna")
			            || CONTAINSSTRING(c,"Umber") || CONTAINSSTRING(c,"Terracotta") || CONTAINSSTRING(c,"Buff"),
			            "Earth",
			
			        CONTAINSSTRING(c,"Blue") || CONTAINSSTRING(c,"Green") || CONTAINSSTRING(c,"Purple")
			            || CONTAINSSTRING(c,"Violet") || CONTAINSSTRING(c,"Lavender") || CONTAINSSTRING(c,"Lilac")
			            || CONTAINSSTRING(c,"Turquoise") || CONTAINSSTRING(c,"Aqua") || CONTAINSSTRING(c,"Azure")
			            || CONTAINSSTRING(c,"Cyan") || CONTAINSSTRING(c,"Teal") || CONTAINSSTRING(c,"Lime")
			            || CONTAINSSTRING(c,"Olive"),
			            "Cool",
			        "Primary"
			    )
		lineageTag: c5010c9e-8e75-46ad-8ab1-247697b4fa84
		summarizeBy: none

