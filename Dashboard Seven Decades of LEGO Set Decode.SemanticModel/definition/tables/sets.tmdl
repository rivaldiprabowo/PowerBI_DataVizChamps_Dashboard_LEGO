	column 'First Minifig Image' =
			
			VAR txt =
			    IF(
			        LEFT(sets[mini_figures_images], 2) = "||",
			        MID(sets[mini_figures_images], 3, LEN(sets[mini_figures_images])),
			        sets[mini_figures_images]
			    )
			
			RETURN
			PATHITEM(
			    SUBSTITUTE(txt, "||", "|"),
			    1,
			    TEXT
			)
		lineageTag: 164a5f5f-00db-437f-8f9c-d3542cb93e71
		dataCategory: ImageUrl
		summarizeBy: none

