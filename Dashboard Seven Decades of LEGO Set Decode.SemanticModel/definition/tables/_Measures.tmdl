	measure 'Closest Set Name Per Decade' =
			
			VAR _Target       = [Target Weighted Similarity]
			VAR _SelectedSet  = SELECTEDVALUE( sets[set_number] )
			VAR _CurrentDecade = SELECTEDVALUE( sets[decade] )
			
			-- Guard: if target isn't a single set or no decade in row context, return nothing
			RETURN
			    IF(
			        ISBLANK( _Target ) || ISBLANK( _CurrentDecade ),
			        BLANK(),
			
			        -- Step 1: Build a table of all candidate sets in the current decade,
			        -- excluding the selected set, with their absolute distance from target.
			        VAR _Candidates =
			            ADDCOLUMNS(
			                FILTER(
			                    ALL( sets ),
			                    sets[decade] = _CurrentDecade
			                        && sets[set_number] <> _SelectedSet
			                        && NOT ISBLANK( sets[Weighted Similarity] )
			                ),
			                "@distance", ABS( sets[Weighted Similarity] - _Target )
			            )
			
			        -- Step 2: Find the minimum distance
			        VAR _MinDistance = MINX( _Candidates, [@distance] )
			
			        -- Step 3: Return the set name at that minimum distance
			        VAR _ClosestSet =
			            MINX(
			                FILTER( _Candidates, [@distance] = _MinDistance ),
			                sets[set_name]
			            )
			
			        RETURN _ClosestSet
			    )
		lineageTag: 05203900-6b0d-4ba7-a482-275b6be87061

	measure 'Closest Set Match Pct' =
			
			VAR _Target       = [Target Weighted Similarity]
			VAR _SelectedSet  = SELECTEDVALUE( sets[set_number] )
			VAR _CurrentDecade = SELECTEDVALUE( sets[decade] )
			
			RETURN
			    IF(
			        ISBLANK( _Target ) || ISBLANK( _CurrentDecade ),
			        BLANK(),
			
			        VAR _Candidates =
			            ADDCOLUMNS(
			                FILTER(
			                    ALL( sets ),
			                    sets[decade] = _CurrentDecade
			                        && sets[set_number] <> _SelectedSet
			                        && NOT ISBLANK( sets[Weighted Similarity] )
			                ),
			                "@distance", ABS( sets[Weighted Similarity] - _Target )
			            )
			
			        VAR _MinDistance = MINX( _Candidates, [@distance] )
			
			        -- Match % = 1 - normalized distance
			        -- If similarity is 0-1 scale, distance of 0.5 → 50% match
			        -- Adjust the "0.5" cap below if your similarity scale is different
			        VAR _MatchPct = 1 - MIN( _MinDistance / 0.5, 1 )
			
			        RETURN _MatchPct
			    )
		lineageTag: 5cf1f3b5-d863-4dd2-a220-3183753bf848

		annotation PBI_FormatHint = {"isGeneralNumber":true}

