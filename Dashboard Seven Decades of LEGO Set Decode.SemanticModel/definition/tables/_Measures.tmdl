			        }
			    </style>
			</head>
			<body>
			    <div class='card-container'>
			        <div class='card-face card-front'></div>
			        <div class='card-face card-back'>
			            <div class='back-definition'>" & DefinitionText & "</div>
			        </div>
			    </div>
			</body>
			</html>"
		displayFolder: Page 1 History
		lineageTag: 28255097-04a2-4f74-8eeb-e5bce4154c5b

	measure 'HTML Minifig Histogram' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Bin config
			VAR _NumBins            = 15
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 300
			VAR _MarginLeft         = 57            -- room for y-axis labels
			VAR _MarginRight        = 15
			VAR _MarginTop          = 10
			VAR _MarginBottom       = 10            -- room for x-axis labels
			
			-- Bar styling
			VAR _BarGap             = 2
			VAR _CornerRadius       = 3
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 18
			VAR _YAxisFontSize      = 20
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 20
			VAR _LegendPaddingTop   = 20
			VAR _LegendPaddingLeft  = 0
			VAR _LegendItemSpacing  = 100
			VAR _LegendSwatchSize   = 15
			VAR _LegendHeight       = 25
			VAR _CharWidth        = _LegendFontSize * 0.55
			VAR _WidthNone        = 4  * _CharWidth   -- "None"
			VAR _WidthSolo        = 4  * _CharWidth   -- "Solo"
			VAR _WidthSmallCrew   = 10 * _CharWidth   -- "Small Crew"
			VAR _WidthSquad       = 5  * _CharWidth   -- "Squad"
			VAR _LegendGap        = 25
			VAR _TextSwatchGap    = 8
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _AnimDuration       = 0.0008
			VAR _AnimStagger        = 0.02
			
			-- Tier colors
			VAR _ColorNone          = "#9E9E9E"
			VAR _ColorSolo          = "#CFEFEA"
			VAR _ColorSmallCrew     = "#E8D1A8"
			VAR _ColorSquad         = "#B18FCF"
			VAR _ColorLargeCast     = "#F07F5A"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			VAR _SvgHeight  = _ChartHeight + _LegendPaddingTop + _LegendHeight
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _MinMinifigs = 1
			VAR _MaxMinifigs = CALCULATE( MAX( sets[total_minifigs] ), ALL( sets ), sets[total_minifigs] > 0 )
			VAR _LogMin = LOG10( _MinMinifigs )
			VAR _LogMax = LOG10( _MaxMinifigs )
			VAR _BinNumbers = GENERATESERIES( 0, _NumBins - 1, 1 )
			
			VAR _BinEdges =
			    ADDCOLUMNS(
			        _BinNumbers,
			        "lo",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( [Value] / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinMinifigs + ( [Value] / _NumBins ) * ( _MaxMinifigs - _MinMinifigs )
			            ),
			        "hi",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( ( [Value] + 1 ) / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinMinifigs + ( ( [Value] + 1 ) / _NumBins ) * ( _MaxMinifigs - _MinMinifigs )
			            )
			    )
			
			VAR _Tiers =
			    DATATABLE( "tier_name", STRING, "tier_color", STRING, "stack_order", INTEGER,
			        {
			            { "None",  "#F4F5F7", 1 },
			            { "Solo",  "#CFEFEA", 2 },
			            { "Small Crew", "#E8D1A8", 3 },
			            { "Squad",  "#B18FCF", 4 },
			            { "Large Cast",   "#F07F5A", 5 }
			        }
			    )
			
			VAR _BinTierCounts =
			    ADDCOLUMNS(
			        CROSSJOIN( _BinEdges, _Tiers ),
			        "seg_count",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            VAR T  = [tier_name]
			            RETURN
			                CALCULATE(
			                    COUNTROWS( sets ),
			                    sets[total_minifigs] >= Lo,
			                    sets[total_minifigs] < Hi,
			                    sets[minifig_tier] = T
			                )
			    )
			
			VAR _MaxBinTotal =
			    MAXX(
			        _BinEdges,
			        VAR Lo = [lo]
			        VAR Hi = [hi]
			        RETURN
			            CALCULATE(
			                COUNTROWS( sets ),
			                sets[total_minifigs] >= Lo,
			                sets[total_minifigs] < Hi
			            )
			    )
			
			VAR _BarSlot  = DIVIDE( _PlotWidth, _NumBins )
			VAR _BarWidth = _BarSlot - _BarGap
			
			-- ============================================
			-- === STACKED BARS ===========================
			-- ============================================
			
			VAR _Bars =
			    CONCATENATEX(
			        _BinEdges,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR Delay = BinIdx * _AnimStagger
			        VAR SegmentsForBin = FILTER( _BinTierCounts, [Value] = BinIdx )
			        RETURN
			            CONCATENATEX(
			                SegmentsForBin,
			                VAR SegHeight = DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                VAR CumBelow =
			                    SUMX(
			                        FILTER( SegmentsForBin, [stack_order] < EARLIER( [stack_order] ) ),
			                        DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                    )
			                VAR Y = _MarginTop + _PlotHeight - CumBelow - SegHeight
			                RETURN
			                    IF(
			                        [seg_count] > 0,
			                        "<rect x='" & X & "' y='" & Y & "' width='" & _BarWidth & "' height='" & SegHeight &
			                        "' fill='" & [tier_color] & "' " &
			                        "style='animation:barFade " & _AnimDuration & "s ease-out " & Delay & "s both'>" &
			                        "<title>" & [tier_name] & ": " & [seg_count] & " sets (" &
			                        FORMAT( ROUND( [lo], 0 ), "#,##0" ) & "-" & FORMAT( ROUND( [hi], 0 ), "#,##0" ) & " minifigs)</title></rect>",
			                        ""
			                    ),
			                "",
			                [stack_order], ASC
			            ),
			        "",
			        [Value], ASC
			    )
			
			-- ============================================
			-- === HOVER TRACKERS =========================
			-- ============================================
			
			VAR _BinTotals =
			    ADDCOLUMNS(
			        _BinEdges,
			        "@none",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi, sets[minifig_tier] = "None" ),
			        "@solo",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi, sets[minifig_tier] = "Solo" ),
			        "@smallcrew",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi, sets[minifig_tier] = "Small Crew" ),
			        "@squad",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi, sets[minifig_tier] = "Squad" ),
			        "@largecast",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi, sets[minifig_tier] = "Large Cast" ),
			        "@total",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[total_minifigs] >= Lo, sets[total_minifigs] < Hi )
			    )
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _BinTotals,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR TotalCount = IF( ISBLANK( [@total] ), 0, [@total] )
			        VAR NoneCount = IF( ISBLANK( [@none] ), 0, [@none] )
			        VAR SoloCount = IF( ISBLANK( [@solo] ), 0, [@solo] )
			        VAR SmallCrewCount = IF( ISBLANK( [@smallcrew] ), 0, [@smallcrew] )
			        VAR SquadCount = IF( ISBLANK( [@squad] ), 0, [@squad] )
			        VAR LargeCastCount = IF( ISBLANK( [@largecast] ), 0, [@largecast] )
			        VAR DataAttrs =
			            " data-range='" & FORMAT( ROUND( [lo], 0 ), "#,0" ) & " - " & FORMAT( ROUND( [hi], 0 ), "#,0" ) & " minifigs'" &
			            " data-none='" & FORMAT( NoneCount, "#,0" ) & "'" &
			            " data-solo='" & FORMAT( SoloCount, "#,0" ) & "'" &
			            " data-smallcrew='" & FORMAT( SmallCrewCount, "#,0" ) & "'" &
			            " data-squad='" & FORMAT( SquadCount, "#,0" ) & "'" &
			            " data-largecast='" & FORMAT( LargeCastCount, "#,0" ) & "'" &
			            " data-total='" & FORMAT( TotalCount, "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band' x='" & X & "' y='" & _MarginTop & "' width='" & _BarSlot & "' height='" & _PlotHeight & "' fill='transparent'" & DataAttrs & " />",
			        "",
			        [Value], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS ==================================
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR T = [Value]
			        VAR CountVal = _MaxBinTotal * T / 4
			        VAR YPos = _MarginTop + _PlotHeight - ( T / 4 ) * _PlotHeight
			        VAR Label = FORMAT( CountVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS ==================================
			-- ============================================
			
			VAR _MinPowerOf10 = CEILING( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS(
			        GENERATESERIES( 0, _PowerCount - 1, 1 ),
			        "@power", _MinPowerOf10 + [Value],
			        "@minifigsVal", POWER( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _PowerTicks,
			        VAR MinifigsVal = [@minifigsVal]
			        VAR LogPos = LOG10( MinifigsVal )
			        VAR NormPos = DIVIDE( LogPos - _LogMin, _LogMax - _LogMin )
			        VAR XPos = _MarginLeft + NormPos * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT( MinifigsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & YBottom &
			            "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === LEGEND ==================================
			-- ============================================
			
			VAR _LegendY = _ChartHeight + _LegendPaddingTop
			VAR _LegendStartX = _MarginLeft + _LegendPaddingLeft
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthNone      + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthSolo      + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthSmallCrew + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthSquad     + _LegendGap
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-size='" & _LegendFontSize & "' font-family='" & _FontFamily & "'>" &
			    "<rect x='" & _Pos1 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorNone & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>None</text>" &
			    "<rect x='" & _Pos2 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSolo & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Solo</text>" &
			    "<rect x='" & _Pos3 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSmallCrew & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Small Crew</text>" &
			    "<rect x='" & _Pos4 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSquad & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Squad</text>" &
			    "<rect x='" & _Pos5 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorLargeCast & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Large Cast</text>" &
			    "</g>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes barFade{from{opacity:0;transform:scaleY(0);transform-origin:bottom}to{opacity:1;transform:scaleY(1)}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band { cursor:crosshair; }
			#custom-tooltip {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip .tt-range { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip .tt-label { display:flex; align-items:center; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line');
			    var bands = document.querySelectorAll('.hover-band');
			    var colors = {
			        none:      '" & _ColorNone      & "',
			        solo:      '" & _ColorSolo      & "',
			        smallcrew: '" & _ColorSmallCrew & "',
			        squad:     '" & _ColorSquad     & "',
			        largecast: '" & _ColorLargeCast & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-range" & UNICHAR(34) & ">' + d.range + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.largecast + '" & UNICHAR(34) & "></span>Large Cast</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.largecast + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.squad + '" & UNICHAR(34) & "></span>Squad</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.squad + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.smallcrew + '" & UNICHAR(34) & "></span>Small Crew</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.smallcrew + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.solo + '" & UNICHAR(34) & "></span>Solo</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.solo + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.none + '" & UNICHAR(34) & "></span>None</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.none + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container'>" &
			"<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight & "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			_YAxisElements &
			_XAxisBaseline &
			"<g>" & _Bars & "</g>" &
			_XAxisElements &
			_HoverIndicator &
			_HoverTrackers &
			_Legend &
			"</svg>" &
			_TooltipHTML &
			"</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: bc630275-d24f-4190-b022-e100aa3b0093

	measure 'HTML Minifig Stacked Area' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _ChartWidth         = 900
			VAR _ChartHeight        = 438
			VAR _MarginTop          = 15
			VAR _MarginRight        = 17
			VAR _MarginBottom       = 45
			VAR _MarginLeft         = 45
			
			-- Typography
			VAR _FontFamily         = "Segoe UI, sans-serif"
			VAR _XAxisFontSize      = 13
			VAR _YAxisFontSize      = 13
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 16
			VAR _LegendTextColor    = "#666666"
			VAR _LegendSwatchSize   = 13
			VAR _LegendGap          = 30
			VAR _TextSwatchGap      = 8
			VAR _LegendOffsetY      = 20
			VAR _LegendStartOffsetX = 0
			
			-- Area styling
			VAR _AreaOpacity        = 0.40
			VAR _LineWidth          = 4
			VAR _DotRadius          = 2
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 1
			
			-- X-axis tick control
			VAR _MaxXTicks          = 20
			VAR _DecadeTickThreshold = 30
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 20
			VAR _TooltipTextColor   = "#333333"
			
			-- Minifig tier colors (stack order: None -> Solo -> Small Crew -> Squad -> Large Cast)
			VAR _ColorNone          = "#9E9E9E"
			VAR _ColorSolo          = "#CFEFEA"
			VAR _ColorSmallCrew     = "#E8D1A8"
			VAR _ColorSquad         = "#B18FCF"
			VAR _ColorLargeCast     = "#F07F5A"
			
			-- Animation
			VAR _AnimationDuration  = 800
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Years =
			    ADDCOLUMNS(
			        SUMMARIZE( dim_year, dim_year[year] ),
			        "@yearNum", dim_year[year]
			    )
			VAR _MinYear = MINX( _Years, [@yearNum] )
			VAR _MaxYear = MAXX( _Years, [@yearNum] )
			VAR _YearSpan = _MaxYear - _MinYear
			
			-- Sum of total_minifigs per tier per year (not a distinct/set count)
			VAR _RawData =
			    ADDCOLUMNS(
			        _Years,
			        "@none",      CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[minifig_tier] = "None" ),
			        "@solo",      CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[minifig_tier] = "Solo" ),
			        "@smallCrew", CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[minifig_tier] = "Small Crew" ),
			        "@squad",     CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[minifig_tier] = "Squad" ),
			        "@largeCast", CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[minifig_tier] = "Large Cast" )
			    )
			
			VAR _CumulativeData =
			    ADDCOLUMNS(
			        _RawData,
			        "@noneVal",      IF( ISBLANK( [@none] ), 0, [@none] ),
			        "@soloVal",      IF( ISBLANK( [@solo] ), 0, [@solo] ),
			        "@smallCrewVal", IF( ISBLANK( [@smallCrew] ), 0, [@smallCrew] ),
			        "@squadVal",     IF( ISBLANK( [@squad] ), 0, [@squad] ),
			        "@largeCastVal", IF( ISBLANK( [@largeCast] ), 0, [@largeCast] ),
			        "@y1", IF( ISBLANK( [@none] ), 0, [@none] ),
			        "@y2", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@solo] ), 0, [@solo] ),
			        "@y3", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@solo] ), 0, [@solo] ) + IF( ISBLANK( [@smallCrew] ), 0, [@smallCrew] ),
			        "@y4", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@solo] ), 0, [@solo] ) + IF( ISBLANK( [@smallCrew] ), 0, [@smallCrew] ) + IF( ISBLANK( [@squad] ), 0, [@squad] ),
			        "@y5", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@solo] ), 0, [@solo] ) + IF( ISBLANK( [@smallCrew] ), 0, [@smallCrew] ) + IF( ISBLANK( [@squad] ), 0, [@squad] ) + IF( ISBLANK( [@largeCast] ), 0, [@largeCast] )
			    )
			
			VAR _MaxTotal = MAXX( _CumulativeData, [@y5] )
			VAR _PlotWidth  = _ChartWidth  - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop  - _MarginBottom
			
			-- ============================================
			-- === SVG PATH GENERATION ====================
			-- ============================================
			
			VAR _NoneTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _NoneBottomY = _MarginTop + _PlotHeight
			VAR _NoneFillPath =
			    "M " & _MarginLeft & "," & _NoneBottomY & " " &
			    "L " & _NoneTop & " " &
			    "L " & ( _MarginLeft + _PlotWidth ) & "," & _NoneBottomY & " Z"
			
			VAR _SoloTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _SoloBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _SoloFillPath = "M " & _SoloTop & " L " & _SoloBottom & " Z"
			
			VAR _SmallCrewTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _SmallCrewBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _SmallCrewFillPath = "M " & _SmallCrewTop & " L " & _SmallCrewBottom & " Z"
			
			VAR _SquadTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _SquadBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _SquadFillPath = "M " & _SquadTop & " L " & _SquadBottom & " Z"
			
			VAR _LargeCastTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _LargeCastBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _LargeCastFillPath = "M " & _LargeCastTop & " L " & _LargeCastBottom & " Z"
			
			VAR _NoneLine      = "M " & _NoneTop
			VAR _SoloLine      = "M " & _SoloTop
			VAR _SmallCrewLine = "M " & _SmallCrewTop
			VAR _SquadLine     = "M " & _SquadTop
			VAR _LargeCastLine = "M " & _LargeCastTop
			
			-- ============================================
			-- === DATA DOTS ==============================
			-- ============================================
			
			VAR _NoneDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorNone & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _SoloDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorSolo & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _SmallCrewDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorSmallCrew & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _SquadDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorSquad & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _LargeCastDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorLargeCast & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === HOVER TRACKER ==========================
			-- ============================================
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _BandWidth = IF( _YearSpan = 0, _PlotWidth, _PlotWidth / _YearSpan )
			        VAR _BandX = _X - _BandWidth / 2
			        VAR _DataAttrs =
			            " data-year='" & [@yearNum] & "'" &
			            " data-none='" & FORMAT( [@noneVal], "#,0" ) & "'" &
			            " data-solo='" & FORMAT( [@soloVal], "#,0" ) & "'" &
			            " data-smallcrew='" & FORMAT( [@smallCrewVal], "#,0" ) & "'" &
			            " data-squad='" & FORMAT( [@squadVal], "#,0" ) & "'" &
			            " data-largecast='" & FORMAT( [@largeCastVal], "#,0" ) & "'" &
			            " data-total='" & FORMAT( [@y5], "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band' x='" & _BandX & "' y='" & _MarginTop & "' width='" & _BandWidth & "' height='" & _PlotHeight & "' fill='transparent'" & _DataAttrs & " />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS =================================
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR _T = [Value]
			        VAR _YVal = _MaxTotal * _T / 4
			        VAR _YPos = _MarginTop + _PlotHeight - ( _T / 4 ) * _PlotHeight
			        VAR _Label = FORMAT( _YVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & _YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & _YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( _YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & _Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (smart ticks) ===================
			-- ============================================
			
			VAR _UseDecadeTicks = _YearSpan > _DecadeTickThreshold
			
			VAR _MinDecade = CEILING( _MinYear / 10, 1 ) * 10
			VAR _MaxDecade = FLOOR( _MaxYear / 10, 1 ) * 10
			VAR _DecadeCount = ( _MaxDecade - _MinDecade ) / 10 + 1
			
			VAR _DecadeTickYears =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            GENERATESERIES( 0, _DecadeCount - 1, 1 ),
			            "@yearCalc", _MinDecade + [Value] * 10
			        ),
			        "@yearNum", [@yearCalc]
			    )
			
			VAR _YearCount = COUNTROWS( _CumulativeData )
			VAR _TickStep = MAX( 1, CEILING( DIVIDE( _YearCount, _MaxXTicks ), 1 ) )
			
			VAR _CumulativeIndexed =
			    ADDCOLUMNS(
			        _CumulativeData,
			        "@idx", RANKX( _CumulativeData, [@yearNum], , ASC, DENSE )
			    )
			
			VAR _AdaptiveTickYears =
			    SELECTCOLUMNS(
			        FILTER(
			            _CumulativeIndexed,
			            MOD( [@idx] - 1, _TickStep ) = 0 || [@yearNum] = _MaxYear
			        ),
			        "@yearNum", [@yearNum]
			    )
			
			VAR _XTickYears =
			    UNION(
			        FILTER( _DecadeTickYears, _UseDecadeTicks ),
			        FILTER( _AdaptiveTickYears, NOT _UseDecadeTicks )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _XTickYears,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _YBottom = _MarginTop + _PlotHeight
			        RETURN
			            "<line x1='" & _X & "' y1='" & _YBottom &
			            "' x2='" & _X & "' y2='" & ( _YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & _X & "' y='" & ( _YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & [@yearNum] & "</text>",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === LEGEND (evenly-spaced) =================
			-- ============================================
			
			VAR _CharWidth      = _LegendFontSize * 0.55
			VAR _WidthNone      = 4  * _CharWidth
			VAR _WidthSolo      = 4  * _CharWidth
			VAR _WidthSmallCrew = 10 * _CharWidth
			VAR _WidthSquad     = 5  * _CharWidth
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthNone      + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthSolo      + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthSmallCrew + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthSquad     + _LegendGap
			
			VAR _LegendY = _MarginTop + _PlotHeight + _LegendOffsetY + 20
			VAR _LegendStartX = _MarginLeft + _LegendStartOffsetX
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-family='" & _FontFamily & "' font-size='" & _LegendFontSize & "' fill='" & _LegendTextColor & "'>" &
			    "<rect x='" & _Pos1 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorNone & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>None</text>" &
			    "<rect x='" & _Pos2 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSolo & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Solo</text>" &
			    "<rect x='" & _Pos3 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSmallCrew & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Small Crew</text>" &
			    "<rect x='" & _Pos4 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSquad & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Squad</text>" &
			    "<rect x='" & _Pos5 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorLargeCast & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Large Cast</text>" &
			    "</g>"
			
			VAR _Baseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === UNIQUE IDs (avoid collisions) ==========
			-- ============================================
			
			VAR _UID = "minifigs" & RANDBETWEEN( 10000000, 99999999 )
			
			-- ============================================
			-- === REVEAL ANIMATION =======================
			-- ============================================
			
			VAR _RevealAnimation =
			"<clipPath id='reveal-clip-" & _UID & "'>
			    <rect x='" & _MarginLeft & "' y='0' width='0' height='" & _ChartHeight & "'>
			        <animate attributeName='width'
			                 from='0'
			                 to='" & _PlotWidth & "'
			                 dur='" & ( _AnimationDuration / 1000 ) & "s'
			                 fill='freeze'
			                 begin='0s' />
			    </rect>
			</clipPath>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			.chart-container-" & _UID & " { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band-" & _UID & " { cursor:crosshair; }
			#custom-tooltip-" & _UID & " {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip-" & _UID & " .tt-year { font-weight:700; margin-bottom:6px; font-size:20px; }
			#custom-tooltip-" & _UID & " .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip-" & _UID & " .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip-" & _UID & " .tt-label { display:flex; align-items:center; }
			#custom-tooltip-" & _UID & " .tt-value { font-weight:600; }
			#custom-tooltip-" & _UID & " .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML =
			"<div id='custom-tooltip-" & _UID & "'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip-" & _UID & "');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line-" & _UID & "');
			    var bands = document.querySelectorAll('.hover-band-" & _UID & "');
			    var colors = {
			        none:      '" & _ColorNone      & "',
			        solo:      '" & _ColorSolo      & "',
			        smallcrew: '" & _ColorSmallCrew & "',
			        squad:     '" & _ColorSquad     & "',
			        largecast: '" & _ColorLargeCast & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-year" & UNICHAR(34) & ">' + d.year + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.largecast + '" & UNICHAR(34) & "></span>Large Cast</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.largecast + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.squad + '" & UNICHAR(34) & "></span>Squad</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.squad + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.smallcrew + '" & UNICHAR(34) & "></span>Small Crew</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.smallcrew + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.solo + '" & UNICHAR(34) & "></span>Solo</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.solo + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.none + '" & UNICHAR(34) & "></span>None</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.none + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === HOVER TRACKERS (with unique class) =====
			-- ============================================
			
			VAR _HoverTrackersFinal =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _BandWidth = IF( _YearSpan = 0, _PlotWidth, _PlotWidth / _YearSpan )
			        VAR _BandX = _X - _BandWidth / 2
			        VAR _DataAttrs =
			            " data-year='" & [@yearNum] & "'" &
			            " data-none='" & FORMAT( [@noneVal], "#,0" ) & "'" &
			            " data-solo='" & FORMAT( [@soloVal], "#,0" ) & "'" &
			            " data-smallcrew='" & FORMAT( [@smallCrewVal], "#,0" ) & "'" &
			            " data-squad='" & FORMAT( [@squadVal], "#,0" ) & "'" &
			            " data-largecast='" & FORMAT( [@largeCastVal], "#,0" ) & "'" &
			            " data-total='" & FORMAT( [@y5], "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band-" & _UID & "' x='" & _BandX & "' y='" & _MarginTop & "' width='" & _BandWidth & "' height='" & _PlotHeight & "' fill='transparent'" & _DataAttrs & " />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _HoverIndicatorFinal =
			    "<line id='hover-line-" & _UID & "' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container-" & _UID & "'>
			    <svg xmlns='http://www.w3.org/2000/svg'
			         viewBox='0 0 " & _ChartWidth & " " & _ChartHeight & "'
			         preserveAspectRatio='xMidYMid meet'
			         style='width:100%;height:100%;'>
			        <defs>" & _RevealAnimation & "</defs>
			
			        " & _YAxisElements & "
			        " & _Baseline & "
			        " & _XAxisElements & "
			
			        <g clip-path='url(#reveal-clip-" & _UID & ")'>
			            <path d='" & _NoneFillPath      & "' fill='" & _ColorNone      & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _SoloFillPath      & "' fill='" & _ColorSolo      & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _SmallCrewFillPath & "' fill='" & _ColorSmallCrew & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _SquadFillPath     & "' fill='" & _ColorSquad     & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _LargeCastFillPath & "' fill='" & _ColorLargeCast & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			
			            <path d='" & _NoneLine      & "' fill='none' stroke='" & _ColorNone      & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _SoloLine      & "' fill='none' stroke='" & _ColorSolo      & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _SmallCrewLine & "' fill='none' stroke='" & _ColorSmallCrew & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _SquadLine     & "' fill='none' stroke='" & _ColorSquad     & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _LargeCastLine & "' fill='none' stroke='" & _ColorLargeCast & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			
			            " & _NoneDots      & "
			            " & _SoloDots      & "
			            " & _SmallCrewDots & "
			            " & _SquadDots     & "
			            " & _LargeCastDots & "
			        </g>
			
			        " & _HoverIndicatorFinal & "
			        " & _HoverTrackersFinal & "
			        " & _Legend & "
			    </svg>
			" & _TooltipHTML & "
			</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: a8a8d63a-d0b7-4453-b464-ac190b0ba02e

	measure 'HTML Parts Variety Stacked Area' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _ChartWidth         = 900
			VAR _ChartHeight        = 435
			VAR _MarginTop          = 15
			VAR _MarginRight        = 17
			VAR _MarginBottom       = 45
			VAR _MarginLeft         = 50
			
			-- Typography
			VAR _FontFamily         = "Segoe UI, sans-serif"
			VAR _XAxisFontSize      = 13
			VAR _YAxisFontSize      = 13
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 16
			VAR _LegendTextColor    = "#666666"
			VAR _LegendSwatchSize   = 13
			VAR _LegendGap          = 30
			VAR _TextSwatchGap      = 8
			VAR _LegendOffsetY      = 20
			VAR _LegendStartOffsetX = 0
			
			-- Area styling
			VAR _AreaOpacity        = 0.70
			VAR _LineWidth          = 4
			VAR _DotRadius          = 2
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 1
			
			-- X-axis tick control
			VAR _MaxXTicks          = 20
			VAR _DecadeTickThreshold = 30
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 20
			VAR _TooltipTextColor   = "#333333"
			
			-- Tier colors (same positional order as before)
			VAR _ColorNone              = "#2ECC71"
			VAR _ColorSimpleBuild       = "#2a78d6"
			VAR _ColorMixedBuild        = "#F4B400"
			VAR _ColorVariedBuild       = "#ab6643"
			VAR _ColorComplexAssembly   = "#E53935"
			
			-- Animation
			VAR _AnimationDuration  = 800
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Years =
			    ADDCOLUMNS(
			        SUMMARIZE( dim_year, dim_year[year] ),
			        "@yearNum", dim_year[year]
			    )
			VAR _MinYear = MINX( _Years, [@yearNum] )
			VAR _MaxYear = MAXX( _Years, [@yearNum] )
			VAR _YearSpan = _MaxYear - _MinYear
			
			VAR _RawData =
			    ADDCOLUMNS(
			        _Years,
			        "@none",     CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[part_variety_tier] = "None" ),
			        "@simple",   CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[part_variety_tier] = "Simple Build" ),
			        "@mixed",    CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[part_variety_tier] = "Mixed Build" ),
			        "@varied",   CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[part_variety_tier] = "Varied Build" ),
			        "@complex",  CALCULATE( DISTINCTCOUNT( sets[set_number] ), sets[part_variety_tier] = "Complex Assembly" )
			    )
			
			VAR _CumulativeData =
			    ADDCOLUMNS(
			        _RawData,
			        "@noneVal",     IF( ISBLANK( [@none] ), 0, [@none] ),
			        "@simpleVal",   IF( ISBLANK( [@simple] ), 0, [@simple] ),
			        "@mixedVal",    IF( ISBLANK( [@mixed] ), 0, [@mixed] ),
			        "@variedVal",   IF( ISBLANK( [@varied] ), 0, [@varied] ),
			        "@complexVal",  IF( ISBLANK( [@complex] ), 0, [@complex] ),
			        "@y1", IF( ISBLANK( [@none] ), 0, [@none] ),
			        "@y2", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@simple] ), 0, [@simple] ),
			        "@y3", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@simple] ), 0, [@simple] ) + IF( ISBLANK( [@mixed] ), 0, [@mixed] ),
			        "@y4", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@simple] ), 0, [@simple] ) + IF( ISBLANK( [@mixed] ), 0, [@mixed] ) + IF( ISBLANK( [@varied] ), 0, [@varied] ),
			        "@y5", IF( ISBLANK( [@none] ), 0, [@none] ) + IF( ISBLANK( [@simple] ), 0, [@simple] ) + IF( ISBLANK( [@mixed] ), 0, [@mixed] ) + IF( ISBLANK( [@varied] ), 0, [@varied] ) + IF( ISBLANK( [@complex] ), 0, [@complex] )
			    )
			
			VAR _MaxTotal = MAXX( _CumulativeData, [@y5] )
			VAR _PlotWidth  = _ChartWidth  - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop  - _MarginBottom
			
			-- ============================================
			-- === SVG PATH GENERATION ====================
			-- ============================================
			
			VAR _NoneTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _NoneBottomY = _MarginTop + _PlotHeight
			VAR _NoneFillPath = "M " & _MarginLeft & "," & _NoneBottomY & " L " & _NoneTop & " L " & ( _MarginLeft + _PlotWidth ) & "," & _NoneBottomY & " Z"
			
			VAR _SimpleTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _SimpleBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _SimpleFillPath = "M " & _SimpleTop & " L " & _SimpleBottom & " Z"
			
			VAR _MixedTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _MixedBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _MixedFillPath = "M " & _MixedTop & " L " & _MixedBottom & " Z"
			
			VAR _VariedTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _VariedBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _VariedFillPath = "M " & _VariedTop & " L " & _VariedBottom & " Z"
			
			VAR _ComplexTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _ComplexBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _ComplexFillPath = "M " & _ComplexTop & " L " & _ComplexBottom & " Z"
			
			VAR _NoneLine    = "M " & _NoneTop
			VAR _SimpleLine  = "M " & _SimpleTop
			VAR _MixedLine   = "M " & _MixedTop
			VAR _VariedLine  = "M " & _VariedTop
			VAR _ComplexLine = "M " & _ComplexTop
			
			-- ============================================
			-- === DATA DOTS ==============================
			-- ============================================
			
			VAR _NoneDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorNone & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _SimpleDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorSimpleBuild & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _MixedDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorMixedBuild & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _VariedDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorVariedBuild & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _ComplexDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorComplexAssembly & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			-- ============================================
			-- === UNIQUE IDs =============================
			-- ============================================
			
			VAR _UID = "partvar" & RANDBETWEEN( 10000000, 99999999 )
			
			-- ============================================
			-- === HOVER TRACKERS =========================
			-- ============================================
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _BandWidth = IF( _YearSpan = 0, _PlotWidth, _PlotWidth / _YearSpan )
			        VAR _BandX = _X - _BandWidth / 2
			        VAR _DataAttrs =
			            " data-year='" & [@yearNum] & "'" &
			            " data-none='" & FORMAT( [@noneVal], "#,0" ) & "'" &
			            " data-simple='" & FORMAT( [@simpleVal], "#,0" ) & "'" &
			            " data-mixed='" & FORMAT( [@mixedVal], "#,0" ) & "'" &
			            " data-varied='" & FORMAT( [@variedVal], "#,0" ) & "'" &
			            " data-complex='" & FORMAT( [@complexVal], "#,0" ) & "'" &
			            " data-total='" & FORMAT( [@y5], "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band-" & _UID & "' x='" & _BandX & "' y='" & _MarginTop & "' width='" & _BandWidth & "' height='" & _PlotHeight & "' fill='transparent'" & _DataAttrs & " />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line-" & _UID & "' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS =================================
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR _T = [Value]
			        VAR _YVal = _MaxTotal * _T / 4
			        VAR _YPos = _MarginTop + _PlotHeight - ( _T / 4 ) * _PlotHeight
			        VAR _Label = FORMAT( _YVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & _YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & _YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( _YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & _Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (smart ticks) ===================
			-- ============================================
			
			VAR _UseDecadeTicks = _YearSpan > _DecadeTickThreshold
			
			VAR _MinDecade = CEILING( _MinYear / 10, 1 ) * 10
			VAR _MaxDecade = FLOOR( _MaxYear / 10, 1 ) * 10
			VAR _DecadeCount = ( _MaxDecade - _MinDecade ) / 10 + 1
			
			VAR _DecadeTickYears =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            GENERATESERIES( 0, _DecadeCount - 1, 1 ),
			            "@yearCalc", _MinDecade + [Value] * 10
			        ),
			        "@yearNum", [@yearCalc]
			    )
			
			VAR _YearCount = COUNTROWS( _CumulativeData )
			VAR _TickStep = MAX( 1, CEILING( DIVIDE( _YearCount, _MaxXTicks ), 1 ) )
			
			VAR _CumulativeIndexed =
			    ADDCOLUMNS(
			        _CumulativeData,
			        "@idx", RANKX( _CumulativeData, [@yearNum], , ASC, DENSE )
			    )
			
			VAR _AdaptiveTickYears =
			    SELECTCOLUMNS(
			        FILTER(
			            _CumulativeIndexed,
			            MOD( [@idx] - 1, _TickStep ) = 0 || [@yearNum] = _MaxYear
			        ),
			        "@yearNum", [@yearNum]
			    )
			
			VAR _XTickYears =
			    UNION(
			        FILTER( _DecadeTickYears, _UseDecadeTicks ),
			        FILTER( _AdaptiveTickYears, NOT _UseDecadeTicks )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _XTickYears,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _YBottom = _MarginTop + _PlotHeight
			        RETURN
			            "<line x1='" & _X & "' y1='" & _YBottom &
			            "' x2='" & _X & "' y2='" & ( _YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & _X & "' y='" & ( _YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & [@yearNum] & "</text>",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === LEGEND (evenly-spaced) =================
			-- ============================================
			
			VAR _CharWidth          = _LegendFontSize * 0.55
			VAR _WidthNone          = 4  * _CharWidth
			VAR _WidthSimple        = 12 * _CharWidth
			VAR _WidthMixed         = 11 * _CharWidth
			VAR _WidthVaried        = 12 * _CharWidth
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthNone   + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthSimple + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthMixed  + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthVaried + _LegendGap
			
			VAR _LegendY = _MarginTop + _PlotHeight + _LegendOffsetY + 20
			VAR _LegendStartX = _MarginLeft + _LegendStartOffsetX
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-family='" & _FontFamily & "' font-size='" & _LegendFontSize & "' fill='" & _LegendTextColor & "'>" &
			    "<rect x='" & _Pos1 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorNone & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>None</text>" &
			    "<rect x='" & _Pos2 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSimpleBuild & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Simple Build</text>" &
			    "<rect x='" & _Pos3 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMixedBuild & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Mixed Build</text>" &
			    "<rect x='" & _Pos4 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorVariedBuild & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Varied Build</text>" &
			    "<rect x='" & _Pos5 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorComplexAssembly & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Complex Assembly</text>" &
			    "</g>"
			
			VAR _Baseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === REVEAL ANIMATION =======================
			-- ============================================
			
			VAR _RevealAnimation =
			"<clipPath id='reveal-clip-" & _UID & "'>
			    <rect x='" & _MarginLeft & "' y='0' width='0' height='" & _ChartHeight & "'>
			        <animate attributeName='width'
			                 from='0'
			                 to='" & _PlotWidth & "'
			                 dur='" & ( _AnimationDuration / 1000 ) & "s'
			                 fill='freeze'
			                 begin='0s' />
			    </rect>
			</clipPath>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			.chart-container-" & _UID & " { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band-" & _UID & " { cursor:crosshair; }
			#custom-tooltip-" & _UID & " {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip-" & _UID & " .tt-year { font-weight:700; margin-bottom:6px; font-size:20px; }
			#custom-tooltip-" & _UID & " .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip-" & _UID & " .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip-" & _UID & " .tt-label { display:flex; align-items:center; }
			#custom-tooltip-" & _UID & " .tt-value { font-weight:600; }
			#custom-tooltip-" & _UID & " .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML =
			"<div id='custom-tooltip-" & _UID & "'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip-" & _UID & "');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line-" & _UID & "');
			    var bands = document.querySelectorAll('.hover-band-" & _UID & "');
			    var colors = {
			        none:    '" & _ColorNone            & "',
			        simple:  '" & _ColorSimpleBuild     & "',
			        mixed:   '" & _ColorMixedBuild      & "',
			        varied:  '" & _ColorVariedBuild     & "',
			        complex: '" & _ColorComplexAssembly & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-year" & UNICHAR(34) & ">' + d.year + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.complex + '" & UNICHAR(34) & "></span>Complex Assembly</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.complex + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.varied + '" & UNICHAR(34) & "></span>Varied Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.varied + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.mixed + '" & UNICHAR(34) & "></span>Mixed Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.mixed + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.simple + '" & UNICHAR(34) & "></span>Simple Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.simple + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.none + '" & UNICHAR(34) & "></span>None</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.none + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container-" & _UID & "'>
			    <svg xmlns='http://www.w3.org/2000/svg'
			         viewBox='0 0 " & _ChartWidth & " " & _ChartHeight & "'
			         preserveAspectRatio='xMidYMid meet'
			         style='width:100%;height:100%;'>
			        <defs>" & _RevealAnimation & "</defs>
			
			        " & _YAxisElements & "
			        " & _Baseline & "
			        " & _XAxisElements & "
			
			        <g clip-path='url(#reveal-clip-" & _UID & ")'>
			            <path d='" & _NoneFillPath    & "' fill='" & _ColorNone            & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _SimpleFillPath  & "' fill='" & _ColorSimpleBuild     & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _MixedFillPath   & "' fill='" & _ColorMixedBuild      & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _VariedFillPath  & "' fill='" & _ColorVariedBuild     & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _ComplexFillPath & "' fill='" & _ColorComplexAssembly & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			
			            <path d='" & _NoneLine    & "' fill='none' stroke='" & _ColorNone            & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _SimpleLine  & "' fill='none' stroke='" & _ColorSimpleBuild     & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _MixedLine   & "' fill='none' stroke='" & _ColorMixedBuild      & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _VariedLine  & "' fill='none' stroke='" & _ColorVariedBuild     & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _ComplexLine & "' fill='none' stroke='" & _ColorComplexAssembly & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			
			            " & _NoneDots    & "
			            " & _SimpleDots  & "
			            " & _MixedDots   & "
			            " & _VariedDots  & "
			            " & _ComplexDots & "
			        </g>
			
			        " & _HoverIndicator & "
			        " & _HoverTrackers & "
			        " & _Legend & "
			    </svg>
			" & _TooltipHTML & "
			</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 57fdbc48-957a-4745-b6c2-2464fbfb4c1e

	measure 'HTML Stacked Area Color Variety' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _ChartWidth         = 900
			VAR _ChartHeight        = 462
			VAR _MarginTop          = 20
			VAR _MarginRight        = 20
			VAR _MarginBottom       = 60
			VAR _MarginLeft         = 60
			
			-- Typography
			VAR _FontFamily         = "Segoe UI, sans-serif"
			VAR _XAxisFontSize      = 18
			VAR _YAxisFontSize      = 20
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 20
			VAR _LegendTextColor    = "#333333"
			VAR _LegendSwatchSize   = 17
			VAR _LegendGap          = 30
			VAR _TextSwatchGap      = 8
			VAR _LegendOffsetY      = 30
			VAR _LegendStartOffsetX = 0
			
			-- Area styling
			VAR _AreaOpacity        = 0.40
			VAR _LineWidth          = 6
			VAR _DotRadius          = 4
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 1.5
			
			-- X-axis tick control
			VAR _MaxXTicks          = 20
			VAR _DecadeTickThreshold = 30
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 20
			VAR _TooltipTextColor   = "#333333"
			
			-- Tier colors (same positional order)
			VAR _ColorMinimal       = "#F4F5F7"
			VAR _ColorBasic         = "#CFEFEA"
			VAR _ColorBalanced      = "#E8D1A8"
			VAR _ColorColorful      = "#B18FCF"
			VAR _ColorRainbow       = "#DEC69C"
			
			-- Animation
			VAR _AnimationDuration  = 800
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Years =
			    ADDCOLUMNS(
			        SUMMARIZE( dim_year, dim_year[year] ),
			        "@yearNum", dim_year[year]
			    )
			VAR _MinYear = MINX( _Years, [@yearNum] )
			VAR _MaxYear = MAXX( _Years, [@yearNum] )
			VAR _YearSpan = _MaxYear - _MinYear
			
			VAR _RawData =
			    ADDCOLUMNS(
			        _Years,
			        "@minimal",  CALCULATE( SUM( sets[total_colors] ), sets[color_variety_tier] = "Minimal" ),
			        "@basic",    CALCULATE( SUM( sets[total_colors] ), sets[color_variety_tier] = "Basic" ),
			        "@balanced", CALCULATE( SUM( sets[total_colors] ), sets[color_variety_tier] = "Balanced" ),
			        "@colorful", CALCULATE( SUM( sets[total_colors] ), sets[color_variety_tier] = "Colorful" ),
			        "@rainbow",  CALCULATE( SUM( sets[total_colors] ), sets[color_variety_tier] = "Rainbow" )
			    )
			
			VAR _CumulativeData =
			    ADDCOLUMNS(
			        _RawData,
			        "@minimalVal",  IF( ISBLANK( [@minimal] ), 0, [@minimal] ),
			        "@basicVal",    IF( ISBLANK( [@basic] ), 0, [@basic] ),
			        "@balancedVal", IF( ISBLANK( [@balanced] ), 0, [@balanced] ),
			        "@colorfulVal", IF( ISBLANK( [@colorful] ), 0, [@colorful] ),
			        "@rainbowVal",  IF( ISBLANK( [@rainbow] ), 0, [@rainbow] ),
			        "@y1", IF( ISBLANK( [@minimal] ), 0, [@minimal] ),
			        "@y2", IF( ISBLANK( [@minimal] ), 0, [@minimal] ) + IF( ISBLANK( [@basic] ), 0, [@basic] ),
			        "@y3", IF( ISBLANK( [@minimal] ), 0, [@minimal] ) + IF( ISBLANK( [@basic] ), 0, [@basic] ) + IF( ISBLANK( [@balanced] ), 0, [@balanced] ),
			        "@y4", IF( ISBLANK( [@minimal] ), 0, [@minimal] ) + IF( ISBLANK( [@basic] ), 0, [@basic] ) + IF( ISBLANK( [@balanced] ), 0, [@balanced] ) + IF( ISBLANK( [@colorful] ), 0, [@colorful] ),
			        "@y5", IF( ISBLANK( [@minimal] ), 0, [@minimal] ) + IF( ISBLANK( [@basic] ), 0, [@basic] ) + IF( ISBLANK( [@balanced] ), 0, [@balanced] ) + IF( ISBLANK( [@colorful] ), 0, [@colorful] ) + IF( ISBLANK( [@rainbow] ), 0, [@rainbow] )
			    )
			
			VAR _MaxTotal = MAXX( _CumulativeData, [@y5] )
			VAR _PlotWidth  = _ChartWidth  - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop  - _MarginBottom
			
			-- ============================================
			-- === SVG PATH GENERATION ====================
			-- ============================================
			
			VAR _MinimalTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _MinimalBottomY = _MarginTop + _PlotHeight
			VAR _MinimalFillPath = "M " & _MarginLeft & "," & _MinimalBottomY & " L " & _MinimalTop & " L " & ( _MarginLeft + _PlotWidth ) & "," & _MinimalBottomY & " Z"
			
			VAR _BasicTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _BasicBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _BasicFillPath = "M " & _BasicTop & " L " & _BasicBottom & " Z"
			
			VAR _BalancedTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _BalancedBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _BalancedFillPath = "M " & _BalancedTop & " L " & _BalancedBottom & " Z"
			
			VAR _ColorfulTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _ColorfulBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _ColorfulFillPath = "M " & _ColorfulTop & " L " & _ColorfulBottom & " Z"
			
			VAR _RainbowTop =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], ASC )
			VAR _RainbowBottom =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN _X & "," & _Y, " ", [@yearNum], DESC )
			VAR _RainbowFillPath = "M " & _RainbowTop & " L " & _RainbowBottom & " Z"
			
			VAR _MinimalLine  = "M " & _MinimalTop
			VAR _BasicLine    = "M " & _BasicTop
			VAR _BalancedLine = "M " & _BalancedTop
			VAR _ColorfulLine = "M " & _ColorfulTop
			VAR _RainbowLine  = "M " & _RainbowTop
			
			-- ============================================
			-- === DATA DOTS ==============================
			-- ============================================
			
			VAR _MinimalDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorMinimal & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _BasicDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorBasic & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _BalancedDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorBalanced & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _ColorfulDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorColorful & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			VAR _RainbowDots =
			    CONCATENATEX( _CumulativeData, VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorRainbow & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />", "", [@yearNum], ASC )
			
			-- ============================================
			-- === UNIQUE IDs =============================
			-- ============================================
			
			VAR _UID = "colorvar" & RANDBETWEEN( 10000000, 99999999 )
			
			-- ============================================
			-- === HOVER TRACKERS =========================
			-- ============================================
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _BandWidth = IF( _YearSpan = 0, _PlotWidth, _PlotWidth / _YearSpan )
			        VAR _BandX = _X - _BandWidth / 2
			        VAR _DataAttrs =
			            " data-year='" & [@yearNum] & "'" &
			            " data-minimal='" & FORMAT( [@minimalVal], "#,0" ) & "'" &
			            " data-basic='" & FORMAT( [@basicVal], "#,0" ) & "'" &
			            " data-balanced='" & FORMAT( [@balancedVal], "#,0" ) & "'" &
			            " data-colorful='" & FORMAT( [@colorfulVal], "#,0" ) & "'" &
			            " data-rainbow='" & FORMAT( [@rainbowVal], "#,0" ) & "'" &
			            " data-total='" & FORMAT( [@y5], "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band-" & _UID & "' x='" & _BandX & "' y='" & _MarginTop & "' width='" & _BandWidth & "' height='" & _PlotHeight & "' fill='transparent'" & _DataAttrs & " />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line-" & _UID & "' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS =================================
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR _T = [Value]
			        VAR _YVal = _MaxTotal * _T / 4
			        VAR _YPos = _MarginTop + _PlotHeight - ( _T / 4 ) * _PlotHeight
			        VAR _Label = FORMAT( _YVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & _YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & _YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( _YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & _Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (smart ticks) ===================
			-- ============================================
			
			VAR _UseDecadeTicks = _YearSpan > _DecadeTickThreshold
			
			VAR _MinDecade = CEILING( _MinYear / 10, 1 ) * 10
			VAR _MaxDecade = FLOOR( _MaxYear / 10, 1 ) * 10
			VAR _DecadeCount = ( _MaxDecade - _MinDecade ) / 10 + 1
			
			VAR _DecadeTickYears =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            GENERATESERIES( 0, _DecadeCount - 1, 1 ),
			            "@yearCalc", _MinDecade + [Value] * 10
			        ),
			        "@yearNum", [@yearCalc]
			    )
			
			VAR _YearCount = COUNTROWS( _CumulativeData )
			VAR _TickStep = MAX( 1, CEILING( DIVIDE( _YearCount, _MaxXTicks ), 1 ) )
			
			VAR _CumulativeIndexed =
			    ADDCOLUMNS(
			        _CumulativeData,
			        "@idx", RANKX( _CumulativeData, [@yearNum], , ASC, DENSE )
			    )
			
			VAR _AdaptiveTickYears =
			    SELECTCOLUMNS(
			        FILTER(
			            _CumulativeIndexed,
			            MOD( [@idx] - 1, _TickStep ) = 0 || [@yearNum] = _MaxYear
			        ),
			        "@yearNum", [@yearNum]
			    )
			
			VAR _XTickYears =
			    UNION(
			        FILTER( _DecadeTickYears, _UseDecadeTicks ),
			        FILTER( _AdaptiveTickYears, NOT _UseDecadeTicks )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _XTickYears,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _YBottom = _MarginTop + _PlotHeight
			        RETURN
			            "<line x1='" & _X & "' y1='" & _YBottom &
			            "' x2='" & _X & "' y2='" & ( _YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & _X & "' y='" & ( _YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & [@yearNum] & "</text>",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === LEGEND (evenly-spaced) =================
			-- ============================================
			
			VAR _CharWidth       = _LegendFontSize * 0.55
			VAR _WidthMinimal    = 7  * _CharWidth
			VAR _WidthBasic      = 5  * _CharWidth
			VAR _WidthBalanced   = 8  * _CharWidth
			VAR _WidthColorful   = 8  * _CharWidth
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthMinimal  + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthBasic    + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthBalanced + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthColorful + _LegendGap
			
			VAR _LegendY = _MarginTop + _PlotHeight + _LegendOffsetY + 20
			VAR _LegendStartX = _MarginLeft + _LegendStartOffsetX
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-family='" & _FontFamily & "' font-size='" & _LegendFontSize & "' fill='" & _LegendTextColor & "'>" &
			    "<rect x='" & _Pos1 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMinimal & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Minimal</text>" &
			    "<rect x='" & _Pos2 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorBasic & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Basic</text>" &
			    "<rect x='" & _Pos3 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorBalanced & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Balanced</text>" &
			    "<rect x='" & _Pos4 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorColorful & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Colorful</text>" &
			    "<rect x='" & _Pos5 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorRainbow & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Rainbow</text>" &
			    "</g>"
			
			VAR _Baseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === REVEAL ANIMATION =======================
			-- ============================================
			
			VAR _RevealAnimation =
			"<clipPath id='reveal-clip-" & _UID & "'>
			    <rect x='" & _MarginLeft & "' y='0' width='0' height='" & _ChartHeight & "'>
			        <animate attributeName='width'
			                 from='0'
			                 to='" & _PlotWidth & "'
			                 dur='" & ( _AnimationDuration / 1000 ) & "s'
			                 fill='freeze'
			                 begin='0s' />
			    </rect>
			</clipPath>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			.chart-container-" & _UID & " { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band-" & _UID & " { cursor:crosshair; }
			#custom-tooltip-" & _UID & " {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip-" & _UID & " .tt-year { font-weight:700; margin-bottom:6px; font-size:20px; }
			#custom-tooltip-" & _UID & " .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip-" & _UID & " .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip-" & _UID & " .tt-label { display:flex; align-items:center; }
			#custom-tooltip-" & _UID & " .tt-value { font-weight:600; }
			#custom-tooltip-" & _UID & " .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML =
			"<div id='custom-tooltip-" & _UID & "'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip-" & _UID & "');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line-" & _UID & "');
			    var bands = document.querySelectorAll('.hover-band-" & _UID & "');
			    var colors = {
			        minimal:  '" & _ColorMinimal  & "',
			        basic:    '" & _ColorBasic    & "',
			        balanced: '" & _ColorBalanced & "',
			        colorful: '" & _ColorColorful & "',
			        rainbow:  '" & _ColorRainbow  & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-year" & UNICHAR(34) & ">' + d.year + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.rainbow + '" & UNICHAR(34) & "></span>Rainbow</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.rainbow + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.colorful + '" & UNICHAR(34) & "></span>Colorful</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.colorful + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.balanced + '" & UNICHAR(34) & "></span>Balanced</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.balanced + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.basic + '" & UNICHAR(34) & "></span>Basic</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.basic + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.minimal + '" & UNICHAR(34) & "></span>Minimal</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.minimal + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container-" & _UID & "'>
			    <svg xmlns='http://www.w3.org/2000/svg'
			         viewBox='0 0 " & _ChartWidth & " " & _ChartHeight & "'
			         preserveAspectRatio='xMidYMid meet'
			         style='width:100%;height:100%;'>
			        <defs>" & _RevealAnimation & "</defs>
			
			        " & _YAxisElements & "
			        " & _Baseline & "
			        " & _XAxisElements & "
			
			        <g clip-path='url(#reveal-clip-" & _UID & ")'>
			            <path d='" & _MinimalFillPath  & "' fill='" & _ColorMinimal  & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _BasicFillPath    & "' fill='" & _ColorBasic    & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _BalancedFillPath & "' fill='" & _ColorBalanced & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _ColorfulFillPath & "' fill='" & _ColorColorful & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _RainbowFillPath  & "' fill='" & _ColorRainbow  & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			
			            <path d='" & _MinimalLine  & "' fill='none' stroke='" & _ColorMinimal  & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _BasicLine    & "' fill='none' stroke='" & _ColorBasic    & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _BalancedLine & "' fill='none' stroke='" & _ColorBalanced & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _ColorfulLine & "' fill='none' stroke='" & _ColorColorful & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _RainbowLine  & "' fill='none' stroke='" & _ColorRainbow  & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			
			            " & _MinimalDots  & "
			            " & _BasicDots    & "
			            " & _BalancedDots & "
			            " & _ColorfulDots & "
			            " & _RainbowDots  & "
			        </g>
			
			        " & _HoverIndicator & "
			        " & _HoverTrackers & "
			        " & _Legend & "
			    </svg>
			" & _TooltipHTML & "
			</div>" &
			_TooltipScript
			
			RETURN _HTML
		lineageTag: 5d26c926-79eb-44f5-a327-86e626e0242e

	measure 'HTML Parts Variety Histogram' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Bin config
			VAR _NumBins            = 75
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 272
			VAR _MarginLeft         = 55            -- room for y-axis labels
			VAR _MarginRight        = 15
			VAR _MarginTop          = 13
			VAR _MarginBottom       = 10            -- room for x-axis labels
			
			-- Bar styling
			VAR _BarGap             = 2
			VAR _CornerRadius       = 3
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 18
			VAR _YAxisFontSize      = 20
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 20
			VAR _LegendPaddingTop   = 15            -- gap between bars/x-axis and legend
			VAR _LegendPaddingLeft  = 0             -- left offset for legend (from _MarginLeft)
			VAR _LegendSwatchSize   = 15
			VAR _LegendColumns      = 3             -- items per row (1 = fully vertical stack, 5 = single row)
			VAR _LegendRowHeight    = 30            -- vertical space per row (swatch + padding)
			VAR _TextSwatchGap      = 8             -- gap between swatch and its label
			
			-- Legend derived
			VAR _LegendItemCount    = 5
			VAR _LegendRows         = ROUNDUP ( DIVIDE ( _LegendItemCount, _LegendColumns ), 0 )
			VAR _LegendTotalHeight  = _LegendRows * _LegendRowHeight
			VAR _LegendColWidth     = DIVIDE ( _SvgWidth - _MarginLeft - _MarginRight - _LegendPaddingLeft, _LegendColumns )
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _AnimDuration       = 0.0008
			VAR _AnimStagger        = 0.02
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			
			VAR _SvgHeight  = _ChartHeight + _LegendPaddingTop + _LegendTotalHeight
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxParts = CALCULATE( MAX( sets[distinct_count_parts] ), ALL( sets ), sets[distinct_count_parts] > 0 )
			
			VAR _LogMin = LOG10( _MinParts )
			VAR _LogMax = LOG10( _MaxParts )
			
			VAR _BinNumbers = GENERATESERIES( 0, _NumBins - 1, 1 )
			
			VAR _BinEdges =
			    ADDCOLUMNS(
			        _BinNumbers,
			        "lo",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( [Value] / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinParts + ( [Value] / _NumBins ) * ( _MaxParts - _MinParts )
			            ),
			        "hi",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( ( [Value] + 1 ) / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinParts + ( ( [Value] + 1 ) / _NumBins ) * ( _MaxParts - _MinParts )
			            )
			    )
			
			VAR _Tiers =
			    DATATABLE( "tier_name", STRING, "tier_color", STRING, "stack_order", INTEGER,
			        {
			            { "None",  "#2ECC71", 1 },
			            { "Simple Build",  "#2a78d6", 2 },
			            { "Mixed Build", "#F4B400", 3 },
			            { "Varied Build",  "#ab6643", 4 },
			            { "Complex Assembly",   "#E53935", 5 }
			        }
			    )
			
			VAR _BinTierCounts =
			    ADDCOLUMNS(
			        CROSSJOIN( _BinEdges, _Tiers ),
			        "seg_count",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            VAR T  = [tier_name]
			            RETURN
			                CALCULATE(
			                    COUNTROWS( sets ),
			                    sets[distinct_count_parts] >= Lo,
			                    sets[distinct_count_parts] < Hi,
			                    sets[part_variety_tier] = T
			                )
			    )
			
			VAR _MaxBinTotal =
			    MAXX(
			        _BinEdges,
			        VAR Lo = [lo]
			        VAR Hi = [hi]
			        RETURN
			            CALCULATE(
			                COUNTROWS( sets ),
			                sets[distinct_count_parts] >= Lo,
			                sets[distinct_count_parts] < Hi
			            )
			    )
			
			VAR _BarSlot  = DIVIDE( _PlotWidth, _NumBins )
			VAR _BarWidth = _BarSlot - _BarGap
			
			-- ============================================
			-- === STACKED BARS ===========================
			-- ============================================
			
			VAR _Bars =
			    CONCATENATEX(
			        _BinEdges,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR Delay = BinIdx * _AnimStagger
			        VAR SegmentsForBin = FILTER( _BinTierCounts, [Value] = BinIdx )
			        RETURN
			            CONCATENATEX(
			                SegmentsForBin,
			                VAR SegHeight = DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                VAR CumBelow =
			                    SUMX(
			                        FILTER( SegmentsForBin, [stack_order] < EARLIER( [stack_order] ) ),
			                        DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                    )
			                VAR Y = _MarginTop + _PlotHeight - CumBelow - SegHeight
			                RETURN
			                    IF(
			                        [seg_count] > 0,
			                        "<rect x='" & X & "' y='" & Y & "' width='" & _BarWidth & "' height='" & SegHeight &
			                        "' fill='" & [tier_color] & "' " &
			                        "style='animation:barFade " & _AnimDuration & "s ease-out " & Delay & "s both'>" &
			                        "<title>" & [tier_name] & ": " & [seg_count] & " sets (" &
			                        FORMAT( ROUND( [lo], 0 ), "#,##0" ) & "-" & FORMAT( ROUND( [hi], 0 ), "#,##0" ) & " parts)</title></rect>",
			                        ""
			                    ),
			                "",
			                [stack_order], ASC
			            ),
			        "",
			        [Value], ASC
			    )
			
			-- ============================================
			-- === HOVER TRACKERS =========================
			-- ============================================
			-- One invisible rect per bin, spanning full plot height with data attributes for all tier values
			
			VAR _BinTotals =
			    ADDCOLUMNS(
			        _BinEdges,
			        "@micro",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[distinct_count_parts] >= Lo, sets[distinct_count_parts] < Hi, sets[part_variety_tier] = "None" ),
			        "@small",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[distinct_count_parts] >= Lo, sets[distinct_count_parts] < Hi, sets[part_variety_tier] = "Simple Build" ),
			        "@medium",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[distinct_count_parts] >= Lo, sets[distinct_count_parts] < Hi, sets[part_variety_tier] = "Mixed Build" ),
			        "@large",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[distinct_count_parts] >= Lo, sets[distinct_count_parts] < Hi, sets[part_variety_tier] = "Varied Build" ),
			        "@mega",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[distinct_count_parts] >= Lo, sets[distinct_count_parts] < Hi, sets[part_variety_tier] = "Complex Assembly" ),
			        "@total",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi )
			    )
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _BinTotals,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR TotalCount = IF( ISBLANK( [@total] ), 0, [@total] )
			        VAR MicroCount = IF( ISBLANK( [@micro] ), 0, [@micro] )
			        VAR SmallCount = IF( ISBLANK( [@small] ), 0, [@small] )
			        VAR MediumCount = IF( ISBLANK( [@medium] ), 0, [@medium] )
			        VAR LargeCount = IF( ISBLANK( [@large] ), 0, [@large] )
			        VAR MegaCount = IF( ISBLANK( [@mega] ), 0, [@mega] )
			        VAR DataAttrs =
			            " data-range='" & FORMAT( ROUND( [lo], 0 ), "#,0" ) & " - " & FORMAT( ROUND( [hi], 0 ), "#,0" ) & " parts'" &
			            " data-micro='" & FORMAT( MicroCount, "#,0" ) & "'" &
			            " data-small='" & FORMAT( SmallCount, "#,0" ) & "'" &
			            " data-medium='" & FORMAT( MediumCount, "#,0" ) & "'" &
			            " data-large='" & FORMAT( LargeCount, "#,0" ) & "'" &
			            " data-mega='" & FORMAT( MegaCount, "#,0" ) & "'" &
			            " data-total='" & FORMAT( TotalCount, "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band' x='" & X & "' y='" & _MarginTop & "' width='" & _BarSlot & "' height='" & _PlotHeight & "' fill='transparent'" & DataAttrs & " />",
			        "",
			        [Value], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS (5 evenly-spaced count ticks) ===
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR T = [Value]
			        VAR CountVal = _MaxBinTotal * T / 4
			        VAR YPos = _MarginTop + _PlotHeight - ( T / 4 ) * _PlotHeight
			        VAR Label = FORMAT( CountVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (powers of 10) ==================
			-- ============================================
			-- Ticks at 1, 10, 100, 1000, 10000, etc. within the data range
			
			VAR _MinPowerOf10 = CEILING( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS(
			        GENERATESERIES( 0, _PowerCount - 1, 1 ),
			        "@power", _MinPowerOf10 + [Value],
			        "@partsVal", POWER( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR LogPos = LOG10( PartsVal )
			        VAR NormPos = DIVIDE( LogPos - _LogMin, _LogMax - _LogMin )
			        VAR XPos = _MarginLeft + NormPos * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & YBottom &
			            "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === LEGEND =================================
			-- ============================================
			
			VAR _LegendY = _ChartHeight + _LegendPaddingTop
			VAR _LegendStartX = _MarginLeft + _LegendPaddingLeft
			
			VAR _LegendItems =
			    DATATABLE (
			        "idx", INTEGER,
			        "lbl", STRING,
			        {
			            { 1, "None" },
			            { 2, "Simple Build" },
			            { 3, "Mixed Build" },
			            { 4, "Varied Build" },
			            { 5, "Complex Assembly" }
			        }
			    )
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-size='" & _LegendFontSize & "' font-family='" & _FontFamily & "'>" &
			    CONCATENATEX (
			        _LegendItems,
			        VAR _Row = INT ( DIVIDE ( [idx] - 1, _LegendColumns ) )
			        VAR _Col = MOD ( [idx] - 1, _LegendColumns )
			        VAR _X = _Col * _LegendColWidth
			        VAR _Y = _Row * _LegendRowHeight
			        VAR _Color =
			            SWITCH (
			                [lbl],
			                "None",             _ColorMicro,
			                "Simple Build",     _ColorSmall,
			                "Mixed Build",      _ColorMedium,
			                "Varied Build",     _ColorLarge,
			                "Complex Assembly", _ColorMega
			            )
			        RETURN
			            "<rect x='" & _X & "' y='" & _Y & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize &
			            "' fill='" & _Color & "'/>" &
			            "<text x='" & ( _X + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & ( _Y + _LegendSwatchSize ) & "'>" & [lbl] & "</text>",
			        "",
			        [idx], ASC
			    ) &
			    "</g>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes barFade{from{opacity:0;transform:scaleY(0);transform-origin:bottom}to{opacity:1;transform:scaleY(1)}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band { cursor:crosshair; }
			#custom-tooltip {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip .tt-range { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip .tt-label { display:flex; align-items:center; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line');
			    var bands = document.querySelectorAll('.hover-band');
			    var colors = {
			        micro:  '" & _ColorMicro  & "',
			        small:  '" & _ColorSmall  & "',
			        medium: '" & _ColorMedium & "',
			        large:  '" & _ColorLarge  & "',
			        mega:   '" & _ColorMega   & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-range" & UNICHAR(34) & ">' + d.range + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.mega + '" & UNICHAR(34) & "></span>Complex Assembly</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.mega + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.large + '" & UNICHAR(34) & "></span>Varied Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.large + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.medium + '" & UNICHAR(34) & "></span>Mixed Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.medium + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.small + '" & UNICHAR(34) & "></span>Simple Build</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.small + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.micro + '" & UNICHAR(34) & "></span>None</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.micro + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container'>" &
			"<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight & "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			_YAxisElements &
			_XAxisBaseline &
			"<g>" & _Bars & "</g>" &
			_XAxisElements &
			_HoverIndicator &
			_HoverTrackers &
			_Legend &
			"</svg>" &
			_TooltipHTML &
			"</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 85082e0f-535d-495a-9b3a-d43be44c6ed2

	measure 'HTML LEGO Unified Timeline' =
			
			
			VAR __UID = RANDBETWEEN ( 100000, 999999 )
			VAR Q = UNICHAR ( 34 )
			
			// =====================================================================================
			// SECTION 1 — MASTER CONFIG
			// =====================================================================================
			
			// --- Canvas ---
			VAR __ChartW  = 1920
			VAR __ChartH  = 775
			VAR __PadL    = 70
			VAR __PadR    = 30
			VAR __PadB    = 40
			VAR __TopCrop = 0
			
			// --- Theme timeline (top) ---
			VAR __ThemeImgSize   = 75
			VAR __ThemeImgY      = 0
			VAR __ThemeNameY     = 90
			VAR __ThemeNameLineH = 12
			VAR __ThemeLineY     = 110
			VAR __ThemeDotR      = 10
			VAR __ThemeDecadeY   = 145
			VAR __ThemeMaxChars  = 14
			
			// --- Line chart (bottom) ---
			VAR __LineTop            = 220
			VAR __LineWidth          = 4
			VAR __ColorLineByDecade  = TRUE
			VAR __DefaultLineColor   = "#75C3FA"
			VAR __DefaultDotColor    = "#0055BF"
			VAR __MatchDotsToDecade  = TRUE          // TRUE = each dot follows its own decade color
			VAR __DotRadius          = 6
			VAR __TopHeadroom        = 1.5
			
			// --- Area fill ---
			VAR __AreaTopOpacity     = 0.30
			VAR __AreaBottomOpacity  = 0.03
			
			// --- Milestones ---
			VAR __MilestoneImageSize      = 80
			VAR __MilestoneDotRadius      = 7
			VAR __MilestonePulseRadius    = 10
			VAR __PulseAnimDuration       = "1.3s"
			VAR __PulseMinOpacity         = 0.55
			VAR __MilestoneImageTopOffset = 10
			VAR __MilestoneCaptionGap     = 100
			VAR __MilestoneConnectorGap   = 10
			VAR __WordsPerLine            = 3
			VAR __CaptionLineHeight       = 16
			VAR __YearLabelOffsetY        = 22
			VAR __YearLabelLineHeight     = 15
			VAR __YearLabelColor          = "#000000"   // NEW: year/count text under milestone dots
			
			// --- Decade boundary lines ---
			VAR __ShowBoundaries          = TRUE
			VAR __BoundaryColor           = "#B8B8B8"
			VAR __BoundaryDash            = "4,4"
			VAR __BoundaryOpacity         = 0.9
			VAR __BoundaryStrokeWidth     = 1.5
			VAR __BoundaryTopY            = 190
			VAR __HighlightActiveBoundary = TRUE
			VAR __ActiveBoundaryWidth     = 1.6
			
			// --- Y-axis ---
			VAR __TickStep         = 500
			VAR __GridColor        = "#888"
			VAR __GridLabelColor   = "#666"
			VAR __GridlineOpacity  = 0.4
			
			// --- Axis titles ---
			VAR __ShowAxisTitles       = TRUE
			VAR __XAxisTitle           = "Year of Release"
			VAR __YAxisTitle           = "Number of Sets Released"
			VAR __AxisTitleColor       = "#000000"
			VAR __AxisTitleFontSize    = 18
			VAR __AxisTitleFontWeight  = "600"
			VAR __XAxisTitleOffsetY    = 40      // distance below the X-axis line
			VAR __YAxisTitleOffsetX    = 50      // distance left of the Y-axis line
			
			// --- Fonts ---
			VAR __FontFamily         = "Poppins, 'Segoe UI', sans-serif"
			VAR __FontSizeTheme      = 20
			VAR __FontSizeDecade     = 20
			VAR __FontSizeCaption    = 18
			VAR __FontSizeYearLabel  = 15
			VAR __FontSizeTickLabel  = 15
			
			// --- Tooltip (color is now per-point, driven by hovered year's decade) ---
			VAR __TooltipDefaultColor = "#0055BF"     // fallback when a year has no decade match
			VAR __TTBgColor          = "#FFFFFF"
			VAR __TTBorderWidth      = 2
			VAR __TTAccentBarHeight  = 4
			VAR __TTRadius           = 8
			VAR __TTPaddingY         = 14
			VAR __TTPaddingX         = 16
			VAR __TTMinWidth         = 200
			VAR __TTShadow           = "0 10px 24px rgba(0,0,0,0.18)"
			VAR __TTFontFamily       = "Poppins, 'Segoe UI', sans-serif"
			VAR __TTFontSizeYear     = 25
			VAR __TTFontSizeRow      = 22
			VAR __TTFontSizeValue    = 22
			VAR __TTFontSizeEvent    = 20
			VAR __TTLabelColor       = "#252423"
			VAR __TTEventColor       = "#605E5C"
			VAR __TTLegendDotSize    = 25
			
			// --- Misc colors ---
			VAR __CaptionTextColor = "#333"
			VAR __ConnectorColor   = "#9baec2"
			VAR __GreyImageColor   = "#C7C7C7"
			VAR __GreyText         = "#ADADAD"
			
			// --- Theme entrance animation timing ---
			VAR __SegMs  = 225
			VAR __FadeMs = 275
			VAR __DotMs  = 125
			
			// --- Selection behavior ---
			VAR __HideInactiveImages = TRUE
			
			// =====================================================================================
			// SECTION 2 — DYNAMIC IDs / CLASSES
			// =====================================================================================
			VAR __PopKF      = "lgPop"  & __UID
			VAR __RiseKF     = "lgRise" & __UID
			VAR __PulseKF    = "pulse"  & __UID
			VAR __DotCls     = "lg-dot" & __UID
			VAR __RiseCls    = "lg-rise" & __UID
			VAR __PulseCls   = "pulse-ring" & __UID
			VAR __GreyFilter = "grey"    & __UID
			VAR __AreaGradId = "areaGrad" & __UID
			VAR __VFadeId    = "vFade"    & __UID
			VAR __MaskId     = "areaMask" & __UID
			VAR __SvgId      = "pbiChartSvg" & __UID
			VAR __TTId       = "pbiTooltip"  & __UID
			VAR __TTAccentId = "pbiTTAccent" & __UID
			VAR __TTYearId   = "pbiTTYear"   & __UID
			VAR __TTLegendId = "pbiTTLegend" & __UID
			VAR __TTValueId  = "pbiTTValue"  & __UID
			VAR __TTEventId  = "pbiTTEvent"  & __UID
			VAR __ChLineId   = "crosshairLine" & __UID
			VAR __ChDotId    = "crosshairDot"  & __UID
			
			// =====================================================================================
			// SECTION 3 — DATA PREP + ACTIVE COLOR
			// =====================================================================================
			VAR __SelectedDecade = SELECTEDVALUE ( decade_theme_highlights[Decade] )
			VAR __HasSelection   = HASONEVALUE   ( decade_theme_highlights[Decade] )
			
			VAR __SelectedAccent =
			    CALCULATE (
			        SELECTEDVALUE ( decade_theme_highlights[AccentColor] ),
			        decade_theme_highlights[Decade] = __SelectedDecade
			    )
			VAR __ActiveColor =
			    IF ( __HasSelection && NOT ISBLANK ( __SelectedAccent ), __SelectedAccent, __DefaultLineColor )
			
			VAR __LineBottom = __ChartH - __PadB
			VAR __LinePlotH  = __LineBottom - __LineTop
			VAR __XRange     = __ChartW - __PadL - __PadR
			
			VAR __YearlyCounts =
			    ADDCOLUMNS (
			        SUMMARIZE ( sets, sets[year_release] ),
			        "SetCount",  CALCULATE ( COUNTROWS ( sets ) ),
			        "EventText", CALCULATE ( MAX ( sets[event] ) ),
			        "ImageUrl",  CALCULATE ( MAX ( sets[image_line_chart] ) ),
			        "MXOff",     CALCULATE ( MAX ( sets[ManualXOffset] ) ),
			        "MIYOff",    CALCULATE ( MAX ( sets[ManualImageYOffset] ) ),
			        "MCYOff",    CALCULATE ( MAX ( sets[ManualCaptionYOffset] ) )
			    )
			
			VAR __MinY    = MINX ( __YearlyCounts, sets[year_release] )
			VAR __MaxY    = MAXX ( __YearlyCounts, sets[year_release] )
			VAR __MinS    = 0
			VAR __RawMaxS = MAXX ( __YearlyCounts, [SetCount] )
			VAR __MaxS    = IF ( ISBLANK ( __RawMaxS ) || __RawMaxS = 0, 100, __RawMaxS )
			VAR __TickMax = CEILING ( __MaxS * __TopHeadroom, __TickStep )
			VAR __TickCount = __TickMax / __TickStep
			
			VAR __PointsTable =
			    ADDCOLUMNS (
			        __YearlyCounts,
			        "PX", __PadL + ( sets[year_release] - __MinY ) / ( __MaxY - __MinY ) * __XRange,
			        "PY", __LineTop + __LinePlotH - ( [SetCount] - __MinS ) / ( __TickMax - __MinS ) * __LinePlotH,
			        "DecadeStart", INT ( sets[year_release] / 10 ) * 10
			    )
			
			VAR __DecadesBase =
			    ADDCOLUMNS (
			        ALL ( decade_theme_highlights ),
			        "@DecStart", VALUE ( LEFT ( decade_theme_highlights[Decade], 4 ) )
			    )
			
			VAR __MinDecStart = MINX ( __DecadesBase, [@DecStart] )
			VAR __MaxDecStart = MAXX ( __DecadesBase, [@DecStart] )
			
			VAR __Decades =
			    ADDCOLUMNS (
			        __DecadesBase,
			        "@X",         __PadL + ( ( [@DecStart] + 5 ) - __MinY ) / ( __MaxY - __MinY ) * __XRange,
			        "@BoundaryX", __PadL + ( [@DecStart] - __MinY ) / ( __MaxY - __MinY ) * __XRange,
			        "@Active",    NOT __HasSelection || decade_theme_highlights[Decade] = __SelectedDecade,
			        "@Delay",     ( ( [@DecStart] - __MinDecStart ) / 10 ) * __SegMs
			    )
			
			// =====================================================================================
			// SECTION 4 — STYLES + DEFS (with multi-decade area gradient)
			// =====================================================================================
			
			// Horizontal multi-color gradient: two stops per decade (start, next-start) => sharp bands
			VAR __GradStops =
			    CONCATENATEX (
			        __Decades,
			        VAR __CurBX = [@BoundaryX]
			        VAR __NextBX_lookup =
			            MINX (
			                FILTER ( __Decades, [@BoundaryX] > __CurBX ),
			                [@BoundaryX]
			            )
			        VAR __NextBX = IF ( ISBLANK ( __NextBX_lookup ), __ChartW - __PadR, __NextBX_lookup )
			        VAR __StartPct = ( __CurBX - __PadL ) / __XRange * 100
			        VAR __EndPct   = ( __NextBX - __PadL ) / __XRange * 100
			        VAR __Col = decade_theme_highlights[AccentColor]
			        RETURN
			            "<stop offset='" & ROUND ( MAX ( __StartPct, 0 ), 2 ) & "%' stop-color='" & __Col & "'/>" &
			            "<stop offset='" & ROUND ( MIN ( __EndPct, 100 ), 2 ) & "%' stop-color='" & __Col & "'/>",
			        "",
			        [@BoundaryX], ASC
			    )
			
			VAR __GradientDef =
			    IF (
			        __HasSelection,
			        // Filtered: single-color vertical gradient
			        "<linearGradient id='" & __AreaGradId & "' x1='0' y1='0' x2='0' y2='1'>" &
			            "<stop offset='0%' stop-color='" & __ActiveColor & "' stop-opacity='" & __AreaTopOpacity & "'/>" &
			            "<stop offset='100%' stop-color='" & __ActiveColor & "' stop-opacity='" & __AreaBottomOpacity & "'/>" &
			        "</linearGradient>",
			        // No filter: horizontal decade-color bands + vertical opacity mask
			        "<linearGradient id='" & __AreaGradId & "' gradientUnits='userSpaceOnUse' x1='" & __PadL & "' y1='0' x2='" & ( __ChartW - __PadR ) & "' y2='0'>" &
			            __GradStops &
			        "</linearGradient>" &
			        "<linearGradient id='" & __VFadeId & "' x1='0' y1='0' x2='0' y2='1'>" &
			            "<stop offset='0%' stop-color='white' stop-opacity='" & __AreaTopOpacity & "'/>" &
			            "<stop offset='100%' stop-color='white' stop-opacity='" & __AreaBottomOpacity & "'/>" &
			        "</linearGradient>" &
			        "<mask id='" & __MaskId & "'>" &
			            "<rect x='" & __PadL & "' y='" & __LineTop & "' width='" & __XRange & "' height='" & __LinePlotH & "' fill='url(#" & __VFadeId & ")'/>" &
			        "</mask>"
			    )
			
			VAR __Defs =
			    "<defs>" &
			    "<filter id='" & __GreyFilter & "'><feColorMatrix type='saturate' values='0'/></filter>" &
			    __GradientDef &
			    "</defs>"
			
			VAR __Styles =
			    "<style>" &
			    "@keyframes " & __PopKF  & "{from{opacity:0;transform:scale(0);}to{opacity:1;transform:scale(1);}}" &
			    "@keyframes " & __RiseKF & "{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}" &
			    "@keyframes " & __PulseKF & "{0%{r:" & __MilestoneDotRadius & ";opacity:1;}50%{r:" & __MilestonePulseRadius & ";opacity:" & __PulseMinOpacity & ";}100%{r:" & __MilestoneDotRadius & ";opacity:1;}}" &
			    "." & __DotCls  & "{transform-box:fill-box;transform-origin:center;animation-name:" & __PopKF  & ";animation-timing-function:ease-out;animation-fill-mode:both;}" &
			    "." & __RiseCls & "{transform-box:fill-box;transform-origin:center;animation-name:" & __RiseKF & ";animation-timing-function:ease-out;animation-fill-mode:both;}" &
			    "." & __PulseCls & "{animation:" & __PulseKF & " " & __PulseAnimDuration & " ease-in-out infinite;transform-box:fill-box;transform-origin:center;}" &
			    "</style>"
			
			// =====================================================================================
			// SECTION 5 — DECADE BOUNDARY LINES
			// =====================================================================================
			VAR __BoundaryLines =
			    IF (
			        __ShowBoundaries,
			        CONCATENATEX (
			            __Decades,
			            VAR __IsActive = [@Active] && __HasSelection && __HighlightActiveBoundary
			            VAR __BCol = IF ( __IsActive, decade_theme_highlights[AccentColor], __BoundaryColor )
			            VAR __BW   = IF ( __IsActive, __ActiveBoundaryWidth, __BoundaryStrokeWidth )
			            VAR __BOp  = IF ( __IsActive, 0.85, __BoundaryOpacity )
			            RETURN
			                "<line x1='" & ROUND ( [@BoundaryX], 1 ) & "' y1='" & __BoundaryTopY &
			                "' x2='" & ROUND ( [@BoundaryX], 1 ) & "' y2='" & __LineBottom &
			                "' stroke='" & __BCol & "' stroke-width='" & __BW &
			                "' stroke-dasharray='" & __BoundaryDash &
			                "' stroke-opacity='" & __BOp & "'/>",
			            "",
			            [@BoundaryX], ASC
			        ),
			        ""
			    )
			
			// =====================================================================================
			// SECTION 6 — THEME TIMELINE (line spans start-year → next-decade-start)
			// =====================================================================================
			VAR __ThemeSegments =
			    CONCATENATEX (
			        __Decades,
			        VAR __CurDecStart = [@DecStart]
			        VAR __NextDecStart = __CurDecStart + 10
			        VAR __NextBoundaryX =
			            MAXX ( FILTER ( __Decades, [@DecStart] = __NextDecStart ), [@BoundaryX] )
			        VAR __EndX =
			            IF ( ISBLANK ( __NextBoundaryX ), __PadL + ( __MaxY - __MinY ) / ( __MaxY - __MinY ) * __XRange, __NextBoundaryX )
			        VAR __StartX = [@BoundaryX]
			        VAR __Col = IF ( [@Active], decade_theme_highlights[AccentColor], __GreyImageColor )
			        RETURN
			            "<line x1='" & ROUND ( __StartX, 1 ) & "' y1='" & __ThemeLineY &
			            "' x2='" & ROUND ( __EndX, 1 ) & "' y2='" & __ThemeLineY &
			            "' stroke='" & __Col & "' stroke-width='4' stroke-linecap='butt'/>",
			        "",
			        [@BoundaryX], ASC
			    )
			
			VAR __ThemeImages =
			    CONCATENATEX (
			        FILTER ( __Decades, [@Active] || NOT __HideInactiveImages ),
			        VAR __ImgFX = IF ( [@Active], "", " filter='url(#" & __GreyFilter & ")' opacity='0.5'" )
			        RETURN
			            "<image class='" & __RiseCls & "' href='" & decade_theme_highlights[ImgURL] &
			            "' xlink:href='" & decade_theme_highlights[ImgURL] &
			            "' x='" & ROUND ( [@X] - __ThemeImgSize / 2, 1 ) & "' y='" & __ThemeImgY &
			            "' width='" & __ThemeImgSize & "' height='" & __ThemeImgSize & "'" & __ImgFX &
			            " preserveAspectRatio='xMidYMid meet' style='animation-duration:" & __FadeMs &
			            "ms;animation-delay:" & [@Delay] & "ms;'/>",
			        "",
			        [@X], ASC
			    )
			
			VAR __ThemeLabels =
			    CONCATENATEX (
			        FILTER ( __Decades, [@Active] || NOT __HideInactiveImages ),
			        VAR __Col = IF ( [@Active], decade_theme_highlights[AccentColor], __GreyText )
			        VAR __ThemeText = decade_theme_highlights[Theme]
			        VAR __WordPath = SUBSTITUTE ( __ThemeText, " ", "|" )
			        VAR __WordCount = PATHLENGTH ( __WordPath )
			        VAR __NeedsWrap = LEN ( __ThemeText ) > __ThemeMaxChars && __WordCount > 1
			        VAR __SplitAt = ROUNDUP ( __WordCount / 2, 0 )
			        VAR __Line1 =
			            IF (
			                __NeedsWrap,
			                CONCATENATEX ( GENERATESERIES ( 1, __SplitAt, 1 ), PATHITEM ( __WordPath, [Value], TEXT ), " " ),
			                __ThemeText
			            )
			        VAR __Line2 =
			            IF (
			                __NeedsWrap,
			                CONCATENATEX ( GENERATESERIES ( __SplitAt + 1, __WordCount, 1 ), PATHITEM ( __WordPath, [Value], TEXT ), " " ),
			                ""
			            )
			        VAR __Text1 =
			            "<text class='" & __RiseCls & "' x='" & ROUND ( [@X], 1 ) & "' y='" & __ThemeNameY &
			            "' text-anchor='middle' font-family='" & __FontFamily & "' font-size='" & __FontSizeTheme &
			            "' font-weight='600' fill='" & __Col &
			            "' style='animation-duration:" & __FadeMs & "ms;animation-delay:" & [@Delay] & "ms;'>" & __Line1 & "</text>"
			        VAR __Text2 =
			            IF (
			                __NeedsWrap,
			                "<text class='" & __RiseCls & "' x='" & ROUND ( [@X], 1 ) & "' y='" & ( __ThemeNameY + __ThemeNameLineH ) &
			                "' text-anchor='middle' font-family='" & __FontFamily & "' font-size='" & __FontSizeTheme &
			                "' font-weight='600' fill='" & __Col &
			                "' style='animation-duration:" & __FadeMs & "ms;animation-delay:" & [@Delay] & "ms;'>" & __Line2 & "</text>",
			                ""
			            )
			        RETURN __Text1 & __Text2,
			        "",
			        [@X], ASC
			    )
			
			VAR __ThemeDots =
			    CONCATENATEX (
			        __Decades,
			        VAR __Col = IF ( [@Active], decade_theme_highlights[AccentColor], __GreyImageColor )
			        RETURN
			            "<circle class='" & __DotCls & "' cx='" & ROUND ( [@X], 1 ) & "' cy='" & __ThemeLineY &
			            "' r='" & __ThemeDotR & "' fill='" & __Col &
			            "' stroke='#FFFFFF' stroke-width='2' style='animation-duration:" & __DotMs &
			            "ms;animation-delay:" & [@Delay] & "ms;'/>",
			        "",
			        [@X], ASC
			    )
			
			VAR __DecadeLabels =
			    CONCATENATEX (
			        __Decades,
			        VAR __Col = IF ( [@Active], decade_theme_highlights[AccentColor], __GreyText )
			        RETURN
			            "<text class='" & __RiseCls & "' x='" & ROUND ( [@X], 1 ) & "' y='" & __ThemeDecadeY &
			            "' text-anchor='middle' font-family='" & __FontFamily & "' font-size='" & __FontSizeDecade &
			            "' font-weight='700' fill='" & __Col &
			            "' style='animation-duration:" & __FadeMs & "ms;animation-delay:" & [@Delay] & "ms;'>" &
			            decade_theme_highlights[Decade] & "</text>",
			        "",
			        [@X], ASC
			    )
			
			// =====================================================================================
			// SECTION 7 — Y-AXIS
			// =====================================================================================
			VAR __YAxisTicks =
			    CONCATENATEX (
			        GENERATESERIES ( 0, __TickCount, 1 ),
			        VAR __TickVal = [Value] * __TickStep
			        VAR __TickY = __LineTop + __LinePlotH - ( __TickVal - __MinS ) / ( __TickMax - __MinS ) * __LinePlotH
			        RETURN
			            "<line x1='" & __PadL & "' y1='" & ROUND ( __TickY, 1 ) & "' x2='" & ( __ChartW - __PadR ) &
			            "' y2='" & ROUND ( __TickY, 1 ) & "' stroke='" & __GridColor & "' stroke-width='0.5' stroke-opacity='" & __GridlineOpacity & "'/>" &
			            "<text x='" & ( __PadL - 10 ) & "' y='" & ROUND ( __TickY + 4, 1 ) &
			            "' text-anchor='end' font-size='" & __FontSizeTickLabel & "' fill='" & __GridLabelColor & "'>" & __TickVal & "</text>",
			        "",
			        [Value], ASC
			    )
			
			// =====================================================================================
			// SECTION 7B — AXIS TITLES
			// =====================================================================================
			VAR __XAxisTitleText =
			    IF (
			        __ShowAxisTitles,
			        "<text x='" & ROUND ( __PadL + __XRange / 2, 1 ) &
			        "' y='" & ( __LineBottom + __XAxisTitleOffsetY ) &
			        "' text-anchor='middle' font-family='" & __FontFamily &
			        "' font-size='" & __AxisTitleFontSize &
			        "' font-weight='" & __AxisTitleFontWeight &
			        "' fill='" & __AxisTitleColor & "'>" & __XAxisTitle & "</text>",
			        ""
			    )
			
			VAR __YAxisTitleText =
			    IF (
			        __ShowAxisTitles,
			        VAR __YTX = __PadL - __YAxisTitleOffsetX
			        VAR __YTY = __LineTop + __LinePlotH / 2
			        RETURN
			            "<text x='" & ROUND ( __YTX, 1 ) & "' y='" & ROUND ( __YTY, 1 ) &
			            "' text-anchor='middle' font-family='" & __FontFamily &
			            "' font-size='" & __AxisTitleFontSize &
			            "' font-weight='" & __AxisTitleFontWeight &
			            "' fill='" & __AxisTitleColor &
			            "' transform='rotate(-90 " & ROUND ( __YTX, 1 ) & " " & ROUND ( __YTY, 1 ) & ")'>" &
			            __YAxisTitle & "</text>",
			        ""
			    )
			
			VAR __YAxisLine = "<line x1='" & __PadL & "' y1='" & __LineTop & "' x2='" & __PadL & "' y2='" & __LineBottom & "' stroke='" & __GridColor & "' stroke-width='1'/>"
			VAR __XAxisLine = "<line x1='" & __PadL & "' y1='" & __LineBottom & "' x2='" & ( __ChartW - __PadR ) & "' y2='" & __LineBottom & "' stroke='" & __GridColor & "' stroke-width='1'/>"
			
			// =====================================================================================
			// SECTION 8 — LINE CHART (dots now per-year decade colored)
			// =====================================================================================
			VAR __LinePoints =
			    CONCATENATEX (
			        __PointsTable,
			        ROUND ( [PX], 1 ) & "," & ROUND ( [PY], 1 ),
			        " L ",
			        sets[year_release], ASC
			    )
			
			VAR __FirstPX = MINX ( __PointsTable, [PX] )
			VAR __LastPX  = MAXX ( __PointsTable, [PX] )
			
			VAR __AreaMaskAttr = IF ( __HasSelection, "", " mask='url(#" & __MaskId & ")'" )
			
			VAR __AreaFill =
			    "<path d='M " & ROUND ( __FirstPX, 1 ) & "," & __LineBottom &
			    " L " & __LinePoints &
			    " L " & ROUND ( __LastPX, 1 ) & "," & __LineBottom &
			    " Z' fill='url(#" & __AreaGradId & ")'" & __AreaMaskAttr & " stroke='none'/>"
			
			VAR __SolidLine =
			    "<path d='M " & __LinePoints & "' fill='none' stroke='" & __ActiveColor &
			    "' stroke-width='" & __LineWidth & "' stroke-linejoin='round' stroke-linecap='round'/>"
			
			VAR __DecadeColoredSegs =
			    CONCATENATEX (
			        __PointsTable,
			        VAR __CurYear  = sets[year_release]
			        VAR __NextYear = __CurYear + 1
			        VAR __NextRow  = FILTER ( __PointsTable, sets[year_release] = __NextYear )
			        VAR __NextPX   = MAXX ( __NextRow, [PX] )
			        VAR __NextPY   = MAXX ( __NextRow, [PY] )
			        VAR __CurDec   = [DecadeStart]
			        VAR __DecCol =
			            MAXX ( FILTER ( __Decades, [@DecStart] = __CurDec ), decade_theme_highlights[AccentColor] )
			        VAR __SegColor = IF ( ISBLANK ( __DecCol ), __ActiveColor, __DecCol )
			        RETURN
			            IF (
			                NOT ISBLANK ( __NextPX ),
			                "<line x1='" & ROUND ( [PX], 1 ) & "' y1='" & ROUND ( [PY], 1 ) &
			                "' x2='" & ROUND ( __NextPX, 1 ) & "' y2='" & ROUND ( __NextPY, 1 ) &
			                "' stroke='" & __SegColor & "' stroke-width='" & __LineWidth &
			                "' stroke-linecap='round'/>",
			                ""
			            ),
			        "",
			        sets[year_release], ASC
			    )
			
			VAR __ChartLine = IF ( __ColorLineByDecade, __DecadeColoredSegs, __SolidLine )
			
			// Per-year decade-colored dots
			VAR __RegularDots =
			    CONCATENATEX (
			        FILTER ( __PointsTable, [EventText] = BLANK () ),
			        VAR __CurDec = [DecadeStart]
			        VAR __DecCol =
			            MAXX ( FILTER ( __Decades, [@DecStart] = __CurDec ), decade_theme_highlights[AccentColor] )
			        VAR __ThisDotColor =
			            IF ( __MatchDotsToDecade,
			                 IF ( ISBLANK ( __DecCol ), __ActiveColor, __DecCol ),
			                 __DefaultDotColor )
			        RETURN
			            "<circle cx='" & ROUND ( [PX], 1 ) & "' cy='" & ROUND ( [PY], 1 ) &
			            "' r='" & __DotRadius & "' fill='" & __ThisDotColor & "'/>",
			        "",
			        sets[year_release], ASC
			    )
			
			// =====================================================================================
			// SECTION 9 — MILESTONES (rings per-year, year label black)
			// =====================================================================================
			VAR __MilestoneItems =
			    CONCATENATEX (
			        FILTER ( __PointsTable, [EventText] <> BLANK () ),
			        VAR imgY = __LineTop + __MilestoneImageTopOffset + [MIYOff]
			        VAR capY = imgY + __MilestoneCaptionGap + [MCYOff]
			        VAR xOff = [PX] + [MXOff]
			        VAR __CurDec = [DecadeStart]
			        VAR __DecCol =
			            MAXX ( FILTER ( __Decades, [@DecStart] = __CurDec ), decade_theme_highlights[AccentColor] )
			        VAR __RingColor =
			            IF ( __MatchDotsToDecade,
			                 IF ( ISBLANK ( __DecCol ), __ActiveColor, __DecCol ),
			                 __DefaultDotColor )
			        VAR Words = SUBSTITUTE ( TRIM ( [EventText] ), " ", "|" )
			        VAR WordCount = PATHLENGTH ( Words )
			        VAR LineCount = ROUNDUP ( WordCount / __WordsPerLine, 0 )
			        VAR EventTspans =
			            CONCATENATEX (
			                GENERATESERIES ( 1, LineCount ),
			                VAR LineNum = [Value]
			                VAR StartWord = ( LineNum - 1 ) * __WordsPerLine + 1
			                VAR EndWord = MIN ( LineNum * __WordsPerLine, WordCount )
			                VAR LineText =
			                    CONCATENATEX (
			                        GENERATESERIES ( StartWord, EndWord ),
			                        PATHITEM ( Words, [Value] ),
			                        " ",
			                        [Value], ASC
			                    )
			                RETURN
			                    "<tspan x='" & ROUND ( xOff, 1 ) & "' dy='" & IF ( LineNum = 1, 0, __CaptionLineHeight ) & "'>" & LineText & "</tspan>",
			                "",
			                [Value], ASC
			            )
			        RETURN
			            "<line x1='" & ROUND ( xOff, 1 ) & "' y1='" & ROUND ( capY + __MilestoneConnectorGap, 1 ) &
			            "' x2='" & ROUND ( [PX], 1 ) & "' y2='" & ROUND ( [PY], 1 ) &
			            "' stroke='" & __ConnectorColor & "' stroke-width='1.2' stroke-dasharray='3,3'/>" &
			            "<circle cx='" & ROUND ( [PX], 1 ) & "' cy='" & ROUND ( [PY], 1 ) &
			            "' r='" & __MilestoneDotRadius & "' fill='white' stroke='" & __RingColor &
			            "' stroke-width='2.5' class='" & __PulseCls & "'/>" &
			            "<circle cx='" & ROUND ( [PX], 1 ) & "' cy='" & ROUND ( [PY], 1 ) &
			            "' r='" & __DotRadius & "' fill='" & __RingColor & "'/>" &
			            "<image href='" & [ImageUrl] & "' x='" & ROUND ( xOff - __MilestoneImageSize / 2, 1 ) &
			            "' y='" & ROUND ( imgY, 1 ) & "' width='" & __MilestoneImageSize &
			            "' height='" & __MilestoneImageSize & "'/>" &
			            "<text x='" & ROUND ( xOff, 1 ) & "' y='" & ROUND ( imgY + __MilestoneCaptionGap, 1 ) &
			            "' text-anchor='middle' font-size='" & __FontSizeCaption &
			            "' fill='" & __CaptionTextColor & "'>" & EventTspans & "</text>" &
			            "<text x='" & ROUND ( [PX], 1 ) & "' y='" & ROUND ( [PY] + __YearLabelOffsetY, 1 ) &
			            "' text-anchor='middle' font-size='" & __FontSizeYearLabel &
			            "' font-weight='bold' fill='" & __YearLabelColor & "'>" &
			                "<tspan x='" & ROUND ( [PX], 1 ) & "' dy='0'>" & sets[year_release] & "</tspan>" &
			                "<tspan x='" & ROUND ( [PX], 1 ) & "' dy='" & __YearLabelLineHeight & "'>" & [SetCount] & " sets</tspan>" &
			            "</text>",
			        "",
			        sets[year_release], ASC
			    )
			
			// =====================================================================================
			// SECTION 10 — TOOLTIP (color per hovered point, driven by JS)
			// =====================================================================================
			VAR __PointsJS =
			    "[" &
			    CONCATENATEX (
			        __PointsTable,
			        VAR SafeEv = SUBSTITUTE ( SUBSTITUTE ( COALESCE ( [EventText], "" ), "'", "" ), Q, "" )
			        VAR __CurDec = [DecadeStart]
			        VAR __DecCol =
			            MAXX ( FILTER ( __Decades, [@DecStart] = __CurDec ), decade_theme_highlights[AccentColor] )
			        VAR __ThisColor = IF ( ISBLANK ( __DecCol ), __TooltipDefaultColor, __DecCol )
			        RETURN
			            "{x:" & ROUND ( [PX], 1 ) & ",y:" & ROUND ( [PY], 1 ) &
			            ",year:" & sets[year_release] & ",val:" & [SetCount] &
			            ",ev:'" & SafeEv & "',c:'" & __ThisColor & "'}",
			        ",",
			        sets[year_release], ASC
			    ) & "]"
			
			VAR __TooltipDiv =
			    "<div id='" & __TTId & "' style='" &
			        "position:fixed;display:none;" &
			        "background:" & __TTBgColor & ";" &
			        "border:" & __TTBorderWidth & "px solid " & __TooltipDefaultColor & ";" &
			        "border-radius:" & __TTRadius & "px;" &
			        "box-shadow:" & __TTShadow & ";" &
			        "font-family:" & __TTFontFamily & ";" &
			        "color:" & __TTLabelColor & ";" &
			        "pointer-events:none;z-index:9999;" &
			        "min-width:" & __TTMinWidth & "px;" &
			        "overflow:hidden;" &
			    "'>" &
			        "<div id='" & __TTAccentId & "' style='height:" & __TTAccentBarHeight & "px;background:" & __TooltipDefaultColor & ";'></div>" &
			        "<div style='padding:" & __TTPaddingY & "px " & __TTPaddingX & "px;'>" &
			            "<div id='" & __TTYearId & "' style='" &
			                "font-weight:700;font-size:" & __TTFontSizeYear & "px;" &
			                "color:" & __TooltipDefaultColor & ";" &
			                "margin-bottom:8px;letter-spacing:0.3px;" &
			            "'></div>" &
			            "<div style='display:flex;align-items:center;justify-content:space-between;font-size:" & __TTFontSizeRow & "px;'>" &
			                "<span style='display:flex;align-items:center;'>" &
			                    "<span id='" & __TTLegendId & "' style='width:" & __TTLegendDotSize & "px;height:" & __TTLegendDotSize & "px;border-radius:50%;background:" & __TooltipDefaultColor & ";display:inline-block;margin-right:8px;'></span>" &
			                    "Sets Released" &
			                "</span>" &
			                "<span id='" & __TTValueId & "' style='font-weight:700;font-size:" & __TTFontSizeValue & "px;margin-left:20px;color:" & __TooltipDefaultColor & ";'></span>" &
			            "</div>" &
			            "<div id='" & __TTEventId & "' style='" &
			                "margin-top:10px;padding-top:10px;" &
			                "border-top:1px solid #EDEDED;" &
			                "font-size:" & __TTFontSizeEvent & "px;color:" & __TTEventColor & ";" &
			                "max-width:260px;line-height:1.4;" &
			            "'></div>" &
			        "</div>" &
			    "</div>"
			
			VAR __TooltipScript =
			    "<script>(function(){" &
			    "var pts=" & __PointsJS & ";" &
			    "var TT=" & Q & __TTId & Q & ",TA=" & Q & __TTAccentId & Q & ",TY=" & Q & __TTYearId & Q & ",TL=" & Q & __TTLegendId & Q & ",TV=" & Q & __TTValueId & Q & ",TE=" & Q & __TTEventId & Q & ",SV=" & Q & __SvgId & Q & ",CL=" & Q & __ChLineId & Q & ",CD=" & Q & __ChDotId & Q & ";" &
			    "function show(e,p){" &
			        "var t=document.getElementById(TT);" &
			        "t.style.borderColor=p.c;" &
			        "document.getElementById(TA).style.background=p.c;" &
			        "var yn=document.getElementById(TY);yn.innerText=p.year;yn.style.color=p.c;" &
			        "document.getElementById(TL).style.background=p.c;" &
			        "var vn=document.getElementById(TV);vn.innerText=p.val;vn.style.color=p.c;" &
			        "var v=document.getElementById(TE);if(p.ev&&p.ev.length>0){v.innerText=p.ev;v.style.display='block';}else{v.innerText='';v.style.display='none';}" &
			        "t.style.display='block';t.style.left=(e.clientX+16)+'px';t.style.top=(e.clientY+16)+'px';" &
			        "var l=document.getElementById(CL);if(l)l.style.stroke=p.c;" &
			        "var d=document.getElementById(CD);if(d)d.style.fill=p.c;" &
			    "}" &
			    "function hide(){document.getElementById(TT).style.display='none';var l=document.getElementById(CL);var d=document.getElementById(CD);if(l)l.style.display='none';if(d)d.style.display='none';}" &
			    "function mv(e){var s=document.getElementById(SV);var r=s.getBoundingClientRect();var vb=s.viewBox.baseVal;var sx=vb.width/r.width;var mx=(e.clientX-r.left)*sx+vb.x;var n=pts[0];var md=Math.abs(pts[0].x-mx);for(var i=1;i<pts.length;i++){var dd=Math.abs(pts[i].x-mx);if(dd<md){md=dd;n=pts[i];}}var l=document.getElementById(CL);var d=document.getElementById(CD);if(l){l.setAttribute('x1',n.x);l.setAttribute('x2',n.x);l.style.display='block';}if(d){d.setAttribute('cx',n.x);d.setAttribute('cy',n.y);d.style.display='block';}show(e,n);}" &
			    "var s=document.getElementById(SV);if(s){s.addEventListener('mousemove',mv);s.addEventListener('mouseleave',hide);}" &
			    "})();</script>"
			
			// =====================================================================================
			// SECTION 11 — FINAL ASSEMBLY
			// =====================================================================================
			VAR __SVG =
			    "<svg id='" & __SvgId & "' viewBox='0 " & __TopCrop & " " & __ChartW & " " & ( __ChartH - __TopCrop ) &
			    "' xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' " &
			    "style='width:100%;height:auto;display:block;font-family:" & __FontFamily & ";'>" &
			    __Defs & __Styles &
			    __BoundaryLines &
			    __YAxisTicks &
			    __AreaFill &
			    __ChartLine &
			    __YAxisLine & __XAxisLine &
			    __XAxisTitleText & __YAxisTitleText &
			    __RegularDots &
			    __MilestoneItems &
			    __ThemeSegments & __ThemeDots & __ThemeImages & __ThemeLabels & __DecadeLabels &
			    "<line id='" & __ChLineId & "' x1='0' y1='" & __LineTop & "' x2='0' y2='" & __LineBottom &
			    "' stroke='" & __TooltipDefaultColor & "' stroke-width='1' stroke-dasharray='3,3' stroke-opacity='0.6' style='display:none;pointer-events:none;'/>" &
			    "<circle id='" & __ChDotId & "' cx='0' cy='0' r='6' fill='" & __TooltipDefaultColor &
			    "' stroke='white' stroke-width='2' style='display:none;pointer-events:none;'/>" &
			    "</svg>"
			
			RETURN
			    "<div style='position:relative;width:100%;'>" &
			    __TooltipDiv & __SVG & __TooltipScript &
			    "</div>"
		displayFolder: Page 1 History
		lineageTag: ede2da87-d23f-466b-9cbd-75026c810edb

	measure 'HTML Total Parts Barchart' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _SvgWidth              = 700
			VAR _ChartHeight           = 320
			VAR _TopPadding            = 10
			VAR _BottomPadding         = 10
			
			-- Left/right reserved space
			VAR _CategoryLabelWidth    = 70          -- room on the left for category names
			VAR _ValueLabelWidth       = 175          -- room on the right for "1,234 (12.3%)"
			VAR _CategoryBarGap        = 10           -- gap between category label and bar start
			VAR _BarValueGap           = 10           -- gap between bar end and value label
			
			-- Bar styling
			VAR _BarGap                = 15           -- vertical gap between adjacent bars
			VAR _BarCornerRadius       = 10
			
			-- Typography
			VAR _FontFamily            = "Poppins, Segoe UI"
			VAR _CategoryFontSize      = 15
			VAR _ValueLabelFontSize    = 15
			VAR _CategoryLabelColor    = "#333333"
			VAR _ValueLabelColor       = "#333333"
			
			-- Animation
			VAR _AnimDuration          = 0.7          -- seconds per bar grow
			VAR _AnimStagger           = 0.1          -- seconds delay between bars
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _NumBars       = 5
			VAR _SvgHeight     = _TopPadding + _ChartHeight + _BottomPadding
			VAR _BarSlot       = DIVIDE ( _ChartHeight, _NumBars )
			VAR _BarHeight     = _BarSlot - _BarGap
			VAR _BarStartX     = _CategoryLabelWidth + _CategoryBarGap
			VAR _MaxBarWidth   = _SvgWidth - _BarStartX - _ValueLabelWidth
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _TotalSets   = CALCULATE ( COUNTROWS ( sets ) )
			VAR _CountMicro  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Micro" )
			VAR _CountSmall  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Small" )
			VAR _CountMedium = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Medium" )
			VAR _CountLarge  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Large" )
			VAR _CountMega   = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Mega" )
			
			VAR _MaxCount =
			    MAX ( _CountMicro, MAX ( _CountSmall, MAX ( _CountMedium, MAX ( _CountLarge, _CountMega ) ) ) )
			
			-- ============================================
			-- === BARS (staggered grow-right animation) ==
			-- ============================================
			
			VAR _Bar1 =
			    VAR Y = _TopPadding + 0 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMicro, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMicro, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMicro, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 0 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Micro</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorMicro & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>None: " & FORMAT ( _CountMicro, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar2 =
			    VAR Y = _TopPadding + 1 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountSmall, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountSmall, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountSmall, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 1 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Small</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorSmall & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Solo: " & FORMAT ( _CountSmall, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar3 =
			    VAR Y = _TopPadding + 2 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMedium, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMedium, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMedium, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 2 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Medium</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorMedium & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Small Crew: " & FORMAT ( _CountMedium, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar4 =
			    VAR Y = _TopPadding + 3 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountLarge, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountLarge, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountLarge, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 3 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Large</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorLarge & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Squad: " & FORMAT ( _CountLarge, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar5 =
			    VAR Y = _TopPadding + 4 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMega, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMega, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMega, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 4 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Mega</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorMega & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Large Cast: " & FORMAT ( _CountMega, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bars = _Bar1 & _Bar2 & _Bar3 & _Bar4 & _Bar5
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    "<div style='width:100%;height:100%;overflow:hidden;'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    "<g>" & _Bars & "</g>" &
			    "</svg>" &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 6f9d2060-fa63-4720-b25b-4ceb6e2c1e2c

	measure 'HTML Total Parts Boxplot Grouping' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 320
			VAR _MarginLeft         = 90
			VAR _MarginRight        = 25
			VAR _MarginTop          = 15
			VAR _MarginBottom       = 30
			
			-- Box styling
			VAR _BoxHeight          = 32
			VAR _WhiskerCapHeight   = 14
			VAR _MedianLineWidth    = 3
			VAR _OutlierRadius      = 3
			VAR _OutlierOpacity     = 0.55
			VAR _BoxStrokeWidth     = 1.5
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 16
			VAR _YAxisFontSize      = 18
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _AnimDuration       = 0.6
			VAR _AnimStagger        = 0.12
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT ========================
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			VAR _SvgHeight  = _ChartHeight
			
			-- ============================================
			-- === TIER DEFINITIONS =======================
			-- ============================================
			
			VAR _Tiers =
			    DATATABLE (
			        "tier_name", STRING,
			        "tier_color", STRING,
			        "row_order", INTEGER,
			        {
			            { "Micro",  "#2ECC71", 1 },
			            { "Small",  "#2a78d6", 2 },
			            { "Medium", "#F4B400", 3 },
			            { "Large",  "#ab6643", 4 },
			            { "Mega",   "#E53935", 5 }
			        }
			    )
			
			VAR _TierCount = COUNTROWS ( _Tiers )
			VAR _RowSlot = DIVIDE ( _PlotHeight, _TierCount )
			
			-- ============================================
			-- === X-AXIS RANGE (with safety guards) =====
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxPartsRaw = CALCULATE ( MAX ( sets[number_of_parts] ), ALL ( sets ), sets[number_of_parts] > 0 )
			VAR _MaxParts = IF ( ISBLANK ( _MaxPartsRaw ) || _MaxPartsRaw <= 1, 10, _MaxPartsRaw )
			VAR _LogMin = LOG10 ( _MinParts )
			VAR _LogMax = LOG10 ( _MaxParts )
			
			-- ============================================
			-- === PER-TIER FIVE-NUMBER SUMMARY ===========
			-- ============================================
			
			VAR _TierStats =
			    ADDCOLUMNS (
			        _Tiers,
			        "@min",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MIN ( sets[number_of_parts] ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@q1",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.25 ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@median",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.50 ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@q3",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.75 ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@max",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MAX ( sets[number_of_parts] ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@count",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( COUNTROWS ( sets ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 )
			    )
			
			-- Drop tiers with no data or incomplete stats -- prevents LOG10(BLANK)
			VAR _TierStatsNonEmpty =
			    FILTER (
			        _TierStats,
			        NOT ISBLANK ( [@count] ) && [@count] > 0
			            && NOT ISBLANK ( [@q1] ) && [@q1] > 0
			            && NOT ISBLANK ( [@q3] ) && [@q3] > 0
			            && NOT ISBLANK ( [@median] ) && [@median] > 0
			    )
			
			VAR _TierStatsWithFences =
			    ADDCOLUMNS (
			        _TierStatsNonEmpty,
			        "@iqr", [@q3] - [@q1],
			        "@lowerFence", MAX ( 1, [@q1] - 1.5 * ( [@q3] - [@q1] ) ),
			        "@upperFence", [@q3] + 1.5 * ( [@q3] - [@q1] )
			    )
			
			VAR _TierStatsFinal =
			    ADDCOLUMNS (
			        _TierStatsWithFences,
			        "@whiskerLo",
			            VAR CurTier = [tier_name]
			            VAR L = [@lowerFence]
			            VAR Result =
			                CALCULATE (
			                    MIN ( sets[number_of_parts] ),
			                    sets[complexity_tier] = CurTier,
			                    sets[number_of_parts] >= L
			                )
			            RETURN IF ( ISBLANK ( Result ) || Result <= 0, [@q1], Result ),
			        "@whiskerHi",
			            VAR CurTier = [tier_name]
			            VAR U = [@upperFence]
			            VAR Result =
			                CALCULATE (
			                    MAX ( sets[number_of_parts] ),
			                    sets[complexity_tier] = CurTier,
			                    sets[number_of_parts] <= U
			                )
			            RETURN IF ( ISBLANK ( Result ) || Result <= 0, [@q3], Result )
			    )
			
			-- ============================================
			-- === BOXES + WHISKERS =======================
			-- ============================================
			
			VAR _Boxes =
			    CONCATENATEX (
			        _TierStatsFinal,
			        VAR TierName = [tier_name]
			        VAR TierColor = [tier_color]
			        VAR RowIdx = [row_order]
			        VAR RowCenterY = _MarginTop + ( RowIdx - 0.5 ) * _RowSlot
			        VAR BoxTop = RowCenterY - _BoxHeight / 2
			        VAR Delay = ( RowIdx - 1 ) * _AnimStagger
			
			        VAR MinV = [@min]
			        VAR Q1V  = [@q1]
			        VAR MedV = [@median]
			        VAR Q3V  = [@q3]
			        VAR MaxV = [@max]
			        VAR WLo  = [@whiskerLo]
			        VAR WHi  = [@whiskerHi]
			        VAR N    = [@count]
			
			        VAR Q1X =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( Q1V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( Q1V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			        VAR Q3X =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( Q3V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( Q3V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			        VAR MedX =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( MedV, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( MedV - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			        VAR WLoX =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( WLo, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( WLo - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			        VAR WHiX =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( WHi, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( WHi - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			
			        VAR CapTop = RowCenterY - _WhiskerCapHeight / 2
			        VAR CapBot = RowCenterY + _WhiskerCapHeight / 2
			        VAR BoxWidth = MAX ( Q3X - Q1X, 1 )
			
			        VAR DataAttrs =
			            " data-tier='" & TierName & "'" &
			            " data-min='" & FORMAT ( MinV, "#,0" ) & "'" &
			            " data-q1='" & FORMAT ( Q1V, "#,0" ) & "'" &
			            " data-median='" & FORMAT ( MedV, "#,0" ) & "'" &
			            " data-q3='" & FORMAT ( Q3V, "#,0" ) & "'" &
			            " data-max='" & FORMAT ( MaxV, "#,0" ) & "'" &
			            " data-count='" & FORMAT ( N, "#,0" ) & "'" &
			            " data-color='" & TierColor & "'"
			
			        RETURN
			            "<line class='bp-anim' x1='" & WLoX & "' y1='" & RowCenterY & "' x2='" & Q1X & "' y2='" & RowCenterY &
			            "' stroke='" & TierColor & "' stroke-width='" & _BoxStrokeWidth & "' style='animation-delay:" & Delay & "s;' />" &
			            "<line class='bp-anim' x1='" & Q3X & "' y1='" & RowCenterY & "' x2='" & WHiX & "' y2='" & RowCenterY &
			            "' stroke='" & TierColor & "' stroke-width='" & _BoxStrokeWidth & "' style='animation-delay:" & Delay & "s;' />" &
			            "<line class='bp-anim' x1='" & WLoX & "' y1='" & CapTop & "' x2='" & WLoX & "' y2='" & CapBot &
			            "' stroke='" & TierColor & "' stroke-width='" & _BoxStrokeWidth & "' style='animation-delay:" & Delay & "s;' />" &
			            "<line class='bp-anim' x1='" & WHiX & "' y1='" & CapTop & "' x2='" & WHiX & "' y2='" & CapBot &
			            "' stroke='" & TierColor & "' stroke-width='" & _BoxStrokeWidth & "' style='animation-delay:" & Delay & "s;' />" &
			            "<rect class='bp-box' x='" & Q1X & "' y='" & BoxTop & "' width='" & BoxWidth & "' height='" & _BoxHeight &
			            "' fill='" & TierColor & "' fill-opacity='0.35' stroke='" & TierColor & "' stroke-width='" & _BoxStrokeWidth &
			            "' style='animation-delay:" & Delay & "s;'" & DataAttrs & " />" &
			            "<line class='bp-anim' x1='" & MedX & "' y1='" & BoxTop & "' x2='" & MedX & "' y2='" & ( BoxTop + _BoxHeight ) &
			            "' stroke='" & TierColor & "' stroke-width='" & _MedianLineWidth & "' style='animation-delay:" & Delay & "s;' />",
			        "",
			        [row_order], ASC
			    )
			
			-- ============================================
			-- === OUTLIER DOTS ===========================
			-- ============================================
			
			VAR _OutlierRows =
			    GENERATE (
			        _TierStatsFinal,
			        VAR TierName = [tier_name]
			        VAR TierColor = [tier_color]
			        VAR RowIdx = [row_order]
			        VAR LFence = [@lowerFence]
			        VAR UFence = [@upperFence]
			        RETURN
			            ADDCOLUMNS (
			                CALCULATETABLE (
			                    SUMMARIZE ( sets, sets[number_of_parts] ),
			                    sets[complexity_tier] = TierName,
			                    sets[number_of_parts] > 0,
			                    OR ( sets[number_of_parts] < LFence, sets[number_of_parts] > UFence )
			                ),
			                "@rowIdx", RowIdx,
			                "@tierColor", TierColor
			            )
			    )
			
			VAR _Outliers =
			    CONCATENATEX (
			        _OutlierRows,
			        VAR V = sets[number_of_parts]
			        VAR RowIdx = [@rowIdx]
			        VAR RowCenterY = _MarginTop + ( RowIdx - 0.5 ) * _RowSlot
			        VAR CX =
			            IF (
			                _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth
			            )
			        VAR Delay = ( RowIdx - 1 ) * _AnimStagger + 0.15
			        RETURN
			            IF (
			                V > 0,
			                "<circle class='bp-outlier' cx='" & CX & "' cy='" & RowCenterY & "' r='" & _OutlierRadius &
			                "' fill='" & [@tierColor] & "' fill-opacity='" & _OutlierOpacity &
			                "' style='animation-delay:" & Delay & "s;'><title>" & FORMAT ( V, "#,0" ) & " parts</title></circle>",
			                ""
			            ),
			        ""
			    )
			
			-- ============================================
			-- === Y-AXIS (tier name labels) ==============
			-- ============================================
			
			VAR _YAxisElements =
			    CONCATENATEX (
			        _TierStatsFinal,
			        VAR RowIdx = [row_order]
			        VAR RowCenterY = _MarginTop + ( RowIdx - 0.5 ) * _RowSlot
			        RETURN
			            "<text x='" & ( _MarginLeft - 12 ) & "' y='" & ( RowCenterY + 6 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' font-weight='600' fill='" & _AxisTextColor & "'>" &
			            [tier_name] & "</text>",
			        "",
			        [row_order], ASC
			    )
			
			-- ============================================
			-- === X-AXIS (powers of 10) ==================
			-- ============================================
			
			VAR _MinPowerOf10 = CEILING ( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR ( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, _PowerCount - 1, 1 ),
			        "@partsVal", POWER ( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX (
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR XPos = _MarginLeft + DIVIDE ( LOG10 ( PartsVal ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT ( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & YBottom &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<line x1='" & XPos & "' y1='" & YBottom & "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes bpFade{from{opacity:0;transform:scaleX(0.85);transform-origin:left}to{opacity:1;transform:scaleX(1)}}
			@keyframes bpDot{from{opacity:0}to{opacity:" & _OutlierOpacity & "}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.bp-anim { opacity:0; animation:bpFade 0.6s ease-out both; }
			.bp-box { cursor:pointer; opacity:0; animation:bpFade 0.6s ease-out both; transition:fill-opacity 0.15s ease; }
			.bp-box:hover { fill-opacity:0.6; }
			.bp-outlier { opacity:0; animation:bpDot 0.4s ease-out both; }
			#custom-tooltip {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip .tt-title { font-weight:700; margin-bottom:6px; font-size:18px; display:flex; align-items:center; }
			#custom-tooltip .tt-swatch { display:inline-block; width:12px; height:12px; border-radius:2px; margin-right:8px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:14px; margin:2px 0; }
			#custom-tooltip .tt-label { color:#666; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-count { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var boxes = document.querySelectorAll('.bp-box');
			
			    boxes.forEach(function(box){
			        box.addEventListener('mouseenter', function(e){
			            var d = box.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-title" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + d.color + '" & UNICHAR(34) & "></span>' + d.tier + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Max</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.max + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q3 (75%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q3 + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Median</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.median + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q1 (25%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q1 + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Min</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.min + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-count" & UNICHAR(34) & "><span>Sets</span><span>' + d.count + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			        });
			
			        box.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH - 15;
			            if (top < 5) top = y + 15;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        box.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    _TooltipStyle &
			    "<div class='chart-container'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    _XAxisElements &
			    _XAxisBaseline &
			    _YAxisElements &
			    "<g>" & _Boxes & "</g>" &
			    "<g>" & _Outliers & "</g>" &
			    "</svg>" &
			    _TooltipHTML &
			    "</div>" &
			    _TooltipScript
			
			RETURN _HTML
		lineageTag: f67ce839-5b11-4196-9d5b-5613e2bbd386

	measure 'HTML Total Parts Boxplot' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 340
			VAR _MarginLeft         = 25
			VAR _MarginRight        = 25
			VAR _MarginTop          = 40            -- extra room for tier region labels at top
			VAR _MarginBottom       = 30
			
			-- Box styling
			VAR _BoxHeight          = 70
			VAR _WhiskerCapHeight   = 30
			VAR _MedianLineWidth    = 3
			VAR _BoxStrokeWidth     = 1.5
			VAR _BoxFillColor       = "#FFFFFF"
			VAR _BoxStrokeColor     = "#333333"
			VAR _WhiskerColor       = "#333333"
			VAR _MedianColor        = "#111111"
			VAR _BoxFillOpacity     = 0.55
			
			-- Dot styling
			VAR _DotRadius          = 6
			VAR _DotOpacity         = 0.7
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 0.2
			
			-- Tier divider styling
			VAR _DividerColor       = "#B0B0B0"
			VAR _DividerWidth       = 2
			VAR _DividerDash        = "3,3"
			VAR _TierLabelFontSize  = 20
			VAR _TierLabelColor     = "#555555"
			VAR _TierLabelY         = 20            -- Y position of tier region labels (above plot)
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 16
			VAR _LegendFontSize     = 15
			VAR _LegendSwatchSize   = 12
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _BoxAnimDur         = 0.6
			VAR _DotAnimDur         = 0.4
			VAR _DotAnimDelay       = 0.4
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT ========================
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			VAR _SvgHeight  = _ChartHeight
			VAR _CenterY    = _MarginTop + _PlotHeight / 2
			
			-- ============================================
			-- === X-AXIS RANGE ===========================
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxPartsRaw = CALCULATE ( MAX ( sets[number_of_parts] ), ALL ( sets ), sets[number_of_parts] > 0 )
			VAR _MaxParts = IF ( ISBLANK ( _MaxPartsRaw ) || _MaxPartsRaw <= 1, 10, _MaxPartsRaw )
			VAR _LogMin = LOG10 ( _MinParts )
			VAR _LogMax = LOG10 ( _MaxParts )
			
			-- ============================================
			-- === OVERALL FIVE-NUMBER SUMMARY ============
			-- ============================================
			
			VAR _AllMin    = CALCULATE ( MIN ( sets[number_of_parts] ), sets[number_of_parts] > 0 )
			VAR _AllQ1     = CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.25 ), sets[number_of_parts] > 0 )
			VAR _AllMedian = CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.50 ), sets[number_of_parts] > 0 )
			VAR _AllQ3     = CALCULATE ( PERCENTILE.INC ( sets[number_of_parts], 0.75 ), sets[number_of_parts] > 0 )
			VAR _AllMax    = CALCULATE ( MAX ( sets[number_of_parts] ), sets[number_of_parts] > 0 )
			VAR _AllCount  = CALCULATE ( COUNTROWS ( sets ), sets[number_of_parts] > 0 )
			
			VAR _IQR = _AllQ3 - _AllQ1
			VAR _LowerFence = MAX ( 1, _AllQ1 - 1.5 * _IQR )
			VAR _UpperFence = _AllQ3 + 1.5 * _IQR
			
			VAR _WhiskerLoRaw =
			    CALCULATE ( MIN ( sets[number_of_parts] ), sets[number_of_parts] >= _LowerFence, sets[number_of_parts] > 0 )
			VAR _WhiskerHiRaw =
			    CALCULATE ( MAX ( sets[number_of_parts] ), sets[number_of_parts] <= _UpperFence, sets[number_of_parts] > 0 )
			VAR _WLo = IF ( ISBLANK ( _WhiskerLoRaw ) || _WhiskerLoRaw <= 0, _AllQ1, _WhiskerLoRaw )
			VAR _WHi = IF ( ISBLANK ( _WhiskerHiRaw ) || _WhiskerHiRaw <= 0, _AllQ3, _WhiskerHiRaw )
			
			-- ============================================
			-- === TIER BOUNDARIES (from data) ============
			-- ============================================
			-- MIN(parts) per tier gives the starting boundary of each tier region.
			-- Tier order = Micro (start=1) < Small < Medium < Large < Mega.
			
			VAR _TierBoundaries =
			    ADDCOLUMNS (
			        DATATABLE (
			            "tier_name", STRING,
			            "tier_color", STRING,
			            "tier_order", INTEGER,
			            {
			                { "Micro",  "#2ECC71", 1 },
			                { "Small",  "#2a78d6", 2 },
			                { "Medium", "#F4B400", 3 },
			                { "Large",  "#ab6643", 4 },
			                { "Mega",   "#E53935", 5 }
			            }
			        ),
			        "@minParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MIN ( sets[number_of_parts] ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 ),
			        "@maxParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MAX ( sets[number_of_parts] ), sets[complexity_tier] = CurTier, sets[number_of_parts] > 0 )
			    )
			
			VAR _TierBoundariesValid =
			    FILTER ( _TierBoundaries, NOT ISBLANK ( [@minParts] ) && [@minParts] > 0 )
			
			-- ============================================
			-- === X-COORDINATE HELPERS ===================
			-- ============================================
			
			VAR _Q1X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ1, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ1 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _Q3X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ3, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ3 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _MedX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllMedian, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllMedian - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WLoX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WLo, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WLo - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WHiX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WHi, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WHi - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			
			VAR _BoxTop = _CenterY - _BoxHeight / 2
			VAR _BoxBot = _CenterY + _BoxHeight / 2
			VAR _CapTop = _CenterY - _WhiskerCapHeight / 2
			VAR _CapBot = _CenterY + _WhiskerCapHeight / 2
			
			-- ============================================
			-- === TIER DIVIDERS + REGION LABELS ==========
			-- ============================================
			-- One dashed vertical line at the START of each tier (except the first).
			-- Each tier gets a name label centered between its start and its end
			-- (start of the next tier, or the plot right edge for the last tier).
			
			VAR _TierDividers =
			    CONCATENATEX (
			        FILTER ( _TierBoundariesValid, [tier_order] > 1 ),   -- skip Micro's start (that's the plot edge)
			        VAR StartVal = [@minParts]
			        VAR XPos =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & ( _MarginTop + _PlotHeight ) &
			            "' stroke='" & _DividerColor & "' stroke-width='" & _DividerWidth &
			            "' stroke-dasharray='" & _DividerDash & "' />",
			        "",
			        [tier_order], ASC
			    )
			
			VAR _MaxTierOrder = MAXX ( _TierBoundariesValid, [tier_order] )
			
			VAR _TierLabels =
			    CONCATENATEX (
			        _TierBoundariesValid,
			        VAR CurOrder = [tier_order]
			        VAR CurColor = [tier_color]
			        VAR CurName = [tier_name]
			        VAR StartVal = [@minParts]
			        VAR EndVal =
			            VAR NextStart =
			                MINX (
			                    FILTER ( _TierBoundariesValid, [tier_order] = CurOrder + 1 ),
			                    [@minParts]
			                )
			            RETURN
			                IF ( ISBLANK ( NextStart ), _MaxParts, NextStart )
			        VAR StartX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR EndX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( EndVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( EndVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR MidX = ( StartX + EndX ) / 2
			        RETURN
			            "<text x='" & MidX & "' y='" & _TierLabelY &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _TierLabelFontSize & "' font-weight='700' fill='" & CurColor & "'>" & CurName & "</text>",
			        "",
			        [tier_order], ASC
			    )
			
			-- ============================================
			-- === BOX + WHISKERS =========================
			-- ============================================
			
			VAR _BoxSVG =
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CenterY & "' x2='" & _Q1X & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _Q3X & "' y1='" & _CenterY & "' x2='" & _WHiX & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CapTop & "' x2='" & _WLoX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WHiX & "' y1='" & _CapTop & "' x2='" & _WHiX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<rect class='bp-box' x='" & _Q1X & "' y='" & _BoxTop & "' width='" & MAX ( _Q3X - _Q1X, 1 ) & "' height='" & _BoxHeight &
			    "' fill='" & _BoxFillColor & "' fill-opacity='" & _BoxFillOpacity &
			    "' stroke='" & _BoxStrokeColor & "' stroke-width='" & _BoxStrokeWidth &
			    "' data-min='" & FORMAT ( _AllMin, "#,0" ) &
			    "' data-q1='" & FORMAT ( _AllQ1, "#,0" ) &
			    "' data-median='" & FORMAT ( _AllMedian, "#,0" ) &
			    "' data-q3='" & FORMAT ( _AllQ3, "#,0" ) &
			    "' data-max='" & FORMAT ( _AllMax, "#,0" ) &
			    "' data-count='" & FORMAT ( _AllCount, "#,0" ) & "' />" &
			    "<line class='bp-anim' x1='" & _MedX & "' y1='" & _BoxTop & "' x2='" & _MedX & "' y2='" & _BoxBot &
			    "' stroke='" & _MedianColor & "' stroke-width='" & _MedianLineWidth & "' />"
			
			-- ============================================
			-- === DOTS ===================================
			-- ============================================
			
			VAR _DotRows =
			    ADDCOLUMNS (
			        FILTER (
			            SUMMARIZE ( sets, sets[number_of_parts], sets[complexity_tier] ),
			            sets[number_of_parts] > 0
			        ),
			        "@tierColor",
			            SWITCH (
			                sets[complexity_tier],
			                "Micro",  _ColorMicro,
			                "Small",  _ColorSmall,
			                "Medium", _ColorMedium,
			                "Large",  _ColorLarge,
			                "Mega",   _ColorMega,
			                "#999999"
			            )
			    )
			
			VAR _Dots =
			    CONCATENATEX (
			        _DotRows,
			        VAR V = sets[number_of_parts]
			        VAR CX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<circle class='bp-dot' cx='" & CX & "' cy='" & _CenterY & "' r='" & _DotRadius &
			            "' fill='" & [@tierColor] & "' fill-opacity='" & _DotOpacity &
			            "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "'/>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS =================================
			-- ============================================
			
			VAR _MinPowerOf10 = CEILING ( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR ( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, _PowerCount - 1, 1 ),
			        "@partsVal", POWER ( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX (
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR XPos = _MarginLeft + DIVIDE ( LOG10 ( PartsVal ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT ( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & YBottom &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<line x1='" & XPos & "' y1='" & YBottom & "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 22 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes bpFade{from{opacity:0}to{opacity:1}}
			@keyframes bpDot{from{opacity:0}to{opacity:" & _DotOpacity & "}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.bp-anim { opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; }
			.bp-box { cursor:pointer; opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; transition:fill-opacity 0.15s ease; }
			.bp-box:hover { fill-opacity:0.85; }
			.bp-dot { opacity:0; animation:bpDot " & _DotAnimDur & "s ease-out " & _DotAnimDelay & "s both; pointer-events:none; }
			#custom-tooltip {
			    position:absolute; display:none;
			    background:" & _TooltipBg & "; border:1px solid " & _TooltipBorder & "; border-radius:6px;
			    padding:10px 12px; font-size:" & _TooltipFontSize & "px; color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & "; pointer-events:none; z-index:1000; white-space:nowrap;
			}
			#custom-tooltip .tt-title { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:2px 0; }
			#custom-tooltip .tt-label { color:#666; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-count { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var box = document.querySelector('.bp-box');
			    if (!box) return;
			
			    box.addEventListener('mouseenter', function(e){
			        var d = box.dataset;
			        var html = '';
			        html += '<div class=" & UNICHAR(34) & "tt-title" & UNICHAR(34) & ">All Sets</div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Max</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.max + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q3 (75%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q3 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Median</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.median + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q1 (25%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q1 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Min</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.min + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row tt-count" & UNICHAR(34) & "><span>Total sets</span><span>' + d.count + '</span></div>';
			        tooltip.innerHTML = html;
			        tooltip.style.display = 'block';
			    });
			
			    box.addEventListener('mousemove', function(e){
			        var rect = container.getBoundingClientRect();
			        var x = e.clientX - rect.left;
			        var y = e.clientY - rect.top;
			        var ttW = tooltip.offsetWidth;
			        var ttH = tooltip.offsetHeight;
			        var left = x + 15;
			        if (left + ttW > rect.width) left = x - ttW - 15;
			        var top = y - ttH - 15;
			        if (top < 5) top = y + 15;
			        if (top + ttH > rect.height) top = rect.height - ttH - 5;
			        tooltip.style.left = left + 'px';
			        tooltip.style.top = top + 'px';
			    });
			
			    box.addEventListener('mouseleave', function(){
			        tooltip.style.display = 'none';
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    _TooltipStyle &
			    "<div class='chart-container'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    _XAxisElements &
			    _TierDividers &
			    _TierLabels &
			    _XAxisBaseline &
			    "<g>" & _Dots & "</g>" &
			    _BoxSVG &
			    "</svg>" &
			    _TooltipHTML &
			    "</div>" &
			    _TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: f9cb2b12-c538-44d2-80f3-59e85063171d

	measure 'HTML Parts Variety Barchart' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _SvgWidth              = 700
			VAR _ChartHeight           = 320
			VAR _TopPadding            = 10
			VAR _BottomPadding         = 10
			
			-- Left/right reserved space
			VAR _CategoryLabelWidth    = 140          -- room on the left for category names
			VAR _ValueLabelWidth       = 175          -- room on the right for "1,234 (12.3%)"
			VAR _CategoryBarGap        = 10           -- gap between category label and bar start
			VAR _BarValueGap           = 10           -- gap between bar end and value label
			
			-- Bar styling
			VAR _BarGap                = 15           -- vertical gap between adjacent bars
			VAR _BarCornerRadius       = 10
			
			-- Typography
			VAR _FontFamily            = "Poppins, Segoe UI"
			VAR _CategoryFontSize      = 15
			VAR _ValueLabelFontSize    = 15
			VAR _CategoryLabelColor    = "#333333"
			VAR _ValueLabelColor       = "#333333"
			
			-- Animation
			VAR _AnimDuration          = 0.7          -- seconds per bar grow
			VAR _AnimStagger           = 0.1          -- seconds delay between bars
			
			-- Tier colors
			VAR _ColorNone              = "#2ECC71"
			VAR _ColorSimpleBuild       = "#2a78d6"
			VAR _ColorMixedBuild        = "#F4B400"
			VAR _ColorVariedBuild       = "#ab6643"
			VAR _ColorComplexAssembly   = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _NumBars       = 5
			VAR _SvgHeight     = _TopPadding + _ChartHeight + _BottomPadding
			VAR _BarSlot       = DIVIDE ( _ChartHeight, _NumBars )
			VAR _BarHeight     = _BarSlot - _BarGap
			VAR _BarStartX     = _CategoryLabelWidth + _CategoryBarGap
			VAR _MaxBarWidth   = _SvgWidth - _BarStartX - _ValueLabelWidth
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _TotalSets   = CALCULATE ( COUNTROWS ( sets ) )
			VAR _CountMicro  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[part_variety_tier] = "None" )
			VAR _CountSmall  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[part_variety_tier] = "Simple Build" )
			VAR _CountMedium = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[part_variety_tier] = "Mixed Build" )
			VAR _CountLarge  = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[part_variety_tier] = "Varied Build" )
			VAR _CountMega   = CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[part_variety_tier] = "Complex Assembly" )
			
			VAR _MaxCount =
			    MAX ( _CountMicro, MAX ( _CountSmall, MAX ( _CountMedium, MAX ( _CountLarge, _CountMega ) ) ) )
			
			-- ============================================
			-- === BARS (staggered grow-right animation) ==
			-- ============================================
			
			VAR _Bar1 =
			    VAR Y = _TopPadding + 0 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMicro, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMicro, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMicro, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 0 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>None</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorNone & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>None: " & FORMAT ( _CountMicro, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar2 =
			    VAR Y = _TopPadding + 1 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountSmall, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountSmall, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountSmall, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 1 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Simple Build</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorSimpleBuild & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Solo: " & FORMAT ( _CountSmall, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar3 =
			    VAR Y = _TopPadding + 2 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMedium, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMedium, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMedium, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 2 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Mixed Build</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorMixedBuild & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Small Crew: " & FORMAT ( _CountMedium, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar4 =
			    VAR Y = _TopPadding + 3 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountLarge, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountLarge, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountLarge, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 3 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Varied Build</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorVariedBuild & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Squad: " & FORMAT ( _CountLarge, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar5 =
			    VAR Y = _TopPadding + 4 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountMega, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountMega, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountMega, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 4 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Complex Assembly</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorComplexAssembly & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Large Cast: " & FORMAT ( _CountMega, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bars = _Bar1 & _Bar2 & _Bar3 & _Bar4 & _Bar5
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    "<div style='width:100%;height:100%;overflow:hidden;'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    "<g>" & _Bars & "</g>" &
			    "</svg>" &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 74e12497-ac15-48ca-8307-b8186e5597a9

	measure 'HTML Parts Variety Boxplot' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 340
			VAR _MarginLeft         = 25
			VAR _MarginRight        = 25
			VAR _MarginTop          = 40            -- extra room for tier region labels at top
			VAR _MarginBottom       = 30
			
			-- Box styling
			VAR _BoxHeight          = 70
			VAR _WhiskerCapHeight   = 30
			VAR _MedianLineWidth    = 3
			VAR _BoxStrokeWidth     = 1.5
			VAR _BoxFillColor       = "#FFFFFF"
			VAR _BoxStrokeColor     = "#333333"
			VAR _WhiskerColor       = "#333333"
			VAR _MedianColor        = "#111111"
			VAR _BoxFillOpacity     = 0.55
			
			-- Dot styling
			VAR _DotRadius          = 6
			VAR _DotOpacity         = 0.7
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 0.2
			
			-- Tier divider styling
			VAR _DividerColor       = "#B0B0B0"
			VAR _DividerWidth       = 2
			VAR _DividerDash        = "3,3"
			VAR _TierLabelFontSize  = 20
			VAR _TierLabelColor     = "#555555"
			VAR _TierLabelY         = 20            -- Y position of tier region labels (above plot)
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 16
			VAR _LegendFontSize     = 15
			VAR _LegendSwatchSize   = 12
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _BoxAnimDur         = 0.6
			VAR _DotAnimDur         = 0.4
			VAR _DotAnimDelay       = 0.4
			
			-- Tier colors
			VAR _ColorNone              = "#2ECC71"
			VAR _ColorSimpleBuild       = "#2a78d6"
			VAR _ColorMixedBuild        = "#F4B400"
			VAR _ColorVariedBuild       = "#ab6643"
			VAR _ColorComplexAssembly   = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT ========================
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			VAR _SvgHeight  = _ChartHeight
			VAR _CenterY    = _MarginTop + _PlotHeight / 2
			
			-- ============================================
			-- === X-AXIS RANGE ===========================
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxPartsRaw = CALCULATE ( MAX ( sets[distinct_count_parts] ), ALL ( sets ), sets[distinct_count_parts] > 0 )
			VAR _MaxParts = IF ( ISBLANK ( _MaxPartsRaw ) || _MaxPartsRaw <= 1, 10, _MaxPartsRaw )
			VAR _LogMin = LOG10 ( _MinParts )
			VAR _LogMax = LOG10 ( _MaxParts )
			
			-- ============================================
			-- === OVERALL FIVE-NUMBER SUMMARY ============
			-- ============================================
			
			VAR _AllMin    = CALCULATE ( MIN ( sets[distinct_count_parts] ), sets[distinct_count_parts] > 0 )
			VAR _AllQ1     = CALCULATE ( PERCENTILE.INC ( sets[distinct_count_parts], 0.25 ), sets[distinct_count_parts] > 0 )
			VAR _AllMedian = CALCULATE ( PERCENTILE.INC ( sets[distinct_count_parts], 0.50 ), sets[distinct_count_parts] > 0 )
			VAR _AllQ3     = CALCULATE ( PERCENTILE.INC ( sets[distinct_count_parts], 0.75 ), sets[distinct_count_parts] > 0 )
			VAR _AllMax    = CALCULATE ( MAX ( sets[distinct_count_parts] ), sets[distinct_count_parts] > 0 )
			VAR _AllCount  = CALCULATE ( COUNTROWS ( sets ), sets[distinct_count_parts] > 0 )
			
			VAR _IQR = _AllQ3 - _AllQ1
			VAR _LowerFence = MAX ( 1, _AllQ1 - 1.5 * _IQR )
			VAR _UpperFence = _AllQ3 + 1.5 * _IQR
			
			VAR _WhiskerLoRaw =
			    CALCULATE ( MIN ( sets[distinct_count_parts] ), sets[distinct_count_parts] >= _LowerFence, sets[distinct_count_parts] > 0 )
			VAR _WhiskerHiRaw =
			    CALCULATE ( MAX ( sets[distinct_count_parts] ), sets[distinct_count_parts] <= _UpperFence, sets[distinct_count_parts] > 0 )
			VAR _WLo = IF ( ISBLANK ( _WhiskerLoRaw ) || _WhiskerLoRaw <= 0, _AllQ1, _WhiskerLoRaw )
			VAR _WHi = IF ( ISBLANK ( _WhiskerHiRaw ) || _WhiskerHiRaw <= 0, _AllQ3, _WhiskerHiRaw )
			
			-- ============================================
			-- === TIER BOUNDARIES (from data) ============
			-- ============================================
			-- MIN(parts) per tier gives the starting boundary of each tier region.
			-- Tier order = Micro (start=1) < Small < Medium < Large < Mega.
			
			VAR _TierBoundaries =
			    ADDCOLUMNS (
			        DATATABLE (
			            "tier_name", STRING,
			            "tier_color", STRING,
			            "tier_order", INTEGER,
			            {
			                { "None",  "#2ECC71", 1 },
			                { "Simple Build",  "#2a78d6", 2 },
			                { "Mixed Build", "#F4B400", 3 },
			                { "Varied Build",  "#ab6643", 4 },
			                { "Complex Assembly",   "#E53935", 5 }
			            }
			        ),
			        "@minParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MIN ( sets[distinct_count_parts] ), sets[part_variety_tier] = CurTier, sets[distinct_count_parts] > 0 ),
			        "@maxParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MAX ( sets[distinct_count_parts] ), sets[part_variety_tier] = CurTier, sets[distinct_count_parts] > 0 )
			    )
			
			VAR _TierBoundariesValid =
			    FILTER ( _TierBoundaries, NOT ISBLANK ( [@minParts] ) && [@minParts] > 0 )
			
			-- ============================================
			-- === X-COORDINATE HELPERS ===================
			-- ============================================
			
			VAR _Q1X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ1, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ1 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _Q3X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ3, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ3 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _MedX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllMedian, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllMedian - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WLoX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WLo, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WLo - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WHiX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WHi, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WHi - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			
			VAR _BoxTop = _CenterY - _BoxHeight / 2
			VAR _BoxBot = _CenterY + _BoxHeight / 2
			VAR _CapTop = _CenterY - _WhiskerCapHeight / 2
			VAR _CapBot = _CenterY + _WhiskerCapHeight / 2
			
			-- ============================================
			-- === TIER DIVIDERS + REGION LABELS ==========
			-- ============================================
			-- One dashed vertical line at the START of each tier (except the first).
			-- Each tier gets a name label centered between its start and its end
			-- (start of the next tier, or the plot right edge for the last tier).
			
			VAR _TierDividers =
			    CONCATENATEX (
			        FILTER ( _TierBoundariesValid, [tier_order] > 1 ),   -- skip Micro's start (that's the plot edge)
			        VAR StartVal = [@minParts]
			        VAR XPos =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & ( _MarginTop + _PlotHeight ) &
			            "' stroke='" & _DividerColor & "' stroke-width='" & _DividerWidth &
			            "' stroke-dasharray='" & _DividerDash & "' />",
			        "",
			        [tier_order], ASC
			    )
			
			VAR _MaxTierOrder = MAXX ( _TierBoundariesValid, [tier_order] )
			
			VAR _TierLabels =
			    CONCATENATEX (
			        _TierBoundariesValid,
			        VAR CurOrder = [tier_order]
			        VAR CurColor = [tier_color]
			        VAR CurName = [tier_name]
			        VAR StartVal = [@minParts]
			        VAR EndVal =
			            VAR NextStart =
			                MINX (
			                    FILTER ( _TierBoundariesValid, [tier_order] = CurOrder + 1 ),
			                    [@minParts]
			                )
			            RETURN
			                IF ( ISBLANK ( NextStart ), _MaxParts, NextStart )
			        VAR StartX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR EndX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( EndVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( EndVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR MidX = ( StartX + EndX ) / 2
			        RETURN
			            "<text x='" & MidX & "' y='" & _TierLabelY &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _TierLabelFontSize & "' font-weight='700' fill='" & CurColor & "'>" & CurName & "</text>",
			        "",
			        [tier_order], ASC
			    )
			
			-- ============================================
			-- === BOX + WHISKERS =========================
			-- ============================================
			
			VAR _BoxSVG =
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CenterY & "' x2='" & _Q1X & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _Q3X & "' y1='" & _CenterY & "' x2='" & _WHiX & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CapTop & "' x2='" & _WLoX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WHiX & "' y1='" & _CapTop & "' x2='" & _WHiX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<rect class='bp-box' x='" & _Q1X & "' y='" & _BoxTop & "' width='" & MAX ( _Q3X - _Q1X, 1 ) & "' height='" & _BoxHeight &
			    "' fill='" & _BoxFillColor & "' fill-opacity='" & _BoxFillOpacity &
			    "' stroke='" & _BoxStrokeColor & "' stroke-width='" & _BoxStrokeWidth &
			    "' data-min='" & FORMAT ( _AllMin, "#,0" ) &
			    "' data-q1='" & FORMAT ( _AllQ1, "#,0" ) &
			    "' data-median='" & FORMAT ( _AllMedian, "#,0" ) &
			    "' data-q3='" & FORMAT ( _AllQ3, "#,0" ) &
			    "' data-max='" & FORMAT ( _AllMax, "#,0" ) &
			    "' data-count='" & FORMAT ( _AllCount, "#,0" ) & "' />" &
			    "<line class='bp-anim' x1='" & _MedX & "' y1='" & _BoxTop & "' x2='" & _MedX & "' y2='" & _BoxBot &
			    "' stroke='" & _MedianColor & "' stroke-width='" & _MedianLineWidth & "' />"
			
			-- ============================================
			-- === DOTS ===================================
			-- ============================================
			
			VAR _DotRows =
			    ADDCOLUMNS (
			        FILTER (
			            SUMMARIZE ( sets, sets[distinct_count_parts], sets[part_variety_tier] ),
			            sets[distinct_count_parts] > 0
			        ),
			        "@tierColor",
			            SWITCH (
			                sets[part_variety_tier],
			                "None", _ColorNone,
			                "Simple Build", _ColorSimpleBuild,
			                "Mixed Build", _ColorMixedBuild,
			                "Varied Build", _ColorVariedBuild,
			                "Complex Assembly", _ColorComplexAssembly,
			                "#999999"
			            )
			    )
			
			VAR _Dots =
			    CONCATENATEX (
			        _DotRows,
			        VAR V = sets[distinct_count_parts]
			        VAR CX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<circle class='bp-dot' cx='" & CX & "' cy='" & _CenterY & "' r='" & _DotRadius &
			            "' fill='" & [@tierColor] & "' fill-opacity='" & _DotOpacity &
			            "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "'/>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS =================================
			-- ============================================
			
			VAR _MinPowerOf10 = CEILING ( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR ( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, _PowerCount - 1, 1 ),
			        "@partsVal", POWER ( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX (
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR XPos = _MarginLeft + DIVIDE ( LOG10 ( PartsVal ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT ( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & YBottom &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<line x1='" & XPos & "' y1='" & YBottom & "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 22 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes bpFade{from{opacity:0}to{opacity:1}}
			@keyframes bpDot{from{opacity:0}to{opacity:" & _DotOpacity & "}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.bp-anim { opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; }
			.bp-box { cursor:pointer; opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; transition:fill-opacity 0.15s ease; }
			.bp-box:hover { fill-opacity:0.85; }
			.bp-dot { opacity:0; animation:bpDot " & _DotAnimDur & "s ease-out " & _DotAnimDelay & "s both; pointer-events:none; }
			#custom-tooltip {
			    position:absolute; display:none;
			    background:" & _TooltipBg & "; border:1px solid " & _TooltipBorder & "; border-radius:6px;
			    padding:10px 12px; font-size:" & _TooltipFontSize & "px; color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & "; pointer-events:none; z-index:1000; white-space:nowrap;
			}
			#custom-tooltip .tt-title { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:2px 0; }
			#custom-tooltip .tt-label { color:#666; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-count { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var box = document.querySelector('.bp-box');
			    if (!box) return;
			
			    box.addEventListener('mouseenter', function(e){
			        var d = box.dataset;
			        var html = '';
			        html += '<div class=" & UNICHAR(34) & "tt-title" & UNICHAR(34) & ">All Sets</div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Max</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.max + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q3 (75%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q3 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Median</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.median + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q1 (25%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q1 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Min</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.min + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row tt-count" & UNICHAR(34) & "><span>Total sets</span><span>' + d.count + '</span></div>';
			        tooltip.innerHTML = html;
			        tooltip.style.display = 'block';
			    });
			
			    box.addEventListener('mousemove', function(e){
			        var rect = container.getBoundingClientRect();
			        var x = e.clientX - rect.left;
			        var y = e.clientY - rect.top;
			        var ttW = tooltip.offsetWidth;
			        var ttH = tooltip.offsetHeight;
			        var left = x + 15;
			        if (left + ttW > rect.width) left = x - ttW - 15;
			        var top = y - ttH - 15;
			        if (top < 5) top = y + 15;
			        if (top + ttH > rect.height) top = rect.height - ttH - 5;
			        tooltip.style.left = left + 'px';
			        tooltip.style.top = top + 'px';
			    });
			
			    box.addEventListener('mouseleave', function(){
			        tooltip.style.display = 'none';
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    _TooltipStyle &
			    "<div class='chart-container'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    _XAxisElements &
			    _TierDividers &
			    _TierLabels &
			    _XAxisBaseline &
			    "<g>" & _Dots & "</g>" &
			    _BoxSVG &
			    "</svg>" &
			    _TooltipHTML &
			    "</div>" &
			    _TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 59cc49b9-3ee9-47a1-b3d6-c52a165803cf

	measure 'HTML Minifig Boxplot' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 340
			VAR _MarginLeft         = 25
			VAR _MarginRight        = 25
			VAR _MarginTop          = 40            -- extra room for tier region labels at top
			VAR _MarginBottom       = 30
			
			-- Box styling
			VAR _BoxHeight          = 70
			VAR _WhiskerCapHeight   = 30
			VAR _MedianLineWidth    = 3
			VAR _BoxStrokeWidth     = 1.5
			VAR _BoxFillColor       = "#FFFFFF"
			VAR _BoxStrokeColor     = "#333333"
			VAR _WhiskerColor       = "#333333"
			VAR _MedianColor        = "#111111"
			VAR _BoxFillOpacity     = 0.55
			
			-- Dot styling
			VAR _DotRadius          = 6
			VAR _DotOpacity         = 1
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 0.5
			
			-- Tier divider styling
			VAR _DividerColor       = "#B0B0B0"
			VAR _DividerWidth       = 2
			VAR _DividerDash        = "3,3"
			VAR _TierLabelFontSize  = 20
			VAR _TierLabelColor     = "#555555"
			VAR _TierLabelY         = 20            -- Y position of tier region labels (above plot)
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 16
			VAR _LegendFontSize     = 15
			VAR _LegendSwatchSize   = 12
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _BoxAnimDur         = 0.6
			VAR _DotAnimDur         = 0.4
			VAR _DotAnimDelay       = 0.4
			
			-- Tier colors
			VAR _ColorNone              = "#F4F5F7"
			VAR _ColorSimpleBuild       = "#CFEFEA"
			VAR _ColorMixedBuild        = "#E8D1A8"
			VAR _ColorVariedBuild       = "#B18FCF"
			VAR _ColorComplexAssembly   = "#F07F5A"
			
			-- ============================================
			-- === COMPUTED LAYOUT ========================
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			VAR _SvgHeight  = _ChartHeight
			VAR _CenterY    = _MarginTop + _PlotHeight / 2
			
			-- ============================================
			-- === X-AXIS RANGE ===========================
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxPartsRaw = CALCULATE ( MAX ( sets[total_minifigs] ), ALL ( sets ), sets[total_minifigs] > 0 )
			VAR _MaxParts = IF ( ISBLANK ( _MaxPartsRaw ) || _MaxPartsRaw <= 1, 10, _MaxPartsRaw )
			VAR _LogMin = LOG10 ( _MinParts )
			VAR _LogMax = LOG10 ( _MaxParts )
			
			-- ============================================
			-- === OVERALL FIVE-NUMBER SUMMARY ============
			-- ============================================
			
			VAR _AllMin    = CALCULATE ( MIN ( sets[total_minifigs] ), sets[total_minifigs] > 0 )
			VAR _AllQ1     = CALCULATE ( PERCENTILE.INC ( sets[total_minifigs], 0.25 ), sets[total_minifigs] > 0 )
			VAR _AllMedian = CALCULATE ( PERCENTILE.INC ( sets[total_minifigs], 0.50 ), sets[total_minifigs] > 0 )
			VAR _AllQ3     = CALCULATE ( PERCENTILE.INC ( sets[total_minifigs], 0.75 ), sets[total_minifigs] > 0 )
			VAR _AllMax    = CALCULATE ( MAX ( sets[total_minifigs] ), sets[total_minifigs] > 0 )
			VAR _AllCount  = CALCULATE ( COUNTROWS ( sets ), sets[total_minifigs] > 0 )
			
			VAR _IQR = _AllQ3 - _AllQ1
			VAR _LowerFence = MAX ( 1, _AllQ1 - 1.5 * _IQR )
			VAR _UpperFence = _AllQ3 + 1.5 * _IQR
			
			VAR _WhiskerLoRaw =
			    CALCULATE ( MIN ( sets[total_minifigs] ), sets[total_minifigs] >= _LowerFence, sets[total_minifigs] > 0 )
			VAR _WhiskerHiRaw =
			    CALCULATE ( MAX ( sets[total_minifigs] ), sets[total_minifigs] <= _UpperFence, sets[total_minifigs] > 0 )
			VAR _WLo = IF ( ISBLANK ( _WhiskerLoRaw ) || _WhiskerLoRaw <= 0, _AllQ1, _WhiskerLoRaw )
			VAR _WHi = IF ( ISBLANK ( _WhiskerHiRaw ) || _WhiskerHiRaw <= 0, _AllQ3, _WhiskerHiRaw )
			
			-- ============================================
			-- === TIER BOUNDARIES (from data) ============
			-- ============================================
			-- MIN(parts) per tier gives the starting boundary of each tier region.
			-- Tier order = Micro (start=1) < Small < Medium < Large < Mega.
			
			VAR _TierBoundaries =
			    ADDCOLUMNS (
			        DATATABLE (
			            "tier_name", STRING,
			            "tier_color", STRING,
			            "tier_order", INTEGER,
			            {
			                { "None",  "#F4F5F7", 1 },
			                { "Solo",  "#CFEFEA", 2 },
			                { "Small Crew", "#E8D1A8", 3 },
			                { "Squad",  "#B18FCF", 4 },
			                { "Large Cast",   "#F07F5A", 5 }
			            }
			        ),
			        "@minParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MIN ( sets[total_minifigs] ), sets[minifig_tier] = CurTier, sets[total_minifigs] > 0 ),
			        "@maxParts",
			            VAR CurTier = [tier_name]
			            RETURN CALCULATE ( MAX ( sets[total_minifigs] ), sets[minifig_tier] = CurTier, sets[total_minifigs] > 0 )
			    )
			
			VAR _TierBoundariesValid =
			    FILTER ( _TierBoundaries, NOT ISBLANK ( [@minParts] ) && [@minParts] > 0 )
			
			-- ============================================
			-- === X-COORDINATE HELPERS ===================
			-- ============================================
			
			VAR _Q1X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ1, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ1 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _Q3X =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllQ3, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllQ3 - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _MedX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _AllMedian, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _AllMedian - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WLoX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WLo, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WLo - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			VAR _WHiX =
			    IF ( _UseLogScale,
			        _MarginLeft + DIVIDE ( LOG10 ( MAX ( _WHi, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			        _MarginLeft + DIVIDE ( _WHi - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			
			VAR _BoxTop = _CenterY - _BoxHeight / 2
			VAR _BoxBot = _CenterY + _BoxHeight / 2
			VAR _CapTop = _CenterY - _WhiskerCapHeight / 2
			VAR _CapBot = _CenterY + _WhiskerCapHeight / 2
			
			-- ============================================
			-- === TIER DIVIDERS + REGION LABELS ==========
			-- ============================================
			-- One dashed vertical line at the START of each tier (except the first).
			-- Each tier gets a name label centered between its start and its end
			-- (start of the next tier, or the plot right edge for the last tier).
			
			VAR _TierDividers =
			    CONCATENATEX (
			        FILTER ( _TierBoundariesValid, [tier_order] > 1 ),   -- skip Micro's start (that's the plot edge)
			        VAR StartVal = [@minParts]
			        VAR XPos =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & ( _MarginTop + _PlotHeight ) &
			            "' stroke='" & _DividerColor & "' stroke-width='" & _DividerWidth &
			            "' stroke-dasharray='" & _DividerDash & "' />",
			        "",
			        [tier_order], ASC
			    )
			
			VAR _MaxTierOrder = MAXX ( _TierBoundariesValid, [tier_order] )
			
			VAR _TierLabels =
			    CONCATENATEX (
			        _TierBoundariesValid,
			        VAR CurOrder = [tier_order]
			        VAR CurColor = [tier_color]
			        VAR CurName = [tier_name]
			        VAR StartVal = [@minParts]
			        VAR EndVal =
			            VAR NextStart =
			                MINX (
			                    FILTER ( _TierBoundariesValid, [tier_order] = CurOrder + 1 ),
			                    [@minParts]
			                )
			            RETURN
			                IF ( ISBLANK ( NextStart ), _MaxParts, NextStart )
			        VAR StartX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( StartVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( StartVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR EndX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( EndVal, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( EndVal - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        VAR MidX = ( StartX + EndX ) / 2
			        RETURN
			            "<text x='" & MidX & "' y='" & _TierLabelY &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _TierLabelFontSize & "' font-weight='700' fill='" & CurColor & "'>" & CurName & "</text>",
			        "",
			        [tier_order], ASC
			    )
			
			-- ============================================
			-- === BOX + WHISKERS =========================
			-- ============================================
			
			VAR _BoxSVG =
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CenterY & "' x2='" & _Q1X & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _Q3X & "' y1='" & _CenterY & "' x2='" & _WHiX & "' y2='" & _CenterY &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WLoX & "' y1='" & _CapTop & "' x2='" & _WLoX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<line class='bp-anim' x1='" & _WHiX & "' y1='" & _CapTop & "' x2='" & _WHiX & "' y2='" & _CapBot &
			    "' stroke='" & _WhiskerColor & "' stroke-width='" & _BoxStrokeWidth & "' />" &
			    "<rect class='bp-box' x='" & _Q1X & "' y='" & _BoxTop & "' width='" & MAX ( _Q3X - _Q1X, 1 ) & "' height='" & _BoxHeight &
			    "' fill='" & _BoxFillColor & "' fill-opacity='" & _BoxFillOpacity &
			    "' stroke='" & _BoxStrokeColor & "' stroke-width='" & _BoxStrokeWidth &
			    "' data-min='" & FORMAT ( _AllMin, "#,0" ) &
			    "' data-q1='" & FORMAT ( _AllQ1, "#,0" ) &
			    "' data-median='" & FORMAT ( _AllMedian, "#,0" ) &
			    "' data-q3='" & FORMAT ( _AllQ3, "#,0" ) &
			    "' data-max='" & FORMAT ( _AllMax, "#,0" ) &
			    "' data-count='" & FORMAT ( _AllCount, "#,0" ) & "' />" &
			    "<line class='bp-anim' x1='" & _MedX & "' y1='" & _BoxTop & "' x2='" & _MedX & "' y2='" & _BoxBot &
			    "' stroke='" & _MedianColor & "' stroke-width='" & _MedianLineWidth & "' />"
			
			-- ============================================
			-- === DOTS ===================================
			-- ============================================
			
			VAR _DotRows =
			    ADDCOLUMNS (
			        FILTER (
			            SUMMARIZE ( sets, sets[total_minifigs], sets[minifig_tier] ),
			            sets[total_minifigs] > 0
			        ),
			        "@tierColor",
			            SWITCH (
			                sets[minifig_tier],
			                "None", _ColorNone,
			                "Solo", _ColorSimpleBuild,
			                "Small Crew", _ColorMixedBuild,
			                "Squad", _ColorVariedBuild,
			                "Large Cast", _ColorComplexAssembly,
			                "#999999"
			            )
			    )
			
			VAR _Dots =
			    CONCATENATEX (
			        _DotRows,
			        VAR V = sets[total_minifigs]
			        VAR CX =
			            IF ( _UseLogScale,
			                _MarginLeft + DIVIDE ( LOG10 ( MAX ( V, 1 ) ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth,
			                _MarginLeft + DIVIDE ( V - _MinParts, _MaxParts - _MinParts ) * _PlotWidth )
			        RETURN
			            "<circle class='bp-dot' cx='" & CX & "' cy='" & _CenterY & "' r='" & _DotRadius &
			            "' fill='" & [@tierColor] & "' fill-opacity='" & _DotOpacity &
			            "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "'/>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS =================================
			-- ============================================
			
			VAR _MinPowerOf10 = CEILING ( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR ( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, _PowerCount - 1, 1 ),
			        "@partsVal", POWER ( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX (
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR XPos = _MarginLeft + DIVIDE ( LOG10 ( PartsVal ) - _LogMin, _LogMax - _LogMin ) * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT ( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & _MarginTop & "' x2='" & XPos & "' y2='" & YBottom &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<line x1='" & XPos & "' y1='" & YBottom & "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 22 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes bpFade{from{opacity:0}to{opacity:1}}
			@keyframes bpDot{from{opacity:0}to{opacity:" & _DotOpacity & "}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.bp-anim { opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; }
			.bp-box { cursor:pointer; opacity:0; animation:bpFade " & _BoxAnimDur & "s ease-out both; transition:fill-opacity 0.15s ease; }
			.bp-box:hover { fill-opacity:0.85; }
			.bp-dot { opacity:0; animation:bpDot " & _DotAnimDur & "s ease-out " & _DotAnimDelay & "s both; pointer-events:none; }
			#custom-tooltip {
			    position:absolute; display:none;
			    background:" & _TooltipBg & "; border:1px solid " & _TooltipBorder & "; border-radius:6px;
			    padding:10px 12px; font-size:" & _TooltipFontSize & "px; color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & "; pointer-events:none; z-index:1000; white-space:nowrap;
			}
			#custom-tooltip .tt-title { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:16px; margin:2px 0; }
			#custom-tooltip .tt-label { color:#666; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-count { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var box = document.querySelector('.bp-box');
			    if (!box) return;
			
			    box.addEventListener('mouseenter', function(e){
			        var d = box.dataset;
			        var html = '';
			        html += '<div class=" & UNICHAR(34) & "tt-title" & UNICHAR(34) & ">All Sets</div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Max</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.max + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q3 (75%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q3 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Median</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.median + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Q1 (25%)</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.q1 + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & ">Min</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.min + '</span></div>';
			        html += '<div class=" & UNICHAR(34) & "tt-row tt-count" & UNICHAR(34) & "><span>Total sets</span><span>' + d.count + '</span></div>';
			        tooltip.innerHTML = html;
			        tooltip.style.display = 'block';
			    });
			
			    box.addEventListener('mousemove', function(e){
			        var rect = container.getBoundingClientRect();
			        var x = e.clientX - rect.left;
			        var y = e.clientY - rect.top;
			        var ttW = tooltip.offsetWidth;
			        var ttH = tooltip.offsetHeight;
			        var left = x + 15;
			        if (left + ttW > rect.width) left = x - ttW - 15;
			        var top = y - ttH - 15;
			        if (top < 5) top = y + 15;
			        if (top + ttH > rect.height) top = rect.height - ttH - 5;
			        tooltip.style.left = left + 'px';
			        tooltip.style.top = top + 'px';
			    });
			
			    box.addEventListener('mouseleave', function(){
			        tooltip.style.display = 'none';
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    _TooltipStyle &
			    "<div class='chart-container'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    _XAxisElements &
			    _TierDividers &
			    _TierLabels &
			    _XAxisBaseline &
			    "<g>" & _Dots & "</g>" &
			    _BoxSVG &
			    "</svg>" &
			    _TooltipHTML &
			    "</div>" &
			    _TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: b98b9abc-2581-425d-b939-720c27c5be1c

	measure 'HTML Total Parts Grid' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Typography
			VAR _FontFamily          = "Segoe UI, sans-serif"
			
			VAR _MainTitleSize       = 23
			VAR _MainTitleWeight     = 700
			VAR _MainTitleColor      = "#000000"
			VAR _MainTitleGap        = 15
			
			VAR _DecadeTitleSize     = 26
			VAR _DecadeTitleWeight   = 800
			VAR _DecadeTitleColor    = "#000000"
			VAR _DecadeTitleBg       = "#F2F2F2"
			VAR _DecadeTitlePadY     = 14
			VAR _DecadeTitlePadX     = 18
			VAR _DecadeTitleRadius   = 10
			VAR _DecadeLabelWidth    = 140          -- px, fixed width for the side label
			VAR _DecadeLabelGap      = 18           -- px, gap between decade label and card row
			
			VAR _TierHeaderFontSize  = 22
			VAR _TierHeaderWeight    = 700
			VAR _SetNameFontSize     = 21
			VAR _SetNameWeight       = 600
			VAR _SetNameColor        = "#222222"
			VAR _PartFontSize        = 18
			VAR _PartFontWeight      = 700
			VAR _AvgFontSize         = 18
			VAR _AvgFontWeight       = 600
			VAR _AvgColor            = "#6B6B6B"
			
			-- Card layout
			VAR _CardWidth           = 330
			VAR _CardMinHeight       = 100
			VAR _CardBorderRadius    = 10
			VAR _CardPadding         = 20
			VAR _CardGap             = 20
			VAR _CardBorderWidth     = 2
			VAR _ImageHeight         = 100
			
			-- Gradient opacity
			VAR _GradientTopOpacity  = 0.20
			VAR _GradientMidOpacity  = 0.10
			VAR _GradientBotOpacity  = 0.00
			
			-- Decade section spacing
			VAR _DecadeSpacing       = 32
			
			-- Container padding
			VAR _ContainerPad        = 5
			
			-- Tier colors
			VAR _ColorMicro          = "#2ECC71"
			VAR _ColorSmall          = "#2a78d6"
			VAR _ColorMedium         = "#F4B400"
			VAR _ColorLarge          = "#ab6643"
			VAR _ColorMega           = "#E53935"
			
			-- Card row width lock
			VAR _TierCountForWidth   = 5
			VAR _RowFullWidth        = _CardWidth * _TierCountForWidth + _CardGap * ( _TierCountForWidth - 1 )
			
			-- ============================================
			-- === CSS ====================================
			-- ============================================
			
			VAR _CSS =
			"<style>
			html, body { margin:0; padding:0; overflow-y:auto; overflow-x:hidden; font-family:" & _FontFamily & "; }
			.container { padding:" & _ContainerPad & "px; box-sizing:border-box; }
			.main-title {
			    font-size:" & _MainTitleSize & "px;
			    font-weight:" & _MainTitleWeight & ";
			    color:" & _MainTitleColor & ";
			    margin-bottom:" & _MainTitleGap & "px;
			    line-height:1.2;
			}
			.decade-section {
			    display:flex;
			    flex-direction:row;
			    align-items:stretch;
			    gap:" & _DecadeLabelGap & "px;
			    margin-bottom:" & _DecadeSpacing & "px;
			}
			.decade-title {
			    width:" & _DecadeLabelWidth & "px;
			    flex-shrink:0;
			    box-sizing:border-box;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    font-size:" & _DecadeTitleSize & "px;
			    font-weight:" & _DecadeTitleWeight & ";
			    color:" & _DecadeTitleColor & ";
			    background:" & _DecadeTitleBg & ";
			    padding:" & _DecadeTitlePadY & "px " & _DecadeTitlePadX & "px;
			    border-radius:" & _DecadeTitleRadius & "px;
			    text-align:center;
			}
			.card-row {
			    display:flex;
			    flex-direction:row;
			    flex-wrap:wrap;
			    gap:" & _CardGap & "px;
			    justify-content:flex-start;
			    width:" & _RowFullWidth & "px;
			    max-width:100%;
			}
			.tier-card {
			    width:" & _CardWidth & "px;
			    min-height:" & _CardMinHeight & "px;
			    border-radius:" & _CardBorderRadius & "px;
			    padding:" & _CardPadding & "px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    box-sizing:border-box;
			}
			.tier-header {
			    font-size:" & _TierHeaderFontSize & "px;
			    font-weight:" & _TierHeaderWeight & ";
			    text-align:center;
			    margin-bottom:14px;
			    line-height:1.2;
			}
			.tier-image-wrap {
			    height:" & _ImageHeight & "px;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    margin-bottom:16px;
			    width:100%;
			}
			.tier-image-wrap img {
			    max-height:" & _ImageHeight & "px;
			    max-width:100%;
			    display:block;
			}
			.tier-name {
			    font-size:" & _SetNameFontSize & "px;
			    font-weight:" & _SetNameWeight & ";
			    color:" & _SetNameColor & ";
			    text-align:center;
			    margin-bottom:8px;
			    line-height:1.25;
			}
			.tier-parts {
			    font-size:" & _PartFontSize & "px;
			    font-weight:" & _PartFontWeight & ";
			    text-align:center;
			    margin-bottom:6px;
			    line-height:1.2;
			}
			.tier-avg {
			    font-size:" & _AvgFontSize & "px;
			    font-weight:" & _AvgFontWeight & ";
			    color:" & _AvgColor & ";
			    text-align:center;
			    line-height:1.2;
			}
			</style>"
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Tiers =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            ALL( decade_lego_set_complex[Set Complexity], decade_lego_set_complex[Set Complexity Order] ),
			            "@order", decade_lego_set_complex[Set Complexity Order]
			        ),
			        "Tier", decade_lego_set_complex[Set Complexity],
			        "TierOrder", [@order]
			    )
			
			VAR _Decades =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            SUMMARIZE( dim_year, dim_year[decade] ),
			            "@order", CALCULATE( MIN( dim_year[year] ), ALLEXCEPT( dim_year, dim_year[decade] ) )
			        ),
			        "Decade", dim_year[decade],
			        "DecadeOrder", [@order]
			    )
			
			-- ============================================
			-- === BUILD DECADE SECTIONS ==================
			-- ============================================
			
			VAR _DecadeSections =
			    CONCATENATEX(
			        _Decades,
			        VAR _Decade    = [Decade]
			        VAR _DecadeOrd = [DecadeOrder]
			
			        VAR _Cards =
			            CONCATENATEX(
			                _Tiers,
			                VAR _Tier      = [Tier]
			                VAR _TierOrder = [TierOrder]
			
			                VAR _TierColor =
			                    SWITCH(
			                        _Tier,
			                        "Micro",  _ColorMicro,
			                        "Small",  _ColorSmall,
			                        "Medium", _ColorMedium,
			                        "Large",  _ColorLarge,
			                        "Mega",   _ColorMega,
			                        "#808080"
			                    )
			
			                -- Hex to RGB via position math
			                VAR _HexChars = "0123456789ABCDEF"
			                VAR _RHex = UPPER( MID( _TierColor, 2, 2 ) )
			                VAR _GHex = UPPER( MID( _TierColor, 4, 2 ) )
			                VAR _BHex = UPPER( MID( _TierColor, 6, 2 ) )
			                VAR _R =
			                    ( FIND( LEFT( _RHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _RHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _G =
			                    ( FIND( LEFT( _GHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _GHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _B =
			                    ( FIND( LEFT( _BHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _BHex, 1 ), _HexChars, 1, 1 ) - 1 )
			
			                VAR _RgbTriplet = _R & "," & _G & "," & _B
			
			                VAR _Gradient =
			                    "linear-gradient(180deg, rgba(" & _RgbTriplet & "," & _GradientTopOpacity &
			                    ") 0%, rgba(" & _RgbTriplet & "," & _GradientMidOpacity &
			                    ") 55%, rgba(" & _RgbTriplet & "," & _GradientBotOpacity & ") 100%)"
			
			                VAR _PartRange =
			                    CALCULATE(
			                        MAX( decade_lego_set_complex[Part Count Category] ),
			                        decade_lego_set_complex[Set Complexity] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _BoxArtURL =
			                    CALCULATE(
			                        MAX( decade_lego_set_complex[Representative Set Image] ),
			                        decade_lego_set_complex[Set Complexity] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _BoxArtName =
			                    CALCULATE(
			                        MAX( decade_lego_set_complex[Representative Set Name] ),
			                        decade_lego_set_complex[Set Complexity] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _BoxArtPart =
			                    CALCULATE(
			                        MAX( decade_lego_set_complex[Representative Set Total Part] ),
			                        decade_lego_set_complex[Set Complexity] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _AvgParts =
			                    CALCULATE(
			                        MAX( decade_lego_set_complex[Avg Part per Set] ),
			                        decade_lego_set_complex[Set Complexity] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _HasData = NOT ISBLANK( _BoxArtPart )
			
			                VAR _CardHTML =
			                    "<div class='tier-card' style='background:" & _Gradient &
			                    ";border:" & _CardBorderWidth & "px solid " & _TierColor & ";'>
			                        <div class='tier-header' style='color:" & _TierColor & ";'>" &
			                            UPPER( _Tier ) & " (" & _PartRange & ")" &
			                        "</div>
			                        <div class='tier-image-wrap'>
			                            <img src='" & _BoxArtURL & "' />
			                        </div>
			                        <div class='tier-name'>" & _BoxArtName & "</div>
			                        <div class='tier-parts' style='color:" & _TierColor & ";'>" &
			                            FORMAT( _BoxArtPart, "#,0" ) & " parts" &
			                        "</div>
			                        <div class='tier-avg'>Avg parts per set: " & FORMAT( _AvgParts, "#,0" ) & "</div>
			                    </div>"
			
			                RETURN IF( _HasData, _CardHTML, "" ),
			                "",
			                [TierOrder], ASC
			            )
			
			        RETURN
			            "<div class='decade-section'>
			                <div class='decade-title'>" & _Decade & "</div>
			                <div class='card-row'>" & _Cards & "</div>
			            </div>",
			        "",
			        [DecadeOrder], DESC
			    )
			
			-- ============================================
			-- === FINAL HTML =============================
			-- ============================================
			
			VAR _HTML =
			    _CSS &
			    "<div class='container'>
			        <div class='main-title'>Representative Set by Decade and Total Parts Category</div>" &
			        _DecadeSections &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: b04f50f4-3c37-433b-8304-f8c6e710c65a

	measure 'HTML Parts Variety Grid' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Typography
			VAR _FontFamily          = "Segoe UI, sans-serif"
			
			VAR _MainTitleSize       = 23
			VAR _MainTitleWeight     = 700
			VAR _MainTitleColor      = "#000000"
			VAR _MainTitleGap        = 15
			
			VAR _DecadeTitleSize     = 26
			VAR _DecadeTitleWeight   = 800
			VAR _DecadeTitleColor    = "#000000"
			VAR _DecadeTitleBg       = "#F2F2F2"
			VAR _DecadeTitlePadY     = 14
			VAR _DecadeTitlePadX     = 18
			VAR _DecadeTitleRadius   = 10
			VAR _DecadeLabelWidth    = 140
			VAR _DecadeLabelGap      = 18
			
			VAR _TierHeaderFontSize  = 22
			VAR _TierHeaderWeight    = 700
			VAR _SetNameFontSize     = 21
			VAR _SetNameWeight       = 600
			VAR _SetNameColor        = "#222222"
			VAR _PartFontSize        = 18
			VAR _PartFontWeight      = 700
			VAR _AvgFontSize         = 18
			VAR _AvgFontWeight       = 600
			VAR _AvgColor            = "#6B6B6B"
			
			-- Card layout
			VAR _CardWidth           = 330
			VAR _CardMinHeight       = 100
			VAR _CardBorderRadius    = 10
			VAR _CardPadding         = 20
			VAR _CardGap             = 20
			VAR _CardBorderWidth     = 2
			VAR _ImageHeight         = 100
			
			-- Gradient opacity
			VAR _GradientTopOpacity  = 0.20
			VAR _GradientMidOpacity  = 0.10
			VAR _GradientBotOpacity  = 0.00
			
			-- Decade section spacing
			VAR _DecadeSpacing       = 32
			
			-- Container padding
			VAR _ContainerPad        = 5
			
			-- Tier colors
			VAR _ColorNone             = "#2ECC71"
			VAR _ColorSimpleBuild      = "#2a78d6"
			VAR _ColorMixedBuild       = "#F4B400"
			VAR _ColorVariedBuild      = "#ab6643"
			VAR _ColorComplexAssembly  = "#E53935"
			
			-- Tier range labels (matches part_variety_tier thresholds)
			VAR _RangeNone             = "0"
			VAR _RangeSimpleBuild      = "1-7"
			VAR _RangeMixedBuild       = "8-22"
			VAR _RangeVariedBuild      = "23-62"
			VAR _RangeComplexAssembly  = ">62"
			
			-- Card row width lock
			VAR _TierCountForWidth   = 5
			VAR _RowFullWidth        = _CardWidth * _TierCountForWidth + _CardGap * ( _TierCountForWidth - 1 )
			
			-- ============================================
			-- === CSS ====================================
			-- ============================================
			
			VAR _CSS =
			"<style>
			html, body { margin:0; padding:0; overflow-y:auto; overflow-x:hidden; font-family:" & _FontFamily & "; }
			.container { padding:" & _ContainerPad & "px; box-sizing:border-box; }
			.main-title {
			    font-size:" & _MainTitleSize & "px;
			    font-weight:" & _MainTitleWeight & ";
			    color:" & _MainTitleColor & ";
			    margin-bottom:" & _MainTitleGap & "px;
			    line-height:1.2;
			}
			.decade-section {
			    display:flex;
			    flex-direction:row;
			    align-items:stretch;
			    gap:" & _DecadeLabelGap & "px;
			    margin-bottom:" & _DecadeSpacing & "px;
			}
			.decade-title {
			    width:" & _DecadeLabelWidth & "px;
			    flex-shrink:0;
			    box-sizing:border-box;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    font-size:" & _DecadeTitleSize & "px;
			    font-weight:" & _DecadeTitleWeight & ";
			    color:" & _DecadeTitleColor & ";
			    background:" & _DecadeTitleBg & ";
			    padding:" & _DecadeTitlePadY & "px " & _DecadeTitlePadX & "px;
			    border-radius:" & _DecadeTitleRadius & "px;
			    text-align:center;
			}
			.card-row {
			    display:flex;
			    flex-direction:row;
			    flex-wrap:wrap;
			    gap:" & _CardGap & "px;
			    justify-content:flex-start;
			    width:" & _RowFullWidth & "px;
			    max-width:100%;
			}
			.tier-card {
			    width:" & _CardWidth & "px;
			    min-height:" & _CardMinHeight & "px;
			    border-radius:" & _CardBorderRadius & "px;
			    padding:" & _CardPadding & "px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    box-sizing:border-box;
			}
			.tier-header {
			    font-size:" & _TierHeaderFontSize & "px;
			    font-weight:" & _TierHeaderWeight & ";
			    text-align:center;
			    margin-bottom:14px;
			    line-height:1.2;
			}
			.tier-image-wrap {
			    height:" & _ImageHeight & "px;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    margin-bottom:16px;
			    width:100%;
			}
			.tier-image-wrap img {
			    max-height:" & _ImageHeight & "px;
			    max-width:100%;
			    display:block;
			}
			.tier-name {
			    font-size:" & _SetNameFontSize & "px;
			    font-weight:" & _SetNameWeight & ";
			    color:" & _SetNameColor & ";
			    text-align:center;
			    margin-bottom:8px;
			    line-height:1.25;
			}
			.tier-parts {
			    font-size:" & _PartFontSize & "px;
			    font-weight:" & _PartFontWeight & ";
			    text-align:center;
			    margin-bottom:6px;
			    line-height:1.2;
			}
			.tier-avg {
			    font-size:" & _AvgFontSize & "px;
			    font-weight:" & _AvgFontWeight & ";
			    color:" & _AvgColor & ";
			    text-align:center;
			    line-height:1.2;
			}
			</style>"
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Tiers =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            ALL( sets[part_variety_tier], sets[part_variety_tier_order] ),
			            "@order", sets[part_variety_tier_order]
			        ),
			        "Tier", sets[part_variety_tier],
			        "TierOrder", [@order]
			    )
			
			VAR _Decades =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            SUMMARIZE( dim_year, dim_year[decade] ),
			            "@order", CALCULATE( MIN( dim_year[year] ), ALLEXCEPT( dim_year, dim_year[decade] ) )
			        ),
			        "Decade", dim_year[decade],
			        "DecadeOrder", [@order]
			    )
			
			-- ============================================
			-- === BUILD DECADE SECTIONS ==================
			-- ============================================
			
			VAR _DecadeSections =
			    CONCATENATEX(
			        _Decades,
			        VAR _Decade    = [Decade]
			        VAR _DecadeOrd = [DecadeOrder]
			
			        VAR _Cards =
			            CONCATENATEX(
			                _Tiers,
			                VAR _Tier      = [Tier]
			                VAR _TierOrder = [TierOrder]
			
			                VAR _TierColor =
			                    SWITCH(
			                        _Tier,
			                        "None",              _ColorNone,
			                        "Simple Build",      _ColorSimpleBuild,
			                        "Mixed Build",       _ColorMixedBuild,
			                        "Varied Build",      _ColorVariedBuild,
			                        "Complex Assembly",  _ColorComplexAssembly,
			                        "#808080"
			                    )
			
			                VAR _TierRange =
			                    SWITCH(
			                        _Tier,
			                        "None",              _RangeNone,
			                        "Simple Build",      _RangeSimpleBuild,
			                        "Mixed Build",       _RangeMixedBuild,
			                        "Varied Build",      _RangeVariedBuild,
			                        "Complex Assembly",  _RangeComplexAssembly,
			                        ""
			                    )
			
			                -- Hex to RGB via position math
			                VAR _HexChars = "0123456789ABCDEF"
			                VAR _RHex = UPPER( MID( _TierColor, 2, 2 ) )
			                VAR _GHex = UPPER( MID( _TierColor, 4, 2 ) )
			                VAR _BHex = UPPER( MID( _TierColor, 6, 2 ) )
			                VAR _R =
			                    ( FIND( LEFT( _RHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _RHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _G =
			                    ( FIND( LEFT( _GHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _GHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _B =
			                    ( FIND( LEFT( _BHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _BHex, 1 ), _HexChars, 1, 1 ) - 1 )
			
			                VAR _RgbTriplet = _R & "," & _G & "," & _B
			
			                VAR _Gradient =
			                    "linear-gradient(180deg, rgba(" & _RgbTriplet & "," & _GradientTopOpacity &
			                    ") 0%, rgba(" & _RgbTriplet & "," & _GradientMidOpacity &
			                    ") 55%, rgba(" & _RgbTriplet & "," & _GradientBotOpacity & ") 100%)"
			
			                -- Representative set = highest distinct_count_parts in this (decade, tier)
			                VAR _BoxArtVariety =
			                    CALCULATE(
			                        MAX( sets[distinct_count_parts] ),
			                        sets[part_variety_tier] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _BoxArtName =
			                    CALCULATE(
			                        MAX( sets[set_name] ),
			                        sets[part_variety_tier] = _Tier,
			                        sets[distinct_count_parts] = _BoxArtVariety,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _BoxArtURL =
			                    CALCULATE(
			                        MAX( sets[img_url] ),
			                        sets[part_variety_tier] = _Tier,
			                        sets[distinct_count_parts] = _BoxArtVariety,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _AvgVariety =
			                    CALCULATE(
			                        AVERAGE( sets[distinct_count_parts] ),
			                        sets[part_variety_tier] = _Tier,
			                        ALL( dim_year ),
			                        dim_year[decade] = _Decade
			                    )
			
			                VAR _HasData = NOT ISBLANK( _BoxArtVariety )
			
			                VAR _CardHTML =
			                    "<div class='tier-card' style='background:" & _Gradient &
			                    ";border:" & _CardBorderWidth & "px solid " & _TierColor & ";'>
			                        <div class='tier-header' style='color:" & _TierColor & ";'>" &
			                            UPPER( _Tier ) & " (" & _TierRange & ")" &
			                        "</div>
			                        <div class='tier-image-wrap'>
			                            <img src='" & _BoxArtURL & "' />
			                        </div>
			                        <div class='tier-name'>" & _BoxArtName & "</div>
			                        <div class='tier-parts' style='color:" & _TierColor & ";'>" &
			                            FORMAT( _BoxArtVariety, "#,0" ) & " distinct parts" &
			                        "</div>
			                        <div class='tier-avg'>Avg distinct parts per set: " & FORMAT( _AvgVariety, "#,0" ) & "</div>
			                    </div>"
			
			                RETURN IF( _HasData, _CardHTML, "" ),
			                "",
			                [TierOrder], ASC
			            )
			
			        RETURN
			            "<div class='decade-section'>
			                <div class='decade-title'>" & _Decade & "</div>
			                <div class='card-row'>" & _Cards & "</div>
			            </div>",
			        "",
			        [DecadeOrder], DESC
			    )
			
			-- ============================================
			-- === FINAL HTML =============================
			-- ============================================
			
			VAR _HTML =
			    _CSS &
			    "<div class='container'>
			        <div class='main-title'>Representative Set by Decade and Part Variety Tier</div>" &
			        _DecadeSections &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 99a9bb21-06f4-471b-b302-67fdb85b7e06

	column Value
		isHidden
		formatString: 0
		lineageTag: 9536d1f3-e247-4a87-9192-8cbab3d8930b
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = { BLANK() }

	annotation PBI_Id = 376588de630949899750b5f427626314

