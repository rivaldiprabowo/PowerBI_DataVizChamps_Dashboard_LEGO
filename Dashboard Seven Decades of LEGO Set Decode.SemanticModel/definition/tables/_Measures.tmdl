	measure 'HTML Image Main LEGO Set' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			VAR _ImageURL           = CALCULATE(MAX(sets[img_url]), 'sets'[set_number] = MAX('sets'[set_number]))
			
			-- Sizing (image capped at 300x300, container fills its visual)
			VAR _MaxSize            = 300           -- px, image never exceeds this in either dimension
			VAR _ObjectFit          = "contain"     -- "contain" | "cover" | "fill"
			VAR _BorderRadius       = 8             -- px, rounded corners
			
			-- Fade animation
			VAR _FadeDuration       = 0.8           -- seconds
			VAR _FadeDelay          = 0             -- seconds, delay before fade starts
			VAR _StartOpacity       = 0
			VAR _EndOpacity         = 1
			VAR _Easing             = "ease-out"    -- "ease-out" | "ease-in" | "ease-in-out" | "linear"
			
			-- Optional subtle motion (set both to 0/1 for pure fade, no motion)
			VAR _StartTranslateY    = 10            -- px, slides up as it fades in (0 = no slide)
			VAR _StartScale         = 1             -- 0.95 = subtle zoom-in effect (1 = no zoom)
			
			-- ============================================
			-- === HTML ASSEMBLY (do not edit) ============
			-- ============================================
			
			VAR _UID = "fadeimg" & RANDBETWEEN( 10000000, 99999999 )
			
			VAR _CSS =
			"<style>
			@keyframes " & _UID & "_fade {
			    from {
			        opacity: " & _StartOpacity & ";
			        transform: translateY(" & _StartTranslateY & "px) scale(" & _StartScale & ");
			    }
			    to {
			        opacity: " & _EndOpacity & ";
			        transform: translateY(0px) scale(1);
			    }
			}
			</style>"
			
			VAR _HTML =
			_CSS &
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    overflow:hidden;
			'>
			    <img src='" & _ImageURL & "' style='
			        max-width:" & _MaxSize & "px;
			        max-height:" & _MaxSize & "px;
			        width:100%;
			        height:100%;
			        object-fit:" & _ObjectFit & ";
			        border-radius:" & _BorderRadius & "px;
			        opacity:" & _StartOpacity & ";
			        animation:" & _UID & "_fade " & _FadeDuration & "s " & _Easing & " " & _FadeDelay & "s forwards;
			    ' />
			</div>"
			
			RETURN _HTML
		lineageTag: 55f693b1-00ad-47c2-b5c4-227d8c59119c

