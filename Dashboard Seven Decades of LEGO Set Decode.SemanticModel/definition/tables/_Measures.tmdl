	measure 'HTML Card Avg Age Color Active' =
			
			VAR EffectiveEndYear = MAX(dim_year[year])
			VAR PreviousEffectiveEndYear = EffectiveEndYear - 10
			
			VAR ActiveColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_release] <= EffectiveEndYear &&
			        colors[year_stop] >= EffectiveEndYear
			    )
			
			VAR ActiveColorsWithAge =
			    ADDCOLUMNS(
			        ActiveColors,
			        "Age", EffectiveEndYear - colors[year_release]
			    )
			
			VAR _RawValue = AVERAGEX(ActiveColorsWithAge, [Age])
			VAR _FormattedValue = ROUND(_RawValue, 1)
			
			VAR PreviousActiveColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_release] <= PreviousEffectiveEndYear &&
			        colors[year_stop] >= PreviousEffectiveEndYear
			    )
			VAR PreviousActiveColorsWithAge =
			    ADDCOLUMNS(
			        PreviousActiveColors,
			        "Age", PreviousEffectiveEndYear - colors[year_release]
			    )
			VAR _PreviousValue = ROUND(AVERAGEX(PreviousActiveColorsWithAge, [Age]), 1)
			
			VAR _Delta = _FormattedValue - _PreviousValue
			VAR _DeltaPct = DIVIDE(_Delta, _PreviousValue)
			VAR _IsFlat = _Delta = 0
			VAR _IsUp = _Delta > 0
			
			VAR _DeltaColor = "#5F6368"
			VAR _DeltaBg = "#F1F3F4"
			VAR _DeltaArrow ="&#9679"
			VAR _DeltaText =
			    SWITCH(
			        TRUE(),
			        MAX('dim_year'[decade]) = "1950s", "",
			        _IsFlat, _DeltaArrow & " (" & FORMAT(ABS(_Delta), "#,##0") & ")" & " No change vs last decade",
			        _DeltaArrow & " " & FORMAT(ABS(_Delta), "#,##0") & " (" & FORMAT(ABS(_DeltaPct), "0.0%") & ") vs last decade"
			    )
			
			VAR _UID = "c" & RANDBETWEEN( 10000000, 99999999 )
			VAR fontsize = 50
			VAR deltafontsize = 16
			VAR ValueToDeltaGap = 0
			VAR DeltaPillPaddingV = 2
			VAR DeltaPillPaddingH = 10
			VAR DeltaPillRadius = 12
			
			VAR _HTML =
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    align-items:flex-start;
			    justify-content:center;
			    font-family:Segoe UI, sans-serif;
			'>
			  <div id='" & _UID & "' style='
			      font-size:"& fontsize &"px;
			      font-weight:700;
			      color:#000000;
			      letter-spacing:1px;
			  '>0</div>
			
			  <div style='
			      margin-top:" & ValueToDeltaGap & "px;
			      display:inline-block;
			      font-size:" & deltafontsize & "px;
			      font-weight:600;
			      color:" & _DeltaColor & ";
			      background:" & _DeltaBg & ";
			      padding:" & DeltaPillPaddingV & "px " & DeltaPillPaddingH & "px;
			      border-radius:" & DeltaPillRadius & "px;
			  '>" & _DeltaText & "</div>
			
			  <img src='x' style='display:none' onerror=""
			    (function(){
			      var el = document.getElementById('" & _UID & "');
			      if (!el || el.getAttribute('data-animated') === 'true') return;
			      el.setAttribute('data-animated', 'true');
			
			      var target = " & _FormattedValue & ";
			      var duration = 1000;
			      var startTime = null;
			
			      function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
			      function formatNum(n){ return n.toFixed(1); }
			
			      function step(timestamp){
			        if (!startTime) startTime = timestamp;
			        var progress = Math.min((timestamp - startTime) / duration, 1);
			        var eased = easeOutCubic(progress);
			        el.textContent = formatNum(target * eased) + ' yrs';
			        if (progress < 1) {
			          requestAnimationFrame(step);
			        } else {
			          el.textContent = '" & _FormattedValue & "' + ' yrs';
			        }
			      }
			      requestAnimationFrame(step);
			    })();
			  "" />
			</div>"
			
			RETURN _HTML
		displayFolder: Page 3 Color
		lineageTag: 7c251fc6-52d5-4fe3-a022-8f140beb93fd

	measure 'HTML Total Parts Stacked Area' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _ChartWidth         = 900
			VAR _ChartHeight        = 435
			VAR _MarginTop          = 15
			VAR _MarginRight        = 17
			VAR _MarginBottom       = 45
			VAR _MarginLeft         = 45
			
			-- Typography
			VAR _FontFamily         = "Segoe UI, sans-serif"
			VAR _XAxisFontSize      = 13
			VAR _YAxisFontSize      = 13
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 16
			VAR _LegendTextColor    = "#666666"
			VAR _LegendSwatchSize   = 13            -- px, box size for legend swatches
			VAR _LegendGap          = 30            -- px, consistent visual gap between items
			VAR _TextSwatchGap      = 8             -- px, gap between swatch and its label
			VAR _LegendOffsetY      = 20            -- px, distance below x-axis labels
			VAR _LegendStartOffsetX = 0             -- px, horizontal offset from _MarginLeft
			
			-- Area styling
			VAR _AreaOpacity        = 0.70
			VAR _LineWidth          = 4
			VAR _DotRadius          = 2
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 1
			
			-- X-axis tick control
			VAR _MaxXTicks          = 20
			VAR _DecadeTickThreshold = 30           -- if year span > this, snap to decade ticks
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 20
			VAR _TooltipTextColor   = "#333333"
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- Animation
			VAR _AnimationDuration  = 800
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Years =
			    ADDCOLUMNS(
			        SUMMARIZE( dim_year, dim_year[year] ),
			        "@yearNum", dim_year[year]
			    )
			VAR _MinYear = MINX( _Years, [@yearNum] )
			VAR _MaxYear = MAXX( _Years, [@yearNum] )
			VAR _YearSpan = _MaxYear - _MinYear
			
			VAR _RawData =
			    ADDCOLUMNS(
			        _Years,
			        "@micro",  CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Micro" ),
			        "@small",  CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Small" ),
			        "@medium", CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Medium" ),
			        "@large",  CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Large" ),
			        "@mega",   CALCULATE( DISTINCTCOUNT( 'sets'[set_number] ), 'sets'[complexity_tier] = "Mega" )
			    )
			
			VAR _CumulativeData =
			    ADDCOLUMNS(
			        _RawData,
			        "@microVal",  IF( ISBLANK( [@micro] ), 0, [@micro] ),
			        "@smallVal",  IF( ISBLANK( [@small] ), 0, [@small] ),
			        "@mediumVal", IF( ISBLANK( [@medium] ), 0, [@medium] ),
			        "@largeVal",  IF( ISBLANK( [@large] ), 0, [@large] ),
			        "@megaVal",   IF( ISBLANK( [@mega] ), 0, [@mega] ),
			        "@y1", IF( ISBLANK( [@micro] ), 0, [@micro] ),
			        "@y2", IF( ISBLANK( [@micro] ), 0, [@micro] ) + IF( ISBLANK( [@small] ), 0, [@small] ),
			        "@y3", IF( ISBLANK( [@micro] ), 0, [@micro] ) + IF( ISBLANK( [@small] ), 0, [@small] ) + IF( ISBLANK( [@medium] ), 0, [@medium] ),
			        "@y4", IF( ISBLANK( [@micro] ), 0, [@micro] ) + IF( ISBLANK( [@small] ), 0, [@small] ) + IF( ISBLANK( [@medium] ), 0, [@medium] ) + IF( ISBLANK( [@large] ), 0, [@large] ),
			        "@y5", IF( ISBLANK( [@micro] ), 0, [@micro] ) + IF( ISBLANK( [@small] ), 0, [@small] ) + IF( ISBLANK( [@medium] ), 0, [@medium] ) + IF( ISBLANK( [@large] ), 0, [@large] ) + IF( ISBLANK( [@mega] ), 0, [@mega] )
			    )
			
			VAR _MaxTotal = MAXX( _CumulativeData, [@y5] )
			VAR _PlotWidth  = _ChartWidth  - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop  - _MarginBottom
			
			-- ============================================
			-- === SVG PATH GENERATION ====================
			-- ============================================
			
			VAR _MicroTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _MicroBottomY = _MarginTop + _PlotHeight
			VAR _MicroFillPath =
			    "M " & _MarginLeft & "," & _MicroBottomY & " " &
			    "L " & _MicroTop & " " &
			    "L " & ( _MarginLeft + _PlotWidth ) & "," & _MicroBottomY & " Z"
			
			VAR _SmallTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _SmallBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _SmallFillPath = "M " & _SmallTop & " L " & _SmallBottom & " Z"
			
			VAR _MediumTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _MediumBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _MediumFillPath = "M " & _MediumTop & " L " & _MediumBottom & " Z"
			
			VAR _LargeTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _LargeBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _LargeFillPath = "M " & _LargeTop & " L " & _LargeBottom & " Z"
			
			VAR _MegaTop =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], ASC
			    )
			VAR _MegaBottom =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN _X & "," & _Y,
			        " ",
			        [@yearNum], DESC
			    )
			VAR _MegaFillPath = "M " & _MegaTop & " L " & _MegaBottom & " Z"
			
			VAR _MicroLine  = "M " & _MicroTop
			VAR _SmallLine  = "M " & _SmallTop
			VAR _MediumLine = "M " & _MediumTop
			VAR _LargeLine  = "M " & _LargeTop
			VAR _MegaLine   = "M " & _MegaTop
			
			-- ============================================
			-- === DATA DOTS ==============================
			-- ============================================
			
			VAR _MicroDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y1] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorMicro & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _SmallDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y2] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorSmall & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _MediumDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y3] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorMedium & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _LargeDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y4] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorLarge & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _MegaDots =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _Y = _MarginTop + _PlotHeight - ( [@y5] / _MaxTotal ) * _PlotHeight
			        RETURN "<circle cx='" & _X & "' cy='" & _Y & "' r='" & _DotRadius & "' fill='" & _ColorMega & "' stroke='" & _DotStrokeColor & "' stroke-width='" & _DotStrokeWidth & "' />",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === HOVER TRACKER ==========================
			-- ============================================
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _CumulativeData,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _BandWidth = IF( _YearSpan = 0, _PlotWidth, _PlotWidth / _YearSpan )
			        VAR _BandX = _X - _BandWidth / 2
			        VAR _DataAttrs =
			            " data-year='" & [@yearNum] & "'" &
			            " data-micro='" & FORMAT( [@microVal], "#,0" ) & "'" &
			            " data-small='" & FORMAT( [@smallVal], "#,0" ) & "'" &
			            " data-medium='" & FORMAT( [@mediumVal], "#,0" ) & "'" &
			            " data-large='" & FORMAT( [@largeVal], "#,0" ) & "'" &
			            " data-mega='" & FORMAT( [@megaVal], "#,0" ) & "'" &
			            " data-total='" & FORMAT( [@y5], "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band' x='" & _BandX & "' y='" & _MarginTop & "' width='" & _BandWidth & "' height='" & _PlotHeight & "' fill='transparent'" & _DataAttrs & " />",
			        "",
			        [@yearNum], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS =================================
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR _T = [Value]
			        VAR _YVal = _MaxTotal * _T / 4
			        VAR _YPos = _MarginTop + _PlotHeight - ( _T / 4 ) * _PlotHeight
			        VAR _Label = FORMAT( _YVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & _YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & _YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( _YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & _Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (smart ticks: decades vs years) =
			-- ============================================
			-- If year span > _DecadeTickThreshold: snap to decade boundaries
			-- Otherwise: adaptive ticks based on _MaxXTicks
			
			VAR _UseDecadeTicks = _YearSpan > _DecadeTickThreshold
			
			-- Decade tick years (1950, 1960, 1970, ... within range)
			VAR _MinDecade = CEILING( _MinYear / 10, 1 ) * 10
			VAR _MaxDecade = FLOOR( _MaxYear / 10, 1 ) * 10
			VAR _DecadeCount = ( _MaxDecade - _MinDecade ) / 10 + 1
			
			VAR _DecadeTickYears =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            GENERATESERIES( 0, _DecadeCount - 1, 1 ),
			            "@yearCalc", _MinDecade + [Value] * 10
			        ),
			        "@yearNum", [@yearCalc]
			    )
			
			-- Adaptive tick years (for narrow ranges)
			VAR _YearCount = COUNTROWS( _CumulativeData )
			VAR _TickStep = MAX( 1, CEILING( DIVIDE( _YearCount, _MaxXTicks ), 1 ) )
			
			VAR _CumulativeIndexed =
			    ADDCOLUMNS(
			        _CumulativeData,
			        "@idx", RANKX( _CumulativeData, [@yearNum], , ASC, DENSE )
			    )
			
			VAR _AdaptiveTickYears =
			    SELECTCOLUMNS(
			        FILTER(
			            _CumulativeIndexed,
			            MOD( [@idx] - 1, _TickStep ) = 0 || [@yearNum] = _MaxYear
			        ),
			        "@yearNum", [@yearNum]
			    )
			
			-- Pick which tick set to use
			VAR _XTickYears =
			    UNION(
			        FILTER( _DecadeTickYears, _UseDecadeTicks ),
			        FILTER( _AdaptiveTickYears, NOT _UseDecadeTicks )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _XTickYears,
			        VAR _X = _MarginLeft + ( [@yearNum] - _MinYear ) / _YearSpan * _PlotWidth
			        VAR _YBottom = _MarginTop + _PlotHeight
			        RETURN
			            "<line x1='" & _X & "' y1='" & _YBottom &
			            "' x2='" & _X & "' y2='" & ( _YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & _X & "' y='" & ( _YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & [@yearNum] & "</text>",
			        "",
			        [@yearNum], ASC
			    )
			
			-- ============================================
			-- === LEGEND (evenly-spaced) =================
			-- ============================================
			
			VAR _CharWidth   = _LegendFontSize * 0.55
			VAR _WidthMicro  = 5 * _CharWidth
			VAR _WidthSmall  = 5 * _CharWidth
			VAR _WidthMedium = 6 * _CharWidth
			VAR _WidthLarge  = 5 * _CharWidth
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthMicro  + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthSmall  + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthMedium + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthLarge  + _LegendGap
			
			VAR _LegendY = _MarginTop + _PlotHeight + _LegendOffsetY + 20
			VAR _LegendStartX = _MarginLeft + _LegendStartOffsetX
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-family='" & _FontFamily & "' font-size='" & _LegendFontSize & "' fill='" & _LegendTextColor & "'>" &
			    "<rect x='" & _Pos1 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMicro & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Micro</text>" &
			    "<rect x='" & _Pos2 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSmall & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Small</text>" &
			    "<rect x='" & _Pos3 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMedium & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Medium</text>" &
			    "<rect x='" & _Pos4 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorLarge & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Large</text>" &
			    "<rect x='" & _Pos5 & "' y='" & ( -_LegendSwatchSize + 3 ) & "' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMega & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='0'>Mega</text>" &
			    "</g>"
			
			VAR _Baseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === REVEAL ANIMATION =======================
			-- ============================================
			
			VAR _RevealAnimation =
			"<clipPath id='reveal-clip'>
			    <rect x='" & _MarginLeft & "' y='0' width='0' height='" & _ChartHeight & "'>
			        <animate attributeName='width'
			                 from='0'
			                 to='" & _PlotWidth & "'
			                 dur='" & ( _AnimationDuration / 1000 ) & "s'
			                 fill='freeze'
			                 begin='0s' />
			    </rect>
			</clipPath>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band { cursor:crosshair; }
			#custom-tooltip {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip .tt-year { font-weight:700; margin-bottom:6px; font-size:20px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip .tt-label { display:flex; align-items:center; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML =
			"<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line');
			    var bands = document.querySelectorAll('.hover-band');
			    var colors = {
			        micro:  '" & _ColorMicro  & "',
			        small:  '" & _ColorSmall  & "',
			        medium: '" & _ColorMedium & "',
			        large:  '" & _ColorLarge  & "',
			        mega:   '" & _ColorMega   & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-year" & UNICHAR(34) & ">' + d.year + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.mega + '" & UNICHAR(34) & "></span>Mega</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.mega + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.large + '" & UNICHAR(34) & "></span>Large</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.large + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.medium + '" & UNICHAR(34) & "></span>Medium</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.medium + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.small + '" & UNICHAR(34) & "></span>Small</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.small + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.micro + '" & UNICHAR(34) & "></span>Micro</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.micro + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container'>
			    <svg xmlns='http://www.w3.org/2000/svg'
			         viewBox='0 0 " & _ChartWidth & " " & _ChartHeight & "'
			         preserveAspectRatio='xMidYMid meet'
			         style='width:100%;height:100%;'>
			        <defs>" & _RevealAnimation & "</defs>
			
			        " & _YAxisElements & "
			        " & _Baseline & "
			        " & _XAxisElements & "
			
			        <g clip-path='url(#reveal-clip)'>
			            <path d='" & _MicroFillPath  & "' fill='" & _ColorMicro  & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _SmallFillPath  & "' fill='" & _ColorSmall  & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _MediumFillPath & "' fill='" & _ColorMedium & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _LargeFillPath  & "' fill='" & _ColorLarge  & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			            <path d='" & _MegaFillPath   & "' fill='" & _ColorMega   & "' fill-opacity='" & _AreaOpacity & "' stroke='none' />
			
			            <path d='" & _MicroLine  & "' fill='none' stroke='" & _ColorMicro  & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _SmallLine  & "' fill='none' stroke='" & _ColorSmall  & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _MediumLine & "' fill='none' stroke='" & _ColorMedium & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _LargeLine  & "' fill='none' stroke='" & _ColorLarge  & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			            <path d='" & _MegaLine   & "' fill='none' stroke='" & _ColorMega   & "' stroke-width='" & _LineWidth & "' stroke-linejoin='round' />
			
			            " & _MicroDots  & "
			            " & _SmallDots  & "
			            " & _MediumDots & "
			            " & _LargeDots  & "
			            " & _MegaDots   & "
			        </g>
			
			        " & _HoverIndicator & "
			        " & _HoverTrackers & "
			        " & _Legend & "
			    </svg>
			" & _TooltipHTML & "
			</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: b6a81005-5cdb-4fb6-a5d3-e0ecb8d271be

	measure 'HTML Minifig Grid' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Typography
			VAR _FontFamily          = "Segoe UI, sans-serif"
			
			VAR _MainTitleSize       = 23
			VAR _MainTitleWeight     = 700
			VAR _MainTitleColor      = "#000000"
			VAR _MainTitleGap        = 15
			
			VAR _DecadeTitleSize     = 26
			VAR _DecadeTitleWeight   = 800
			VAR _DecadeTitleColor    = "#000000"
			VAR _DecadeTitleBg       = "#F2F2F2"
			VAR _DecadeTitlePadY     = 14
			VAR _DecadeTitlePadX     = 18
			VAR _DecadeTitleRadius   = 10
			VAR _DecadeLabelWidth    = 140
			VAR _DecadeLabelGap      = 18
			
			VAR _TierHeaderFontSize  = 22
			VAR _TierHeaderWeight    = 700
			VAR _SetNameFontSize     = 21
			VAR _SetNameWeight       = 600
			VAR _SetNameColor        = "#222222"
			VAR _PartFontSize        = 18
			VAR _PartFontWeight      = 700
			VAR _AvgFontSize         = 18
			VAR _AvgFontWeight       = 600
			VAR _AvgColor            = "#6B6B6B"
			
			-- Card layout
			VAR _CardWidth           = 330
			VAR _CardMinHeight       = 100
			VAR _CardBorderRadius    = 10
			VAR _CardPadding         = 20
			VAR _CardGap             = 20
			VAR _CardBorderWidth     = 2
			VAR _ImageHeight         = 100
			
			-- Gradient opacity
			VAR _GradientTopOpacity  = 0.20
			VAR _GradientMidOpacity  = 0.10
			VAR _GradientBotOpacity  = 0.00
			
			-- Decade section spacing
			VAR _DecadeSpacing       = 32
			
			-- Container padding
			VAR _ContainerPad        = 5
			
			-- Tier colors
			VAR _ColorNone           = "#9E9E9E"
			VAR _ColorSolo           = "#CFEFEA"
			VAR _ColorSmallCrew      = "#E8D1A8"
			VAR _ColorSquad          = "#B18FCF"
			VAR _ColorLargeCast      = "#F07F5A"
			
			-- Tier range labels (matches minifig_tier thresholds)
			VAR _RangeNone           = "0"
			VAR _RangeSolo           = "1"
			VAR _RangeSmallCrew      = "2-3"
			VAR _RangeSquad          = "4-6"
			VAR _RangeLargeCast      = ">6"
			
			-- Card row width lock
			VAR _TierCountForWidth   = 5
			VAR _RowFullWidth        = _CardWidth * _TierCountForWidth + _CardGap * ( _TierCountForWidth - 1 )
			
			-- ============================================
			-- === CSS ====================================
			-- ============================================
			
			VAR _CSS =
			"<style>
			html, body { margin:0; padding:0; overflow-y:auto; overflow-x:hidden; font-family:" & _FontFamily & "; }
			.container { padding:" & _ContainerPad & "px; box-sizing:border-box; }
			.main-title {
			    font-size:" & _MainTitleSize & "px;
			    font-weight:" & _MainTitleWeight & ";
			    color:" & _MainTitleColor & ";
			    margin-bottom:" & _MainTitleGap & "px;
			    line-height:1.2;
			}
			.decade-section {
			    display:flex;
			    flex-direction:row;
			    align-items:stretch;
			    gap:" & _DecadeLabelGap & "px;
			    margin-bottom:" & _DecadeSpacing & "px;
			}
			.decade-title {
			    width:" & _DecadeLabelWidth & "px;
			    flex-shrink:0;
			    box-sizing:border-box;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    font-size:" & _DecadeTitleSize & "px;
			    font-weight:" & _DecadeTitleWeight & ";
			    color:" & _DecadeTitleColor & ";
			    background:" & _DecadeTitleBg & ";
			    padding:" & _DecadeTitlePadY & "px " & _DecadeTitlePadX & "px;
			    border-radius:" & _DecadeTitleRadius & "px;
			    text-align:center;
			}
			.card-row {
			    display:flex;
			    flex-direction:row;
			    flex-wrap:wrap;
			    gap:" & _CardGap & "px;
			    justify-content:flex-start;
			    width:" & _RowFullWidth & "px;
			    max-width:100%;
			}
			.tier-card {
			    width:" & _CardWidth & "px;
			    min-height:" & _CardMinHeight & "px;
			    border-radius:" & _CardBorderRadius & "px;
			    padding:" & _CardPadding & "px;
			    display:flex;
			    flex-direction:column;
			    align-items:center;
			    box-sizing:border-box;
			}
			.tier-header {
			    font-size:" & _TierHeaderFontSize & "px;
			    font-weight:" & _TierHeaderWeight & ";
			    text-align:center;
			    margin-bottom:14px;
			    line-height:1.2;
			}
			.tier-image-wrap {
			    height:" & _ImageHeight & "px;
			    display:flex;
			    align-items:center;
			    justify-content:center;
			    margin-bottom:16px;
			    width:100%;
			}
			.tier-image-wrap img {
			    max-height:" & _ImageHeight & "px;
			    max-width:100%;
			    display:block;
			}
			.tier-name {
			    font-size:" & _SetNameFontSize & "px;
			    font-weight:" & _SetNameWeight & ";
			    color:" & _SetNameColor & ";
			    text-align:center;
			    margin-bottom:8px;
			    line-height:1.25;
			}
			.tier-parts {
			    font-size:" & _PartFontSize & "px;
			    font-weight:" & _PartFontWeight & ";
			    text-align:center;
			    margin-bottom:6px;
			    line-height:1.2;
			}
			.tier-avg {
			    font-size:" & _AvgFontSize & "px;
			    font-weight:" & _AvgFontWeight & ";
			    color:" & _AvgColor & ";
			    text-align:center;
			    line-height:1.2;
			}
			</style>"
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Tiers =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            ALL( sets[minifig_tier], sets[minifig_tier_order] ),
			            "@order", sets[minifig_tier_order]
			        ),
			        "Tier", sets[minifig_tier],
			        "TierOrder", [@order]
			    )
			
			VAR _Decades =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            SUMMARIZE( sets, sets[decade] ),
			            "@order", sets[decade]
			        ),
			        "Decade", sets[decade],
			        "DecadeOrder", [@order]
			    )
			
			-- ============================================
			-- === BUILD DECADE SECTIONS ==================
			-- ============================================
			
			VAR _DecadeSections =
			    CONCATENATEX(
			        _Decades,
			        VAR _Decade    = [Decade]
			        VAR _DecadeOrd = [DecadeOrder]
			
			        VAR _Cards =
			            CONCATENATEX(
			                _Tiers,
			                VAR _Tier      = [Tier]
			                VAR _TierOrder = [TierOrder]
			
			                VAR _TierColor =
			                    SWITCH(
			                        _Tier,
			                        "None",        _ColorNone,
			                        "Solo",        _ColorSolo,
			                        "Small Crew",  _ColorSmallCrew,
			                        "Squad",       _ColorSquad,
			                        "Large Cast",  _ColorLargeCast,
			                        "#808080"
			                    )
			
			                VAR _TierRange =
			                    SWITCH(
			                        _Tier,
			                        "None",        _RangeNone,
			                        "Solo",        _RangeSolo,
			                        "Small Crew",  _RangeSmallCrew,
			                        "Squad",       _RangeSquad,
			                        "Large Cast",  _RangeLargeCast,
			                        ""
			                    )
			
			                -- Hex to RGB via position math
			                VAR _HexChars = "0123456789ABCDEF"
			                VAR _RHex = UPPER( MID( _TierColor, 2, 2 ) )
			                VAR _GHex = UPPER( MID( _TierColor, 4, 2 ) )
			                VAR _BHex = UPPER( MID( _TierColor, 6, 2 ) )
			                VAR _R =
			                    ( FIND( LEFT( _RHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _RHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _G =
			                    ( FIND( LEFT( _GHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _GHex, 1 ), _HexChars, 1, 1 ) - 1 )
			                VAR _B =
			                    ( FIND( LEFT( _BHex, 1 ),  _HexChars, 1, 1 ) - 1 ) * 16
			                    + ( FIND( RIGHT( _BHex, 1 ), _HexChars, 1, 1 ) - 1 )
			
			                VAR _RgbTriplet = _R & "," & _G & "," & _B
			
			                VAR _Gradient =
			                    "linear-gradient(180deg, rgba(" & _RgbTriplet & "," & _GradientTopOpacity &
			                    ") 0%, rgba(" & _RgbTriplet & "," & _GradientMidOpacity &
			                    ") 55%, rgba(" & _RgbTriplet & "," & _GradientBotOpacity & ") 100%)"
			
			                -- Representative set: raw text combines name + "(N)" like the matrix version
			                VAR _RawText =
			                    CALCULATE(
			                        [Minifigs Set Name],
			                        ALL( sets[decade], sets[minifig_tier] ),
			                        sets[decade] = _Decade,
			                        sets[minifig_tier] = _Tier
			                    )
			
			                VAR _NewlinePos = FIND( UNICHAR(10), _RawText, 1, 0 )
			                VAR _BoxArtName =
			                    IF(
			                        _NewlinePos > 0,
			                        LEFT( _RawText, _NewlinePos - 1 ),
			                        _RawText
			                    )
			
			                VAR _OpenParen  = FIND( "(", _RawText, 1, 0 )
			                VAR _CloseParen = FIND( ")", _RawText, 1, 0 )
			                VAR _MinifigCountText =
			                    IF(
			                        _OpenParen > 0 && _CloseParen > _OpenParen,
			                        MID( _RawText, _OpenParen + 1, _CloseParen - _OpenParen - 1 ),
			                        ""
			                    )
			
			                VAR _BoxArtURL =
			                    CALCULATE(
			                        [Minifigs Set Image],
			                        ALL( sets[decade], sets[minifig_tier] ),
			                        sets[decade] = _Decade,
			                        sets[minifig_tier] = _Tier
			                    )
			
			                VAR _AvgMinifigs =
			                    CALCULATE(
			                        AVERAGE( sets[total_minifigs] ),
			                        sets[minifig_tier] = _Tier,
			                        ALL( sets[decade] ),
			                        sets[decade] = _Decade
			                    )
			
			                VAR _HasData = NOT ISBLANK( _RawText )
			
			                VAR _CardHTML =
			                    "<div class='tier-card' style='background:" & _Gradient &
			                    ";border:" & _CardBorderWidth & "px solid " & _TierColor & ";'>
			                        <div class='tier-header' style='color:" & _TierColor & ";'>" &
			                            UPPER( _Tier ) & " (" & _TierRange & ")" &
			                        "</div>
			                        <div class='tier-image-wrap'>
			                            <img src='" & _BoxArtURL & "' />
			                        </div>
			                        <div class='tier-name'>" & _BoxArtName & "</div>
			                        <div class='tier-parts' style='color:" & _TierColor & ";'>" &
			                            _MinifigCountText & " minifigures" &
			                        "</div>
			                        <div class='tier-avg'>Avg minifigures per set: " & FORMAT( _AvgMinifigs, "#,0.0" ) & "</div>
			                    </div>"
			
			                RETURN IF( _HasData, _CardHTML, "" ),
			                "",
			                [TierOrder], ASC
			            )
			
			        RETURN
			            "<div class='decade-section'>
			                <div class='decade-title'>" & _Decade & "</div>
			                <div class='card-row'>" & _Cards & "</div>
			            </div>",
			        "",
			        [DecadeOrder], DESC
			    )
			
			-- ============================================
			-- === FINAL HTML =============================
			-- ============================================
			
			VAR _HTML =
			    _CSS &
			    "<div class='container'>
			        <div class='main-title'>Representative Set by Decade and Minifig Tier</div>" &
			        _DecadeSections &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 408e93ae-4889-4dac-986c-05f8e1528348

	measure 'Total Color' =
			
			VAR max_year = MAX('dim_year'[year])
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(colors[Color]),
			    ALL('dim_year'),
			    USERELATIONSHIP('dim_year'[year],'colors'[year_release]),
			    'dim_year'[year] <= max_year
			)
		formatString: 0
		lineageTag: 071466af-1240-4ca1-af63-9dbc02baa68b

	measure 'Color Set Image' =
			
			VAR CurrentCount = MAX ( sets[total_colors] )
			RETURN
			IF (
			    ISBLANK ( CurrentCount ),
			    BLANK (),
			    VAR TopSet =
			        TOPN (
			            1,
			            CALCULATETABLE (
			                sets,
			                ALLEXCEPT ( sets, sets[decade], sets[color_variety_tier] )
			            ),
			            sets[total_colors], DESC,
			            sets[set_name], ASC
			        )
			    RETURN
			        MAXX ( TopSet, sets[img_url] )
			)
		lineageTag: 2e67e692-a570-463b-acf4-a003b78993b1

	measure 'Color Set Name' =
			
			VAR CurrentCount =
			    MAX(sets[total_colors])
			
			RETURN
			IF(
			    ISBLANK(CurrentCount),
			    BLANK(),
			
			    VAR TopSet =
			        TOPN(
			            1,
			            CALCULATETABLE(
			                sets,
			                ALLEXCEPT(
			                    sets,
			                    sets[decade],
			                    sets[color_variety_tier]
			                )
			            ),
			            sets[total_colors], DESC,
			            sets[set_name], ASC
			        )
			
			    RETURN
			        MAXX(TopSet, sets[set_name])
			            & UNICHAR(10)
			            & " ("
			            & MAXX(TopSet, sets[total_colors])
			            & ") Color(s)"
			)
		lineageTag: cfbdab56-88ed-44ab-ba48-559cdc5de633

	measure 'Minifigs Set Image' =
			
			VAR CurrentCount = MAX ( sets[total_minifigs] )
			RETURN
			IF (
			    ISBLANK ( CurrentCount ),
			    BLANK (),
			    VAR TopSet =
			        TOPN (
			            1,
			            CALCULATETABLE (
			                sets,
			                ALLEXCEPT ( sets, sets[decade], sets[minifig_tier] )
			            ),
			            sets[total_minifigs], DESC,
			            sets[number_of_parts], DESC,
			            sets[set_name], ASC
			        )
			    RETURN
			        MAXX ( TopSet, sets[First Minifig Image] )
			)
		displayFolder: Page 2 Parts
		lineageTag: b9260e63-121f-4e00-ae32-d793d786db6b

	measure 'Minifigs Set Name' =
			
			VAR CurrentCount =
			    MAX(sets[total_minifigs])
			
			RETURN
			IF(
			    ISBLANK(CurrentCount),
			    BLANK(),
			
			    VAR TopSet =
			        TOPN(
			            1,
			            CALCULATETABLE(
			                sets,
			                ALLEXCEPT(
			                    sets,
			                    sets[decade],
			                    sets[minifig_tier]
			                )
			            ),
			            sets[total_minifigs], DESC,
			            sets[number_of_parts], DESC,
			            sets[set_name], ASC
			        )
			
			    RETURN
			        MAXX(TopSet, sets[set_name])
			            & UNICHAR(10)
			            & " ("
			            & MAXX(TopSet, sets[total_minifigs])
			            & ") Minifigures"
			)
		displayFolder: Page 2 Parts
		lineageTag: 651c6c91-d6aa-4a0b-9772-1779cda5e4b7

	measure 'HTML Radar LEGO DNA' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _SvgWidth           = 600
			VAR _SvgHeight          = 460
			VAR _CenterX            = 300
			VAR _CenterY            = 250
			VAR _Radius             = 175
			
			-- Rings
			VAR _NumRings           = 5
			VAR _RingColor          = "#D0DAE8"
			VAR _RingWidth          = 1
			VAR _AxisLineColor      = "#B8C4D6"
			VAR _AxisLineWidth      = 1
			
			-- Data polygon
			VAR _DataStrokeColor    = "#2563EB"
			VAR _DataStrokeWidth    = 3
			VAR _GradientStartColor = "#60A5FA"
			VAR _GradientEndColor   = "#1E40AF"
			
			-- Data point dots
			VAR _DotRadius          = 6
			VAR _DotFillColor       = "#2563EB"
			VAR _DotStrokeColor     = "#FFFFFF"
			VAR _DotStrokeWidth     = 2
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _AxisLabelFontSize  = 15                -- axis title font size
			VAR _AxisLabelWeight    = 700               -- 400=normal, 700=bold
			VAR _AxisLabelStyle     = "normal"          -- "normal" | "italic"
			VAR _AxisLabelColor     = "#1F2937"
			VAR _AxisValueFontSize  = 15                -- score value font size
			VAR _AxisValueWeight    = 700
			VAR _AxisValueStyle     = "normal"          -- "normal" | "italic"
			VAR _AxisValueColor     = "#2563EB"
			VAR _LabelOffset        = 32
			
			-- Animation (radial reveal from center)
			VAR _AnimDuration       = 1.2               -- seconds for polygon to draw in
			VAR _DotAnimDelay       = 1.2               -- when dots appear
			VAR _DotAnimDuration    = 0.3               -- dot fade-in duration
			
			-- ============================================
			-- === DATA (tier -> 1-5 score mapping) =======
			-- ============================================
			
			VAR _ComplexityTier    = SELECTEDVALUE( sets[complexity_tier] )
			VAR _ColorVarietyTier  = SELECTEDVALUE( sets[color_variety_tier] )
			VAR _PartVarietyTier   = SELECTEDVALUE( sets[part_variety_tier] )
			VAR _MinifigTier       = SELECTEDVALUE( sets[minifig_tier] )
			VAR _ColorAgeTier      = SELECTEDVALUE( sets[color_age_tier] )
			
			VAR _ComplexityScore =
			    SWITCH(
			        _ComplexityTier,
			        "Micro", 1, "Small", 2, "Medium", 3, "Large", 4, "Mega", 5, 0
			    )
			VAR _ColorVarietyScore =
			    SWITCH(
			        _ColorVarietyTier,
			        "Minimal", 1, "Basic", 2, "Balanced", 3, "Colorful", 4, "Rainbow", 5, 0
			    )
			VAR _PartVarietyScore =
			    SWITCH(
			        _PartVarietyTier,
			        "None", 0, "Simple Build", 1, "Mixed Build", 2, "Varied Build", 3, "Complex Assembly", 4, 0
			    )
			VAR _MinifigScore =
			    SWITCH(
			        _MinifigTier,
			        "None", 0, "Solo", 1, "Small Crew", 2, "Squad", 3, "Large Cast", 4, 0
			    )
			VAR _ColorAgeScore =
			    SWITCH(
			        _ColorAgeTier,
			        "None", 0, "Young Age", 1, "Modern Age", 2, "Mature Age", 3, "Old Age", 4, 0
			    )
			
			-- ============================================
			-- === AXIS DEFINITIONS =======================
			-- ============================================
			
			VAR _Axes =
			    DATATABLE(
			        "AxisIdx", INTEGER,
			        "Label", STRING,
			        "MaxScore", INTEGER,
			        {
			            { 1, "Set Complexity", 5 },
			            { 2, "Color Variety",  5 },
			            { 3, "Part Variety",   4 },
			            { 4, "Minifigures",    4 },
			            { 5, "Avg Color Age",  4 }
			        }
			    )
			
			VAR _AxesWithScores =
			    ADDCOLUMNS(
			        _Axes,
			        "@score",
			            SWITCH(
			                [AxisIdx],
			                1, _ComplexityScore,
			                2, _ColorVarietyScore,
			                3, _PartVarietyScore,
			                4, _MinifigScore,
			                5, _ColorAgeScore,
			                0
			            )
			    )
			
			VAR _Pi = 3.14159265358979
			VAR _AngleStep = 2 * _Pi / 5
			
			-- ============================================
			-- === RING POLYGONS ==========================
			-- ============================================
			
			VAR _RingList = GENERATESERIES( 1, _NumRings, 1 )
			
			VAR _Rings =
			    CONCATENATEX(
			        _RingList,
			        VAR RingIdx = [Value]
			        VAR RingRadius = ( RingIdx / _NumRings ) * _Radius
			        VAR RingPoints =
			            CONCATENATEX(
			                GENERATESERIES( 1, 5, 1 ),
			                VAR I = [Value]
			                VAR Angle = -_Pi / 2 + ( I - 1 ) * _AngleStep
			                VAR Px = _CenterX + RingRadius * COS( Angle )
			                VAR Py = _CenterY + RingRadius * SIN( Angle )
			                RETURN Px & "," & Py,
			                " "
			            )
			        RETURN
			            "<polygon points='" & RingPoints & "' fill='none' stroke='" & _RingColor & "' stroke-width='" & _RingWidth & "' />",
			        ""
			    )
			
			-- ============================================
			-- === AXIS LINES =============================
			-- ============================================
			
			VAR _AxisLines =
			    CONCATENATEX(
			        GENERATESERIES( 1, 5, 1 ),
			        VAR I = [Value]
			        VAR Angle = -_Pi / 2 + ( I - 1 ) * _AngleStep
			        VAR Ex = _CenterX + _Radius * COS( Angle )
			        VAR Ey = _CenterY + _Radius * SIN( Angle )
			        RETURN
			            "<line x1='" & _CenterX & "' y1='" & _CenterY & "' x2='" & Ex & "' y2='" & Ey &
			            "' stroke='" & _AxisLineColor & "' stroke-width='" & _AxisLineWidth & "' />",
			        ""
			    )
			
			-- ============================================
			-- === AXIS LABELS + SCORE VALUES =============
			-- ============================================
			
			VAR _AxisLabels =
			    CONCATENATEX(
			        _AxesWithScores,
			        VAR I = [AxisIdx]
			        VAR Angle = -_Pi / 2 + ( I - 1 ) * _AngleStep
			        VAR LabelDist = _Radius + _LabelOffset
			        VAR Lx = _CenterX + LabelDist * COS( Angle )
			        VAR Ly = _CenterY + LabelDist * SIN( Angle )
			        VAR TextAnchor =
			            SWITCH(
			                TRUE(),
			                ABS( COS( Angle ) ) < 0.3, "middle",
			                COS( Angle ) > 0, "start",
			                "end"
			            )
			        RETURN
			            "<text x='" & Lx & "' y='" & Ly &
			            "' text-anchor='" & TextAnchor & "' font-family='" & _FontFamily &
			            "' font-size='" & _AxisLabelFontSize & "' font-weight='" & _AxisLabelWeight &
			            "' font-style='" & _AxisLabelStyle &
			            "' fill='" & _AxisLabelColor & "'>" & [Label] & "</text>" &
			            "<text x='" & Lx & "' y='" & ( Ly + _AxisLabelFontSize + 4 ) &
			            "' text-anchor='" & TextAnchor & "' font-family='" & _FontFamily &
			            "' font-size='" & _AxisValueFontSize & "' font-weight='" & _AxisValueWeight &
			            "' font-style='" & _AxisValueStyle &
			            "' fill='" & _AxisValueColor & "'>" & [@score] & " / " & [MaxScore] & "</text>",
			        "",
			        [AxisIdx], ASC
			    )
			
			-- ============================================
			-- === DATA POLYGON POINTS ====================
			-- ============================================
			
			VAR _DataPoints =
			    CONCATENATEX(
			        _AxesWithScores,
			        VAR I = [AxisIdx]
			        VAR NormScore = DIVIDE( [@score], [MaxScore] )
			        VAR PointRadius = NormScore * _Radius
			        VAR Angle = -_Pi / 2 + ( I - 1 ) * _AngleStep
			        VAR Px = _CenterX + PointRadius * COS( Angle )
			        VAR Py = _CenterY + PointRadius * SIN( Angle )
			        RETURN Px & "," & Py,
			        " ",
			        [AxisIdx], ASC
			    )
			
			-- ============================================
			-- === DATA POINT DOTS ========================
			-- ============================================
			
			VAR _DataDots =
			    CONCATENATEX(
			        _AxesWithScores,
			        VAR I = [AxisIdx]
			        VAR NormScore = DIVIDE( [@score], [MaxScore] )
			        VAR PointRadius = NormScore * _Radius
			        VAR Angle = -_Pi / 2 + ( I - 1 ) * _AngleStep
			        VAR Px = _CenterX + PointRadius * COS( Angle )
			        VAR Py = _CenterY + PointRadius * SIN( Angle )
			        VAR DotDelay = _DotAnimDelay + ( I - 1 ) * 0.08
			        RETURN
			            "<circle cx='" & Px & "' cy='" & Py & "' r='" & _DotRadius &
			            "' fill='" & _DotFillColor & "' stroke='" & _DotStrokeColor &
			            "' stroke-width='" & _DotStrokeWidth & "' opacity='0'>" &
			            "<animate attributeName='opacity' from='0' to='1' begin='" & DotDelay &
			            "s' dur='" & _DotAnimDuration & "s' fill='freeze' />" &
			            "<title>" & [Label] & ": " & [@score] & " / " & [MaxScore] & "</title></circle>",
			        "",
			        [AxisIdx], ASC
			    )
			
			-- ============================================
			-- === GRADIENT + RADIAL REVEAL CLIP ==========
			-- ============================================
			
			VAR _Gradient =
			    "<defs>
			        <radialGradient id='radar-gradient' cx='50%' cy='50%' r='50%'>
			            <stop offset='0%'   stop-color='" & _GradientEndColor   & "' stop-opacity='0.7' />
			            <stop offset='100%' stop-color='" & _GradientStartColor & "' stop-opacity='0.4' />
			        </radialGradient>
			        <clipPath id='radar-reveal'>
			            <circle cx='" & _CenterX & "' cy='" & _CenterY & "' r='0'>
			                <animate attributeName='r' from='0' to='" & _Radius & "'
			                         dur='" & _AnimDuration & "s'
			                         fill='freeze'
			                         calcMode='spline'
			                         keySplines='0.22 1 0.36 1' />
			            </circle>
			        </clipPath>
			    </defs>"
			
			-- ============================================
			-- === DATA POLYGON (with reveal animation) ===
			-- ============================================
			
			VAR _DataPolygon =
			    "<g clip-path='url(#radar-reveal)'>" &
			    "<polygon points='" & _DataPoints & "' fill='url(#radar-gradient)' " &
			    "stroke='" & _DataStrokeColor & "' stroke-width='" & _DataStrokeWidth &
			    "' stroke-linejoin='round' />" &
			    "</g>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			"<div style='width:100%;height:100%;overflow:hidden;'>" &
			"<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight & "' " &
			"style='width:100%;height:100%;display:block' " &
			"preserveAspectRatio='xMidYMid meet' xmlns='http://www.w3.org/2000/svg'>" &
			_Gradient &
			"<g>" & _Rings & "</g>" &
			"<g>" & _AxisLines & "</g>" &
			_DataPolygon &
			"<g>" & _DataDots & "</g>" &
			"<g>" & _AxisLabels & "</g>" &
			"</svg>" &
			"</div>"
			
			RETURN _HTML
		lineageTag: b8db2b08-6a7b-42b7-84d9-6f3df1fd2683

