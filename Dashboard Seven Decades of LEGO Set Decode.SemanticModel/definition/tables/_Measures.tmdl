	measure 'HTML Definition Card Total Set' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR DefinitionText     = "A Total Set refers to any unique LEGO product identified by its own set number."
			
			-- Padding control — distance between the card's edge/border and its content, per side
			VAR PaddingTop         = 0
			VAR PaddingRight       = 0
			VAR PaddingBottom      = 0
			VAR PaddingLeft        = 0
			
			VAR BackBg             = "#0162D3"
			VAR BackTextColor      = "#FFFFFF"
			VAR BackBorderRadius   = 10
			
			VAR FontFamily         = "'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif"
			VAR DefinitionFontSize = 15
			
			VAR FlipDuration       = 0.5
			
			-- ============================================
			-- === HTML ASSEMBLY (do not edit) ============
			-- ============================================
			
			VAR PaddingCSS = PaddingTop & "px " & PaddingRight & "px " & PaddingBottom & "px " & PaddingLeft & "px"
			
			RETURN
			"<!DOCTYPE html>
			<html style='background: transparent !important; margin:0; padding:0; overflow:hidden;'>
			<head>
			    <style>
			        * { box-sizing: border-box; margin: 0; padding: 0; }
			
			        /* Kill scrollbars at every level */
			        html, body {
			            background: transparent !important;
			            width: 100%;
			            height: 100%;
			            overflow: hidden !important;
			            scrollbar-width: none;           /* Firefox */
			            -ms-overflow-style: none;        /* Legacy Edge/IE */
			        }
			        html::-webkit-scrollbar,
			        body::-webkit-scrollbar {
			            display: none !important;
			            width: 0 !important;
			            height: 0 !important;
			        }
			
			        body {
			            font-family: " & FontFamily & ";
			            position: relative;
			        }
			
			        .card-container {
			            position: absolute;
			            top: 0; left: 0;
			            width: 100%;
			            height: 100%;
			            background: transparent !important;
			            overflow: hidden;
			        }
			
			        .card-face {
			            position: absolute;
			            top: 0; left: 0;
			            width: 100%;
			            height: 100%;
			            border-radius: " & BackBorderRadius & "px;
			            padding: " & PaddingCSS & ";
			            display: flex;
			            flex-direction: column;
			            overflow: hidden;
			            transition: transform " & FlipDuration & "s cubic-bezier(0.4,0,0.2,1),
			                        opacity " & (FlipDuration - 0.1) & "s cubic-bezier(0.4,0,0.2,1);
			        }
			
			        .card-front {
			            background: transparent !important;
			            transform: translateY(0);
			            opacity: 1;
			            z-index: 2;
			        }
			
			        .card-back {
			            background: " & BackBg & ";
			            color: " & BackTextColor & ";
			            z-index: 1;
			            transform: translateY(100%);
			            opacity: 0;
			        }
			
			        body:hover .card-front { transform: translateY(-100%); opacity: 0; }
			        body:hover .card-back  { transform: translateY(0); opacity: 1; }
			
			        .back-definition {
			            font-size: " & DefinitionFontSize & "px;
			            line-height: 1.6;
			            opacity: 0.95;
			            text-align: justify;
			            word-wrap: break-word;
			            overflow-wrap: break-word;
			            overflow: hidden;
			            flex: 1;
			            scrollbar-width: none;
			            -ms-overflow-style: none;
			        }
			        .back-definition::-webkit-scrollbar {
			            display: none !important;
			            width: 0 !important;
			            height: 0 !important;
			        }
			    </style>
			</head>
			<body>
			    <div class='card-container'>
			        <div class='card-face card-front'></div>
			        <div class='card-face card-back'>
			            <div class='back-definition'>" & DefinitionText & "</div>
			        </div>
			    </div>
			</body>
			</html>"
		displayFolder: Page 1 History
		lineageTag: f9a815cb-19c1-49c3-9a5f-e77fc39da3ea

