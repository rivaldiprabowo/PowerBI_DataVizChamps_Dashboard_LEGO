	measure 'HTML Color Swatches' =
			
			VAR FontFamily     = "'Segoe UI'"
			VAR SwatchSize     = 35           -- px, size of each color box
			VAR SwatchGap      = 4            -- px, space between swatches
			VAR SwatchRadius   = 3            -- px, rounded corners
			VAR SwatchBorder   = "#DDDDDD"    -- border color around each swatch
			
			VAR _RawColors = CALCULATE(MAX(sets[set_colors_rgb]), 'sets'[set_number] = MAX('sets'[set_number]))
			VAR _CleanTxt  = SUBSTITUTE(TRIM(_RawColors), "||", "|")
			VAR _Txt       = IF(LEFT(_CleanTxt, 1) = "|", MID(_CleanTxt, 2, LEN(_CleanTxt) - 1), _CleanTxt)
			VAR _NumTokens = IF(_Txt = "" || ISBLANK(_Txt), 0, PATHLENGTH(_Txt))
			
			VAR _ColorList =
			    ADDCOLUMNS(
			        GENERATESERIES(1, _NumTokens, 1),
			        "HexValue", PATHITEM(_Txt, [Value], TEXT)
			    )
			
			VAR _Swatches =
			    CONCATENATEX(
			        _ColorList,
			        "<span style='
			            display:inline-block;
			            width:" & SwatchSize & "px;
			            height:" & SwatchSize & "px;
			            margin-right:" & SwatchGap & "px;
			            border-radius:" & SwatchRadius & "px;
			            border:1px solid " & SwatchBorder & ";
			            background:#" & [HexValue] & ";
			        ' title='#" & [HexValue] & "'></span>",
			        "",
			        [Value], ASC
			    )
			
			VAR _HTML =
			"<div style='display:flex;flex-wrap:wrap;align-items:center;font-family:" & FontFamily & ";'>" &
			    _Swatches &
			"</div>"
			
			RETURN _HTML
		lineageTag: 992df0d1-cd95-42e8-8ad3-2bcd874f4f48

	measure 'HTML Image Minifigure' =
			
			VAR FontFamily     = "'Segoe UI'"
			VAR ImgSize        = 40           -- px, size of each thumbnail
			VAR ImgGap         = 4            -- px, space between thumbnails
			VAR ImgRadius      = 4            -- px, rounded corners
			VAR ImgBorder      = "#DDDDDD"    -- border color around each thumbnail
			
			VAR _RawImages = CALCULATE(MAX(sets[mini_figures_images]), 'sets'[set_number] = MAX('sets'[set_number]))
			VAR _CleanTxt  = SUBSTITUTE(TRIM(_RawImages), "||", "|")
			VAR _Txt       = IF(LEFT(_CleanTxt, 1) = "|", MID(_CleanTxt, 2, LEN(_CleanTxt) - 1), _CleanTxt)
			VAR _NumTokens = IF(_Txt = "" || ISBLANK(_Txt), 0, PATHLENGTH(_Txt))
			
			VAR _ImageList =
			    ADDCOLUMNS(
			        GENERATESERIES(1, _NumTokens, 1),
			        "ImgURL", PATHITEM(_Txt, [Value], TEXT)
			    )
			
			VAR _Thumbnails =
			    CONCATENATEX(
			        _ImageList,
			        "<img src='" & [ImgURL] & "' loading='lazy' style='
			            width:" & ImgSize & "px;
			            height:" & ImgSize & "px;
			            margin-right:" & ImgGap & "px;
			            border-radius:" & ImgRadius & "px;
			            border:1px solid " & ImgBorder & ";
			            object-fit:contain;
			            background:#FFFFFF;
			        ' />",
			        "",
			        [Value], ASC
			    )
			
			VAR _HTML =
			"<div style='display:flex;flex-wrap:wrap;align-items:center;font-family:" & FontFamily & ";'>" &
			    _Thumbnails &
			"</div>"
			
			RETURN _HTML
		lineageTag: 5147fc65-62b3-4b01-9215-d2c15a7d9dcb

	measure 'HTML Similar Sets Timeline' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _DecadeFontSize     = 16
			VAR _DecadeFontWeight   = 700
			VAR _SetNameFontSize    = 16
			VAR _SetNameFontWeight  = 600
			VAR _MatchFontSize      = 16
			VAR _MatchFontWeight    = 700
			VAR _TextColor          = "#000000"
			
			-- Match badge styling
			VAR _MatchBadgeBg          = "#DCFCE7"   -- light green background
			VAR _MatchBadgeTextColor   = "#15803D"   -- dark green text
			VAR _MatchBadgePaddingY    = 3           -- px
			VAR _MatchBadgePaddingX    = 10          -- px
			VAR _MatchBadgeBorderRadius = 12         -- px, higher = more pill-shaped
			
			VAR _MaxDistance        = 0.5
			
			VAR _FadeDuration       = 0.6
			VAR _FadeStagger        = 0
			VAR _StartTranslateY    = 12
			VAR _Easing             = "ease-out"
			VAR _ImageZoom          = 2.0           -- 1.0 = actual size; >1 crops padding by scaling image up
			
			-- Card sizing
			VAR _CardWidth          = 300           -- px, total width of each decade card
			VAR _CardPaddingY       = 8             -- px, vertical padding inside each card
			VAR _CardPaddingX       = 1             -- px, horizontal padding inside each card
			VAR _CardBg             = "transparent" -- background color of card ("transparent" or hex like "#F5F5F5")
			VAR _CardBorderRadius   = 6             -- px, rounded corners on card
			
			-- Item spacing
			VAR _ItemGap            = 0            -- px, gap between cards
			
			-- Image sizing
			VAR _ImageHeight        = 70            -- px, image slot height
			VAR _ImageWidth         = 90            -- px, image slot width
			
			-- Text sizing (also spacing between elements)
			VAR _DecadeSpaceBelow   = 2             -- px, gap between decade label and image
			VAR _ImageSpaceBelow    = 2             -- px, gap between image and set name
			VAR _NameSpaceBelow     = 2             -- px, gap between set name and match text
			VAR _SetNameMaxWidth    = 210           -- px, max width of set name (controls when text wraps)
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _Target = [Target Weighted Similarity]
			
			-- Identify the set(s) that generated the target, so we can exclude them
			-- from ever being recommended as a "closest match" to themselves.
			VAR _SourceSetNumbers =
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            FILTER(
			                sets,
			                sets[Weighted Similarity] = _Target
			            ),
			            "@sn", sets[set_number]
			        ),
			        ALLSELECTED( sets ),
			        ALLSELECTED( dim_year )
			    )
			
			-- Get ALL decades (ignoring page filters)
			VAR _Decades =
			    SELECTCOLUMNS(
			        ADDCOLUMNS(
			            CALCULATETABLE(
			                SUMMARIZE( sets, sets[decade] ),
			                REMOVEFILTERS( sets ),
			                REMOVEFILTERS( dim_year )
			            ),
			            "@idx", RANKX(
			                CALCULATETABLE(
			                    SUMMARIZE( sets, sets[decade] ),
			                    REMOVEFILTERS( sets ),
			                    REMOVEFILTERS( dim_year )
			                ),
			                sets[decade], , ASC, DENSE
			            )
			        ),
			        "Decade", sets[decade],
			        "DecadeIdx", [@idx]
			    )
			
			-- ============================================
			-- === UNIQUE ANIMATION ID ====================
			-- ============================================
			
			VAR _UID = "simtl" & RANDBETWEEN( 10000000, 99999999 )
			
			VAR _CSS =
			"<style>
			@keyframes " & _UID & "_fade {
			    from {
			        opacity: 0;
			        transform: translateY(" & _StartTranslateY & "px);
			    }
			    to {
			        opacity: 1;
			        transform: translateY(0px);
			    }
			}
			." & _UID & "_card {
			    opacity: 0;
			    animation-name: " & _UID & "_fade;
			    animation-duration: " & _FadeDuration & "s;
			    animation-timing-function: " & _Easing & ";
			    animation-fill-mode: forwards;
			}
			</style>"
			
			-- ============================================
			-- === PER-DECADE CLOSEST MATCH ===============
			-- ============================================
			
			VAR _DecadeCards =
			    CONCATENATEX(
			        _Decades,
			        VAR _CurrentDecade = [Decade]
			        VAR _CardDelay = ( [DecadeIdx] - 1 ) * _FadeStagger
			
			        VAR _Candidates =
			            ADDCOLUMNS(
			                CALCULATETABLE(
			                    FILTER(
			                        sets,
			                        sets[decade] = _CurrentDecade
			                            && NOT ISBLANK( sets[Weighted Similarity] )
			                            && NOT sets[set_number] IN _SourceSetNumbers
			                    ),
			                    REMOVEFILTERS( sets ),
			                    REMOVEFILTERS( dim_year )
			                ),
			                "@distance", ABS( sets[Weighted Similarity] - _Target )
			            )
			
			        VAR _MinDistance = MINX( _Candidates, [@distance] )
			
			        VAR _WinningRow =
			            FILTER( _Candidates, [@distance] = _MinDistance )
			
			        VAR _ClosestSetName = MINX( _WinningRow, sets[set_name] )
			        VAR _ClosestSetImage = MINX( _WinningRow, sets[img_url] )
			
			        VAR _MatchPct =
			            1 - MIN( DIVIDE( _MinDistance, _MaxDistance ), 1 )
			        VAR _MatchPctText = FORMAT( _MatchPct, "0%" )
			
			        RETURN
			            IF(
			                ISBLANK( _ClosestSetName ),
			                "",
			                "<div class='" & _UID & "_card' style='
			                    display:flex;
			                    flex-direction:column;
			                    align-items:center;
			                    text-align:center;
			                    font-family:" & _FontFamily & ";
			                    width:" & _CardWidth & "px;
			                    padding:" & _CardPaddingY & "px " & _CardPaddingX & "px;
			                    background:" & _CardBg & ";
			                    border-radius:" & _CardBorderRadius & "px;
			                    box-sizing:border-box;
			                    animation-delay:" & _CardDelay & "s;
			                '>
			                    <div style='
			                        font-size:" & _DecadeFontSize & "px;
			                        font-weight:" & _DecadeFontWeight & ";
			                        color:" & _TextColor & ";
			                        margin-bottom:" & _DecadeSpaceBelow & "px;
			                    '>" & _CurrentDecade & "</div>
			                    <div style='
			                        width:" & _ImageWidth & "px;
			                        height:" & _ImageHeight & "px;
			                        display:flex;
			                        align-items:center;
			                        justify-content:center;
			                        margin-bottom:" & _ImageSpaceBelow & "px;
			                    '>
			                        <img src='" & _ClosestSetImage & "' style='
			                            max-width:" & _ImageWidth & "px;
			                            max-height:" & _ImageHeight & "px;
			                            width:auto;
			                            height:auto;
			                            border-radius:4px;
			                            display:block;
			                        ' />
			                    </div>
			                    <div style='
			                        font-size:" & _SetNameFontSize & "px;
			                        font-weight:" & _SetNameFontWeight & ";
			                        color:" & _TextColor & ";
			                        max-width:" & _SetNameMaxWidth & "px;
			                        line-height:1.2;
			                        margin-bottom:" & _NameSpaceBelow & "px;
			                    '>" & _ClosestSetName & "</div>
			                    <div style='
			                        display:inline-block;
			                        font-size:" & _MatchFontSize & "px;
			                        font-weight:" & _MatchFontWeight & ";
			                        color:" & _MatchBadgeTextColor & ";
			                        background:" & _MatchBadgeBg & ";
			                        padding:" & _MatchBadgePaddingY & "px " & _MatchBadgePaddingX & "px;
			                        border-radius:" & _MatchBadgeBorderRadius & "px;
			                    '>" & _MatchPctText & " match</div>
			                </div>"
			            ),
			        "",
			        [DecadeIdx], ASC
			    )
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_CSS &
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:row;
			    align-items:flex-start;
			    justify-content:flex-start;
			    gap:" & _ItemGap & "px;
			    overflow-x:auto;
			    overflow-y:hidden;
			    padding:8px 4px;
			    box-sizing:border-box;
			'>" & _DecadeCards & "</div>"
			
			RETURN _HTML
		lineageTag: 8a23e2cf-14d3-411b-949b-de65b32c2885

	measure 'HTML Set Personality Card' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Card frame
			VAR _CardWidth          = 730           -- px, set to "100%" behavior not needed if fixed layout
			VAR _CardHeight         = 160           -- px
			VAR _CardBgOpacity      = 0.2           -- 0 = fully transparent, 1 = fully opaque
			VAR _CardBg             = "rgba(0, 85, 191, " & _CardBgOpacity & ")"   -- sky blue with opacity
			VAR _CardBorderColor    = "#5AA8E0"
			VAR _CardBorderWidth    = 1             -- px
			VAR _CardBorderRadius   = 10            -- px
			VAR _CardPaddingY       = 16            -- px
			VAR _CardPaddingX       = 18            -- px
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _TextFontSize       = 20
			VAR _TextFontWeight     = 500
			VAR _TextFontStyle      = "italic"      -- "normal" | "italic"
			VAR _TextColor          = "#333333"     -- black
			VAR _TextLineHeight     = 1.5
			
			-- Optional icon/label above the text
			VAR _ShowLabel          = TRUE          -- TRUE | FALSE
			VAR _LabelText          = "RECOMMENDATION INSIGHT"
			VAR _LabelFontSize      = 18
			VAR _LabelFontWeight    = 700
			VAR _LabelColor         = "#000000"     -- black
			VAR _LabelSpaceBelow    = 8              -- px
			
			-- Fade-in animation
			VAR _FadeDuration       = 0.6
			VAR _StartTranslateY    = 8
			VAR _Easing             = "ease-out"
			
			-- ============================================
			-- === DATA ====================================
			-- ============================================
			
			VAR _Description = SELECTEDVALUE( sets[set_personality_description] )
			
			-- ============================================
			-- === UNIQUE ANIMATION ID ====================
			-- ============================================
			
			VAR _UID = "persona" & RANDBETWEEN( 10000000, 99999999 )
			
			VAR _CSS =
			"<style>
			@keyframes " & _UID & "_fade {
			    from { opacity: 0; transform: translateY(" & _StartTranslateY & "px); }
			    to   { opacity: 1; transform: translateY(0px); }
			}
			." & _UID & "_root {
			    opacity: 0;
			    animation: " & _UID & "_fade " & _FadeDuration & "s " & _Easing & " forwards;
			}
			</style>"
			
			-- ============================================
			-- === LABEL (optional) ========================
			-- ============================================
			
			VAR _LabelHTML =
			    IF(
			        _ShowLabel,
			        "<div style='
			            font-size:" & _LabelFontSize & "px;
			            font-weight:" & _LabelFontWeight & ";
			            color:" & _LabelColor & ";
			            letter-spacing:0.5px;
			            margin-bottom:" & _LabelSpaceBelow & "px;
			        '>" & _LabelText & "</div>",
			        ""
			    )
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML =====================
			-- ============================================
			
			VAR _HTML =
			_CSS &
			"<div class='" & _UID & "_root' style='
			    width:" & _CardWidth & "px;
			    height:" & _CardHeight & "px;
			    background:" & _CardBg & ";
			    border:" & _CardBorderWidth & "px solid " & _CardBorderColor & ";
			    border-radius:" & _CardBorderRadius & "px;
			    padding:" & _CardPaddingY & "px " & _CardPaddingX & "px;
			    box-sizing:border-box;
			    font-family:" & _FontFamily & ";
			    overflow:auto;
			'>" &
			_LabelHTML &
			"<div style='
			    font-size:" & _TextFontSize & "px;
			    font-weight:" & _TextFontWeight & ";
			    font-style:" & _TextFontStyle & ";
			    color:" & _TextColor & ";
			    line-height:" & _TextLineHeight & ";
			'>" & _Description & "</div>
			</div>"
			
			RETURN _HTML
		lineageTag: 8ccb0fff-ec82-4b59-8c51-35b363d2f472

	measure , = "Hover to see page information"
