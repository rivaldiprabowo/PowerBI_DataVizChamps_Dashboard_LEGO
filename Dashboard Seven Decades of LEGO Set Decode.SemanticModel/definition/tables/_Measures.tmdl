	measure 'HTML Card Total Sets' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Main number
			VAR _NumberFontSize     = 35            -- px
			VAR _NumberFontWeight   = 700           -- 100–900
			VAR _NumberColor        = "#FFFFFF"
			VAR _NumberLetterSpacing = 1            -- px
			VAR _NumberLineHeight   = 1             -- unitless multiplier
			VAR _FontFamily         = "Segoe UI, sans-serif"
			
			-- Container layout
			VAR _ContainerAlign     = "flex-start"  -- flex-start | center | flex-end
			VAR _ContainerJustify   = "center"      -- flex-start | center | flex-end
			
			-- Badge (vs last decade / Total All Time)
			VAR _BadgeFontSize      = 16            -- px
			VAR _BadgeFontWeight    = 600
			VAR _BadgeBackground    = "#FFFFFF"
			VAR _BadgePaddingY      = 4             -- px
			VAR _BadgePaddingX      = 10            -- px
			VAR _BadgeBorderRadius  = 6             -- px (higher = more rounded, use 999 for full pill)
			VAR _BadgeMarginTop     = 6             -- px, space between number and badge
			VAR _BadgeShadow        = "0 1px 2px rgba(0,0,0,0.12)"
			
			-- Badge colors by state
			VAR _ColorPositive      = "#2E7D32"     -- green for ▲
			VAR _ColorNegative      = "#C62828"     -- red for ▼
			VAR _ColorNeutral       = "#000000"     -- neutral for "Total All Time"
			
			-- Animation
			VAR _AnimationDuration  = 1000          -- ms, counter count-up
			VAR _BadgeFadeDuration  = 400           -- ms, badge fade-in after counter
			
			-- ============================================
			-- === VALUE CALCULATION (do not edit) ========
			-- ============================================
			
			VAR _Value = DISTINCTCOUNT('sets'[set_number])
			VAR _FormattedValue = FORMAT( _Value, "#,##0" )
			VAR _UID = "c" & RANDBETWEEN( 10000000, 99999999 )
			VAR _BadgeUID = "b" & RANDBETWEEN( 10000000, 99999999 )
			
			-- Filter state detection
			VAR _DecadeFiltered = ISFILTERED( dim_year[decade] )
			VAR _SelectedDecade = SELECTEDVALUE( dim_year[decade] )
			VAR _MinDecade =
			    CALCULATE(
			        MIN( dim_year[decade] ),
			        ALL( dim_year )
			    )
			
			-- Previous decade calculation
			VAR _CurrentDecadeNum =
			    IF(
			        NOT ISBLANK( _SelectedDecade ),
			        VALUE( LEFT( _SelectedDecade, 4 ) )
			    )
			VAR _PrevDecadeStr = FORMAT( _CurrentDecadeNum - 10, "0" ) & "s"
			
			VAR _PrevValue =
			    CALCULATE(
			        DISTINCTCOUNT( 'sets'[set_number] ),
			        ALL( dim_year ),
			        dim_year[decade] = _PrevDecadeStr
			    )
			
			VAR _Delta = _Value - _PrevValue
			VAR _PctChange = DIVIDE( _Delta, _PrevValue, 0 )
			VAR _IsPositive = _Delta >= 0
			VAR _ArrowChar = IF( _IsPositive, "▲", "▼" )
			VAR _DeltaColor = IF( _IsPositive, _ColorPositive, _ColorNegative )
			
			VAR _DeltaFormatted = FORMAT( ABS( _Delta ), "#,##0" )
			VAR _PctFormatted = FORMAT( ABS( _PctChange ), "0.0%" )
			
			-- Badge text
			VAR _BadgeText =
			    SWITCH(
			        TRUE(),
			        NOT _DecadeFiltered, "Total All Time",
			        ISBLANK( _SelectedDecade ), "",
			        _SelectedDecade = _MinDecade, "",
			        _ArrowChar & " " & _DeltaFormatted & " (" & _PctFormatted & ")<br/>vs last decade"
			    )
			
			VAR _BadgeTextColor =
			    SWITCH(
			        TRUE(),
			        NOT _DecadeFiltered, _ColorNeutral,
			        _DeltaColor
			    )
			
			-- ============================================
			-- === HTML ASSEMBLY (do not edit) ============
			-- ============================================
			
			VAR _BadgeHTML =
			    IF(
			        _BadgeText = "",
			        "",
			        "<div id='" & _BadgeUID & "' style='
			            display:inline-block;
			            background:" & _BadgeBackground & ";
			            color:" & _BadgeTextColor & ";
			            font-size:" & _BadgeFontSize & "px;
			            font-weight:" & _BadgeFontWeight & ";
			            padding:" & _BadgePaddingY & "px " & _BadgePaddingX & "px;
			            border-radius:" & _BadgeBorderRadius & "px;
			            margin-top:" & _BadgeMarginTop & "px;
			            text-align:center;
			            line-height:1.3;
			            box-shadow:" & _BadgeShadow & ";
			            opacity:0;
			            transition:opacity " & _BadgeFadeDuration & "ms ease-out;
			        '>" & _BadgeText & "</div>"
			    )
			
			VAR _HTML =
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    align-items:" & _ContainerAlign & ";
			    justify-content:" & _ContainerJustify & ";
			    font-family:" & _FontFamily & ";
			'>
			  <div id='" & _UID & "' style='
			      font-size:" & _NumberFontSize & "px;
			      font-weight:" & _NumberFontWeight & ";
			      color:" & _NumberColor & ";
			      letter-spacing:" & _NumberLetterSpacing & "px;
			      line-height:" & _NumberLineHeight & ";
			  '>0</div>
			  " & _BadgeHTML & "
			
			  <img src='x' style='display:none' onerror=""
			    (function(){
			      var el = document.getElementById('" & _UID & "');
			      if (!el || el.getAttribute('data-animated') === 'true') return;
			      el.setAttribute('data-animated', 'true');
			
			      var target = " & _Value & ";
			      var duration = " & _AnimationDuration & ";
			      var startTime = null;
			
			      function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
			      function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
			
			      function step(timestamp){
			        if (!startTime) startTime = timestamp;
			        var progress = Math.min((timestamp - startTime) / duration, 1);
			        var eased = easeOutCubic(progress);
			        el.textContent = formatNum(target * eased);
			        if (progress < 1) {
			          requestAnimationFrame(step);
			        } else {
			          el.textContent = '" & _FormattedValue & "';
			          var badge = document.getElementById('" & _BadgeUID & "');
			          if (badge) badge.style.opacity = '1';
			        }
			      }
			      requestAnimationFrame(step);
			    })();
			  "" />
			</div>"
			
			RETURN _HTML
		displayFolder: Page 1 History
		lineageTag: 35e575d4-2876-4bf5-912e-bbe87014c890

	measure 'HTML Card Total Theme' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Main number
			VAR _NumberFontSize     = 35            -- px
			VAR _NumberFontWeight   = 700           -- 100–900
			VAR _NumberColor        = "#FFFFFF"
			VAR _NumberLetterSpacing = 1            -- px
			VAR _NumberLineHeight   = 1             -- unitless multiplier
			VAR _FontFamily         = "Segoe UI, sans-serif"
			
			-- Container layout
			VAR _ContainerAlign     = "flex-start"  -- flex-start | center | flex-end
			VAR _ContainerJustify   = "center"      -- flex-start | center | flex-end
			
			-- Badge (vs last decade / Total All Time)
			VAR _BadgeFontSize      = 16            -- px
			VAR _BadgeFontWeight    = 600
			VAR _BadgeBackground    = "#FFFFFF"
			VAR _BadgePaddingY      = 4             -- px
			VAR _BadgePaddingX      = 10            -- px
			VAR _BadgeBorderRadius  = 6            -- px (higher = more rounded, use 999 for full pill)
			VAR _BadgeMarginTop     = 6             -- px, space between number and badge
			VAR _BadgeShadow        = "0 1px 2px rgba(0,0,0,0.12)"
			
			-- Badge colors by state
			VAR _ColorPositive      = "#2E7D32"     -- green for ▲
			VAR _ColorNegative      = "#C62828"     -- red for ▼
			VAR _ColorNeutral       = "#000000"     -- blue for "Total All Time"
			
			-- Animation
			VAR _AnimationDuration  = 1000          -- ms, counter count-up
			VAR _BadgeFadeDuration  = 400           -- ms, badge fade-in after counter
			
			-- ============================================
			-- === VALUE CALCULATION (do not edit) ========
			-- ============================================
			
			VAR _Value = DISTINCTCOUNT('themes'[theme_id])
			VAR _FormattedValue = FORMAT( _Value, "#,##0" )
			VAR _UID = "c" & RANDBETWEEN( 10000000, 99999999 )
			VAR _BadgeUID = "b" & RANDBETWEEN( 10000000, 99999999 )
			
			-- Filter state detection
			VAR _DecadeFiltered = ISFILTERED( dim_year[decade] )
			VAR _SelectedDecade = SELECTEDVALUE( dim_year[decade] )
			VAR _MinDecade =
			    CALCULATE(
			        MIN( dim_year[decade] ),
			        ALL( dim_year )
			    )
			
			-- Previous decade calculation
			VAR _CurrentDecadeNum =
			    IF(
			        NOT ISBLANK( _SelectedDecade ),
			        VALUE( LEFT( _SelectedDecade, 4 ) )
			    )
			VAR _PrevDecadeStr = FORMAT( _CurrentDecadeNum - 10, "0" ) & "s"
			
			VAR _PrevValue =
			    CALCULATE(
			        DISTINCTCOUNT( 'themes'[theme_id] ),
			        ALL( dim_year ),
			        dim_year[decade] = _PrevDecadeStr
			    )
			
			VAR _Delta = _Value - _PrevValue
			VAR _PctChange = DIVIDE( _Delta, _PrevValue, 0 )
			VAR _IsPositive = _Delta >= 0
			VAR _ArrowChar = IF( _IsPositive, "▲", "▼" )
			VAR _DeltaColor = IF( _IsPositive, _ColorPositive, _ColorNegative )
			
			VAR _DeltaFormatted = FORMAT( ABS( _Delta ), "#,##0" )
			VAR _PctFormatted = FORMAT( ABS( _PctChange ), "0.0%" )
			
			-- Badge text
			VAR _BadgeText =
			    SWITCH(
			        TRUE(),
			        NOT _DecadeFiltered, "Total All Time",
			        ISBLANK( _SelectedDecade ), "",
			        _SelectedDecade = _MinDecade, "",
			        _ArrowChar & " " & _DeltaFormatted & " (" & _PctFormatted & ")<br/>vs last decade"
			    )
			
			VAR _BadgeTextColor =
			    SWITCH(
			        TRUE(),
			        NOT _DecadeFiltered, _ColorNeutral,
			        _DeltaColor
			    )
			
			-- ============================================
			-- === HTML ASSEMBLY (do not edit) ============
			-- ============================================
			
			VAR _BadgeHTML =
			    IF(
			        _BadgeText = "",
			        "",
			        "<div id='" & _BadgeUID & "' style='
			            display:inline-block;
			            background:" & _BadgeBackground & ";
			            color:" & _BadgeTextColor & ";
			            font-size:" & _BadgeFontSize & "px;
			            font-weight:" & _BadgeFontWeight & ";
			            padding:" & _BadgePaddingY & "px " & _BadgePaddingX & "px;
			            border-radius:" & _BadgeBorderRadius & "px;
			            margin-top:" & _BadgeMarginTop & "px;
			            text-align:center;
			            line-height:1.3;
			            box-shadow:" & _BadgeShadow & ";
			            opacity:0;
			            transition:opacity " & _BadgeFadeDuration & "ms ease-out;
			        '>" & _BadgeText & "</div>"
			    )
			
			VAR _HTML =
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    align-items:" & _ContainerAlign & ";
			    justify-content:" & _ContainerJustify & ";
			    font-family:" & _FontFamily & ";
			'>
			  <div id='" & _UID & "' style='
			      font-size:" & _NumberFontSize & "px;
			      font-weight:" & _NumberFontWeight & ";
			      color:" & _NumberColor & ";
			      letter-spacing:" & _NumberLetterSpacing & "px;
			      line-height:" & _NumberLineHeight & ";
			  '>0</div>
			  " & _BadgeHTML & "
			
			  <img src='x' style='display:none' onerror=""
			    (function(){
			      var el = document.getElementById('" & _UID & "');
			      if (!el || el.getAttribute('data-animated') === 'true') return;
			      el.setAttribute('data-animated', 'true');
			
			      var target = " & _Value & ";
			      var duration = " & _AnimationDuration & ";
			      var startTime = null;
			
			      function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
			      function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
			
			      function step(timestamp){
			        if (!startTime) startTime = timestamp;
			        var progress = Math.min((timestamp - startTime) / duration, 1);
			        var eased = easeOutCubic(progress);
			        el.textContent = formatNum(target * eased);
			        if (progress < 1) {
			          requestAnimationFrame(step);
			        } else {
			          el.textContent = '" & _FormattedValue & "';
			          var badge = document.getElementById('" & _BadgeUID & "');
			          if (badge) badge.style.opacity = '1';
			        }
			      }
			      requestAnimationFrame(step);
			    })();
			  "" />
			</div>"
			
			RETURN _HTML
		displayFolder: Page 1 History
		lineageTag: 901205a8-b3fc-4888-a748-923baf48f08a

	measure 'HTML Card History Summary' =
			
			VAR _Summary =
			    SWITCH(
			        TRUE(),
			        ISFILTERED( 'dim_year'[decade] ) == FALSE(),
			        "Simple interlocking brick patented in 1958 has grown into a catalog of 22,441 sets across 423 themes, 271 colors, and 16,960 minifigures over more than seven decades. The trajectory was shaped by the 1978 debut of the minifigure, which transformed LEGO from an abstract building system into a character-driven storytelling platform. The 2000 Star Wars partnership launched the licensing era that remains LEGO's dominant expansion strategy today, complemented by successful original themes such as BIONICLE and NINJAGO. Today's sets average 191 parts — more than 7× their 1950s counterparts — reflecting a strategic shift toward fewer, larger, and more complex builds.",
			        MAX( 'decade_lego_summary'[Summary] )
			    )
			
			-- =========================
			-- EDIT THESE MANUALLY
			-- =========================
			VAR _FontSize     = "23px"        -- e.g. "14px", "1.1rem", "22px"
			VAR _FontWeight   = "600"         -- 400 normal, 600 semi-bold, 700 bold
			VAR _TextAlign    = "justify"        -- "left" | "center" | "right" | "justify"
			VAR _LineHeight   = "1.5"
			VAR _TextColor    = "#000000"
			VAR _FadeDuration = "1s"        -- how slow/fast the fade is
			VAR _FadeDelay    = "0.1s"        -- pause before it starts
			-- =========================
			
			VAR _UID = "fadecard" & RANDBETWEEN( 10000000, 99999999 )
			
			VAR _HTML =
			"<style>
			  @keyframes " & _UID & "_fade {
			      from { opacity: 0; transform: translateY(6px); }
			      to   { opacity: 1; transform: translateY(0); }
			  }
			  #" & _UID & " {
			      opacity: 0;
			      animation: " & _UID & "_fade " & _FadeDuration & " ease-out " & _FadeDelay & " forwards;
			  }
			</style>
			
			<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    align-items:center;
			    padding:0px 9px;
			    box-sizing:border-box;
			    font-family:''Poppins'';
			'>
			  <p id='" & _UID & "' style='
			      margin:0;
			      font-size:" & _FontSize & ";
			      font-weight:" & _FontWeight & ";
			      text-align:" & _TextAlign & ";
			      line-height:" & _LineHeight & ";
			      color:" & _TextColor & ";
			      width:100%;
			  '>" & _Summary & "</p>
			</div>"
			
			RETURN _HTML
		displayFolder: Page 1 History
		lineageTag: e6dd01f8-dae6-4cbd-aad8-0ccd19145cb9

	measure 'HTML Total Parts Histogram' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Bin config
			VAR _NumBins            = 75
			VAR _UseLogScale        = TRUE
			
			-- Chart dimensions
			VAR _SvgWidth           = 700
			VAR _ChartHeight        = 300
			VAR _MarginLeft         = 45            -- room for y-axis labels
			VAR _MarginRight        = 15
			VAR _MarginTop          = 15
			VAR _MarginBottom       = 10            -- room for x-axis labels
			
			-- Bar styling
			VAR _BarGap             = 2
			VAR _CornerRadius       = 3
			
			-- Typography
			VAR _FontFamily         = "Poppins, Segoe UI"
			VAR _XAxisFontSize      = 18
			VAR _YAxisFontSize      = 20
			VAR _AxisTextColor      = "#000000"
			VAR _AxisLineColor      = "#000000"
			VAR _GridLineColor      = "#EEEEEE"
			
			-- Legend
			VAR _LegendFontSize     = 20
			VAR _LegendPaddingTop   = 20            -- gap between bars/x-axis and legend
			VAR _LegendPaddingLeft  = 0             -- left offset for legend (from _MarginLeft)
			VAR _LegendItemSpacing  = 100           -- horizontal space between legend items
			VAR _LegendSwatchSize   = 15
			VAR _LegendHeight       = 25
			-- Approx label widths in pixels at _LegendFontSize (rough estimate: char count × 0.55 × fontSize)
			VAR _CharWidth      = _LegendFontSize * 0.55
			VAR _WidthMicro     = 5 * _CharWidth
			VAR _WidthSmall     = 5 * _CharWidth
			VAR _WidthMedium    = 6 * _CharWidth
			VAR _WidthLarge     = 5 * _CharWidth
			VAR _LegendGap      = 25            -- consistent visual gap between items
			VAR _TextSwatchGap  = 8             -- gap between swatch and its label
			
			-- Tooltip styling
			VAR _TooltipBg          = "#FFFFFF"
			VAR _TooltipBorder      = "#DDDDDD"
			VAR _TooltipShadow      = "0 4px 12px rgba(0,0,0,0.15)"
			VAR _TooltipFontSize    = 17
			VAR _TooltipTextColor   = "#333333"
			
			-- Animation
			VAR _AnimDuration       = 0.0008
			VAR _AnimStagger        = 0.02
			
			-- Tier colors
			VAR _ColorMicro         = "#2ECC71"
			VAR _ColorSmall         = "#2a78d6"
			VAR _ColorMedium        = "#F4B400"
			VAR _ColorLarge         = "#ab6643"
			VAR _ColorMega          = "#E53935"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _PlotWidth  = _SvgWidth - _MarginLeft - _MarginRight
			VAR _PlotHeight = _ChartHeight - _MarginTop - _MarginBottom
			
			VAR _SvgHeight  = _ChartHeight + _LegendPaddingTop + _LegendHeight
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _MinParts = 1
			VAR _MaxParts = CALCULATE( MAX( sets[number_of_parts] ), ALL( sets ), sets[number_of_parts] > 0 )
			
			VAR _LogMin = LOG10( _MinParts )
			VAR _LogMax = LOG10( _MaxParts )
			
			VAR _BinNumbers = GENERATESERIES( 0, _NumBins - 1, 1 )
			
			VAR _BinEdges =
			    ADDCOLUMNS(
			        _BinNumbers,
			        "lo",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( [Value] / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinParts + ( [Value] / _NumBins ) * ( _MaxParts - _MinParts )
			            ),
			        "hi",
			            IF(
			                _UseLogScale,
			                POWER( 10, _LogMin + ( ( [Value] + 1 ) / _NumBins ) * ( _LogMax - _LogMin ) ),
			                _MinParts + ( ( [Value] + 1 ) / _NumBins ) * ( _MaxParts - _MinParts )
			            )
			    )
			
			VAR _Tiers =
			    DATATABLE( "tier_name", STRING, "tier_color", STRING, "stack_order", INTEGER,
			        {
			            { "Micro",  "#2ECC71", 1 },
			            { "Small",  "#2a78d6", 2 },
			            { "Medium", "#F4B400", 3 },
			            { "Large",  "#ab6643", 4 },
			            { "Mega",   "#E53935", 5 }
			        }
			    )
			
			VAR _BinTierCounts =
			    ADDCOLUMNS(
			        CROSSJOIN( _BinEdges, _Tiers ),
			        "seg_count",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            VAR T  = [tier_name]
			            RETURN
			                CALCULATE(
			                    COUNTROWS( sets ),
			                    sets[number_of_parts] >= Lo,
			                    sets[number_of_parts] < Hi,
			                    sets[complexity_tier] = T
			                )
			    )
			
			VAR _MaxBinTotal =
			    MAXX(
			        _BinEdges,
			        VAR Lo = [lo]
			        VAR Hi = [hi]
			        RETURN
			            CALCULATE(
			                COUNTROWS( sets ),
			                sets[number_of_parts] >= Lo,
			                sets[number_of_parts] < Hi
			            )
			    )
			
			VAR _BarSlot  = DIVIDE( _PlotWidth, _NumBins )
			VAR _BarWidth = _BarSlot - _BarGap
			
			-- ============================================
			-- === STACKED BARS ===========================
			-- ============================================
			
			VAR _Bars =
			    CONCATENATEX(
			        _BinEdges,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR Delay = BinIdx * _AnimStagger
			        VAR SegmentsForBin = FILTER( _BinTierCounts, [Value] = BinIdx )
			        RETURN
			            CONCATENATEX(
			                SegmentsForBin,
			                VAR SegHeight = DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                VAR CumBelow =
			                    SUMX(
			                        FILTER( SegmentsForBin, [stack_order] < EARLIER( [stack_order] ) ),
			                        DIVIDE( [seg_count], _MaxBinTotal ) * _PlotHeight
			                    )
			                VAR Y = _MarginTop + _PlotHeight - CumBelow - SegHeight
			                RETURN
			                    IF(
			                        [seg_count] > 0,
			                        "<rect x='" & X & "' y='" & Y & "' width='" & _BarWidth & "' height='" & SegHeight &
			                        "' fill='" & [tier_color] & "' " &
			                        "style='animation:barFade " & _AnimDuration & "s ease-out " & Delay & "s both'>" &
			                        "<title>" & [tier_name] & ": " & [seg_count] & " sets (" &
			                        FORMAT( ROUND( [lo], 0 ), "#,##0" ) & "-" & FORMAT( ROUND( [hi], 0 ), "#,##0" ) & " parts)</title></rect>",
			                        ""
			                    ),
			                "",
			                [stack_order], ASC
			            ),
			        "",
			        [Value], ASC
			    )
			
			-- ============================================
			-- === HOVER TRACKERS =========================
			-- ============================================
			-- One invisible rect per bin, spanning full plot height with data attributes for all tier values
			
			VAR _BinTotals =
			    ADDCOLUMNS(
			        _BinEdges,
			        "@micro",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi, sets[complexity_tier] = "Micro" ),
			        "@small",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi, sets[complexity_tier] = "Small" ),
			        "@medium",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi, sets[complexity_tier] = "Medium" ),
			        "@large",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi, sets[complexity_tier] = "Large" ),
			        "@mega",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi, sets[complexity_tier] = "Mega" ),
			        "@total",
			            VAR Lo = [lo]
			            VAR Hi = [hi]
			            RETURN CALCULATE( COUNTROWS( sets ), sets[number_of_parts] >= Lo, sets[number_of_parts] < Hi )
			    )
			
			VAR _HoverTrackers =
			    CONCATENATEX(
			        _BinTotals,
			        VAR BinIdx = [Value]
			        VAR X = _MarginLeft + BinIdx * _BarSlot
			        VAR TotalCount = IF( ISBLANK( [@total] ), 0, [@total] )
			        VAR MicroCount = IF( ISBLANK( [@micro] ), 0, [@micro] )
			        VAR SmallCount = IF( ISBLANK( [@small] ), 0, [@small] )
			        VAR MediumCount = IF( ISBLANK( [@medium] ), 0, [@medium] )
			        VAR LargeCount = IF( ISBLANK( [@large] ), 0, [@large] )
			        VAR MegaCount = IF( ISBLANK( [@mega] ), 0, [@mega] )
			        VAR DataAttrs =
			            " data-range='" & FORMAT( ROUND( [lo], 0 ), "#,0" ) & " - " & FORMAT( ROUND( [hi], 0 ), "#,0" ) & " parts'" &
			            " data-micro='" & FORMAT( MicroCount, "#,0" ) & "'" &
			            " data-small='" & FORMAT( SmallCount, "#,0" ) & "'" &
			            " data-medium='" & FORMAT( MediumCount, "#,0" ) & "'" &
			            " data-large='" & FORMAT( LargeCount, "#,0" ) & "'" &
			            " data-mega='" & FORMAT( MegaCount, "#,0" ) & "'" &
			            " data-total='" & FORMAT( TotalCount, "#,0" ) & "'"
			        RETURN
			            "<rect class='hover-band' x='" & X & "' y='" & _MarginTop & "' width='" & _BarSlot & "' height='" & _PlotHeight & "' fill='transparent'" & DataAttrs & " />",
			        "",
			        [Value], ASC
			    )
			
			VAR _HoverIndicator =
			    "<line id='hover-line' x1='0' y1='" & _MarginTop & "' x2='0' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='#666666' stroke-width='1' stroke-dasharray='4,4' style='opacity:0;pointer-events:none;' />"
			
			-- ============================================
			-- === Y-AXIS (5 evenly-spaced count ticks) ===
			-- ============================================
			
			VAR _YTicks = GENERATESERIES( 0, 4, 1 )
			
			VAR _YAxisElements =
			    CONCATENATEX(
			        _YTicks,
			        VAR T = [Value]
			        VAR CountVal = _MaxBinTotal * T / 4
			        VAR YPos = _MarginTop + _PlotHeight - ( T / 4 ) * _PlotHeight
			        VAR Label = FORMAT( CountVal, "#,0" )
			        RETURN
			            "<line x1='" & _MarginLeft & "' y1='" & YPos &
			            "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & YPos &
			            "' stroke='" & _GridLineColor & "' stroke-width='1' />" &
			            "<text x='" & ( _MarginLeft - 8 ) & "' y='" & ( YPos + 4 ) &
			            "' text-anchor='end' font-family='" & _FontFamily &
			            "' font-size='" & _YAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        ""
			    )
			
			-- ============================================
			-- === X-AXIS (powers of 10) ==================
			-- ============================================
			-- Ticks at 1, 10, 100, 1000, 10000, etc. within the data range
			
			VAR _MinPowerOf10 = CEILING( _LogMin, 1 )
			VAR _MaxPowerOf10 = FLOOR( _LogMax, 1 )
			VAR _PowerCount = _MaxPowerOf10 - _MinPowerOf10 + 1
			
			VAR _PowerTicks =
			    ADDCOLUMNS(
			        GENERATESERIES( 0, _PowerCount - 1, 1 ),
			        "@power", _MinPowerOf10 + [Value],
			        "@partsVal", POWER( 10, _MinPowerOf10 + [Value] )
			    )
			
			VAR _XAxisElements =
			    CONCATENATEX(
			        _PowerTicks,
			        VAR PartsVal = [@partsVal]
			        VAR LogPos = LOG10( PartsVal )
			        VAR NormPos = DIVIDE( LogPos - _LogMin, _LogMax - _LogMin )
			        VAR XPos = _MarginLeft + NormPos * _PlotWidth
			        VAR YBottom = _MarginTop + _PlotHeight
			        VAR Label = FORMAT( PartsVal, "#,0" )
			        RETURN
			            "<line x1='" & XPos & "' y1='" & YBottom &
			            "' x2='" & XPos & "' y2='" & ( YBottom + 5 ) &
			            "' stroke='" & _AxisLineColor & "' stroke-width='1' />" &
			            "<text x='" & XPos & "' y='" & ( YBottom + 20 ) &
			            "' text-anchor='middle' font-family='" & _FontFamily &
			            "' font-size='" & _XAxisFontSize & "' fill='" & _AxisTextColor & "'>" & Label & "</text>",
			        "",
			        [Value], ASC
			    )
			
			VAR _XAxisBaseline =
			    "<line x1='" & _MarginLeft & "' y1='" & ( _MarginTop + _PlotHeight ) &
			    "' x2='" & ( _MarginLeft + _PlotWidth ) & "' y2='" & ( _MarginTop + _PlotHeight ) &
			    "' stroke='" & _AxisLineColor & "' stroke-width='1' />"
			
			-- ============================================
			-- === LEGEND =================================
			-- ============================================
			
			VAR _LegendY = _ChartHeight + _LegendPaddingTop
			VAR _LegendStartX = _MarginLeft + _LegendPaddingLeft
			
			VAR _Pos1 = 0
			VAR _Pos2 = _Pos1 + _LegendSwatchSize + _TextSwatchGap + _WidthMicro  + _LegendGap
			VAR _Pos3 = _Pos2 + _LegendSwatchSize + _TextSwatchGap + _WidthSmall  + _LegendGap
			VAR _Pos4 = _Pos3 + _LegendSwatchSize + _TextSwatchGap + _WidthMedium + _LegendGap
			VAR _Pos5 = _Pos4 + _LegendSwatchSize + _TextSwatchGap + _WidthLarge  + _LegendGap
			
			VAR _Legend =
			    "<g transform='translate(" & _LegendStartX & "," & _LegendY & ")' " &
			    "font-size='" & _LegendFontSize & "' font-family='" & _FontFamily & "'>" &
			    "<rect x='" & _Pos1 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMicro & "'/>" &
			    "<text x='" & ( _Pos1 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Micro</text>" &
			    "<rect x='" & _Pos2 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorSmall & "'/>" &
			    "<text x='" & ( _Pos2 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Small</text>" &
			    "<rect x='" & _Pos3 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMedium & "'/>" &
			    "<text x='" & ( _Pos3 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Medium</text>" &
			    "<rect x='" & _Pos4 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorLarge & "'/>" &
			    "<text x='" & ( _Pos4 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Large</text>" &
			    "<rect x='" & _Pos5 & "' y='0' width='" & _LegendSwatchSize & "' height='" & _LegendSwatchSize & "' fill='" & _ColorMega & "'/>" &
			    "<text x='" & ( _Pos5 + _LegendSwatchSize + _TextSwatchGap ) & "' y='" & _LegendSwatchSize & "'>Mega</text>" &
			    "</g>"
			
			-- ============================================
			-- === TOOLTIP CSS + JS =======================
			-- ============================================
			
			VAR _TooltipStyle =
			"<style>
			@keyframes barFade{from{opacity:0;transform:scaleY(0);transform-origin:bottom}to{opacity:1;transform:scaleY(1)}}
			.chart-container { position:relative; width:100%; height:100%; font-family:" & _FontFamily & "; }
			.hover-band { cursor:crosshair; }
			#custom-tooltip {
			    position:absolute;
			    display:none;
			    background:" & _TooltipBg & ";
			    border:1px solid " & _TooltipBorder & ";
			    border-radius:6px;
			    padding:10px 12px;
			    font-size:" & _TooltipFontSize & "px;
			    color:" & _TooltipTextColor & ";
			    box-shadow:" & _TooltipShadow & ";
			    pointer-events:none;
			    z-index:1000;
			    white-space:nowrap;
			}
			#custom-tooltip .tt-range { font-weight:700; margin-bottom:6px; font-size:18px; }
			#custom-tooltip .tt-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin:2px 0; }
			#custom-tooltip .tt-swatch { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; }
			#custom-tooltip .tt-label { display:flex; align-items:center; }
			#custom-tooltip .tt-value { font-weight:600; }
			#custom-tooltip .tt-total { border-top:1px solid #EEE; margin-top:6px; padding-top:6px; font-weight:700; }
			</style>"
			
			VAR _TooltipHTML = "<div id='custom-tooltip'></div>"
			
			VAR _TooltipScript =
			"<script>
			(function(){
			    var tooltip = document.getElementById('custom-tooltip');
			    var container = tooltip.parentElement;
			    var hoverLine = document.getElementById('hover-line');
			    var bands = document.querySelectorAll('.hover-band');
			    var colors = {
			        micro:  '" & _ColorMicro  & "',
			        small:  '" & _ColorSmall  & "',
			        medium: '" & _ColorMedium & "',
			        large:  '" & _ColorLarge  & "',
			        mega:   '" & _ColorMega   & "'
			    };
			
			    bands.forEach(function(band){
			        band.addEventListener('mouseenter', function(e){
			            var d = band.dataset;
			            var html = '';
			            html += '<div class=" & UNICHAR(34) & "tt-range" & UNICHAR(34) & ">' + d.range + '</div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.mega + '" & UNICHAR(34) & "></span>Mega</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.mega + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.large + '" & UNICHAR(34) & "></span>Large</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.large + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.medium + '" & UNICHAR(34) & "></span>Medium</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.medium + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.small + '" & UNICHAR(34) & "></span>Small</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.small + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-label" & UNICHAR(34) & "><span class=" & UNICHAR(34) & "tt-swatch" & UNICHAR(34) & " style=" & UNICHAR(34) & "background:' + colors.micro + '" & UNICHAR(34) & "></span>Micro</span><span class=" & UNICHAR(34) & "tt-value" & UNICHAR(34) & ">' + d.micro + '</span></div>';
			            html += '<div class=" & UNICHAR(34) & "tt-row tt-total" & UNICHAR(34) & "><span>Total</span><span>' + d.total + '</span></div>';
			            tooltip.innerHTML = html;
			            tooltip.style.display = 'block';
			
			            var bx = parseFloat(band.getAttribute('x')) + parseFloat(band.getAttribute('width'))/2;
			            hoverLine.setAttribute('x1', bx);
			            hoverLine.setAttribute('x2', bx);
			            hoverLine.style.opacity = '0.6';
			        });
			
			        band.addEventListener('mousemove', function(e){
			            var rect = container.getBoundingClientRect();
			            var x = e.clientX - rect.left;
			            var y = e.clientY - rect.top;
			            var ttW = tooltip.offsetWidth;
			            var ttH = tooltip.offsetHeight;
			            var left = x + 15;
			            if (left + ttW > rect.width) left = x - ttW - 15;
			            var top = y - ttH/2;
			            if (top < 5) top = 5;
			            if (top + ttH > rect.height) top = rect.height - ttH - 5;
			            tooltip.style.left = left + 'px';
			            tooltip.style.top = top + 'px';
			        });
			
			        band.addEventListener('mouseleave', function(){
			            tooltip.style.display = 'none';
			            hoverLine.style.opacity = '0';
			        });
			    });
			})();
			</script>"
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			_TooltipStyle &
			"<div class='chart-container'>" &
			"<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight & "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			_YAxisElements &
			_XAxisBaseline &
			"<g>" & _Bars & "</g>" &
			_XAxisElements &
			_HoverIndicator &
			_HoverTrackers &
			_Legend &
			"</svg>" &
			_TooltipHTML &
			"</div>" &
			_TooltipScript
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: b7412f61-df3b-4c54-906f-d2d2938a13bc

	measure 'HTML Minifig Barchart' =
			
			-- ============================================
			-- === STYLE CONFIGURATION (edit these) =======
			-- ============================================
			
			-- Chart dimensions
			VAR _SvgWidth              = 700
			VAR _ChartHeight           = 320
			VAR _TopPadding            = 10
			VAR _BottomPadding         = 10
			
			-- Left/right reserved space
			VAR _CategoryLabelWidth    = 90          -- room on the left for category names
			VAR _ValueLabelWidth       = 175          -- room on the right for "1,234 (12.3%)"
			VAR _CategoryBarGap        = 10           -- gap between category label and bar start
			VAR _BarValueGap           = 10           -- gap between bar end and value label
			
			-- Bar styling
			VAR _BarGap                = 15           -- vertical gap between adjacent bars
			VAR _BarCornerRadius       = 5
			
			-- Typography
			VAR _FontFamily            = "Poppins, Segoe UI"
			VAR _CategoryFontSize      = 15
			VAR _ValueLabelFontSize    = 15
			VAR _CategoryLabelColor    = "#333333"
			VAR _ValueLabelColor       = "#333333"
			
			-- Animation
			VAR _AnimDuration          = 0.7          -- seconds per bar grow
			VAR _AnimStagger           = 0.1          -- seconds delay between bars
			
			-- Tier colors
			VAR _ColorNone             = "#9E9E9E"
			VAR _ColorSolo             = "#CFEFEA"
			VAR _ColorSmallCrew        = "#E8D1A8"
			VAR _ColorSquad            = "#B18FCF"
			VAR _ColorLargeCast        = "#F07F5A"
			
			-- ============================================
			-- === COMPUTED LAYOUT (do not edit) ==========
			-- ============================================
			
			VAR _NumBars       = 5
			VAR _SvgHeight     = _TopPadding + _ChartHeight + _BottomPadding
			VAR _BarSlot       = DIVIDE ( _ChartHeight, _NumBars )
			VAR _BarHeight     = _BarSlot - _BarGap
			VAR _BarStartX     = _CategoryLabelWidth + _CategoryBarGap
			VAR _MaxBarWidth   = _SvgWidth - _BarStartX - _ValueLabelWidth
			
			-- ============================================
			-- === DATA PREPARATION =======================
			-- ============================================
			
			VAR _TotalSets  = CALCULATE ( COUNTROWS ( sets ) )
			VAR _CountNone  = CALCULATE ( COUNTROWS ( sets ), sets[minifig_tier] = "None" )
			VAR _CountSolo  = CALCULATE ( COUNTROWS ( sets ), sets[minifig_tier] = "Solo" )
			VAR _CountSmall = CALCULATE ( COUNTROWS ( sets ), sets[minifig_tier] = "Small Crew" )
			VAR _CountSquad = CALCULATE ( COUNTROWS ( sets ), sets[minifig_tier] = "Squad" )
			VAR _CountLarge = CALCULATE ( COUNTROWS ( sets ), sets[minifig_tier] = "Large Cast" )
			
			VAR _MaxCount =
			    MAX ( _CountNone, MAX ( _CountSolo, MAX ( _CountSmall, MAX ( _CountSquad, _CountLarge ) ) ) )
			
			-- ============================================
			-- === BARS (staggered grow-right animation) ==
			-- ============================================
			
			VAR _Bar1 =
			    VAR Y = _TopPadding + 0 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountNone, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountNone, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountNone, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 0 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>None</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorNone & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>None: " & FORMAT ( _CountNone, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar2 =
			    VAR Y = _TopPadding + 1 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountSolo, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountSolo, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountSolo, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 1 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Solo</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorSolo & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Solo: " & FORMAT ( _CountSolo, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar3 =
			    VAR Y = _TopPadding + 2 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountSmall, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountSmall, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountSmall, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 2 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Small Crew</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorSmallCrew & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Small Crew: " & FORMAT ( _CountSmall, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar4 =
			    VAR Y = _TopPadding + 3 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountSquad, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountSquad, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountSquad, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 3 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Squad</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorSquad & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Squad: " & FORMAT ( _CountSquad, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bar5 =
			    VAR Y = _TopPadding + 4 * _BarSlot + _BarGap / 2
			    VAR YMid = Y + _BarHeight / 2 + 6
			    VAR W = DIVIDE ( _CountLarge, _MaxCount ) * _MaxBarWidth
			    VAR Pct = FORMAT ( DIVIDE ( _CountLarge, _TotalSets ), "0.0%" )
			    VAR ValueLabel = FORMAT ( _CountLarge, "#,0" ) & " (" & Pct & ")"
			    VAR Delay = 4 * _AnimStagger
			    RETURN
			        "<text x='" & _CategoryLabelWidth & "' y='" & YMid & "' text-anchor='end' font-size='" & _CategoryFontSize &
			        "' font-family='" & _FontFamily & "' fill='" & _CategoryLabelColor & "'>Large Cast</text>" &
			        "<rect x='" & _BarStartX & "' y='" & Y & "' width='0' height='" & _BarHeight &
			        "' rx='" & _BarCornerRadius & "' fill='" & _ColorLargeCast & "'>" &
			        "<animate attributeName='width' from='0' to='" & W & "' begin='" & Delay & "s' dur='" & _AnimDuration &
			        "s' fill='freeze' calcMode='spline' keySplines='0.22 1 0.36 1'/>" &
			        "<title>Large Cast: " & FORMAT ( _CountLarge, "#,0" ) & " sets (" & Pct & ")</title></rect>" &
			        "<text x='" & ( _BarStartX + W + _BarValueGap ) & "' y='" & YMid &
			        "' text-anchor='start' font-size='" & _ValueLabelFontSize & "' font-family='" & _FontFamily &
			        "' fill='" & _ValueLabelColor & "' opacity='0'>" & ValueLabel &
			        "<animate attributeName='opacity' from='0' to='1' begin='" & ( Delay + _AnimDuration ) &
			        "s' dur='0.25s' fill='freeze'/></text>"
			
			VAR _Bars = _Bar1 & _Bar2 & _Bar3 & _Bar4 & _Bar5
			
			-- ============================================
			-- === ASSEMBLE FINAL HTML ====================
			-- ============================================
			
			VAR _HTML =
			    "<div style='width:100%;height:100%;overflow:hidden;'>" &
			    "<svg viewBox='0 0 " & _SvgWidth & " " & _SvgHeight &
			    "' style='width:100%;height:100%;display:block' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'>" &
			    "<g>" & _Bars & "</g>" &
			    "</svg>" &
			    "</div>"
			
			RETURN _HTML
		displayFolder: Page 2 Parts
		lineageTag: 5264a1bc-7398-4702-8b2c-c566c9df0bd7

	measure 'HTML Matrix Color Set Detail' =
			
			
			//==================================================================================================
			// SECTION 1 - CONFIGURATION
			//==================================================================================================
			
			VAR FontFamily            = "'Segoe UI'"
			VAR FontSize              = 17
			VAR HeaderFontSize        = 19
			VAR HeaderFontWeight      = "bold"
			
			VAR HeaderBackground      = "#FFFFFF"
			VAR HeaderTextColor       = "#333333"
			VAR HeaderBorderColor     = "#D9D9D9"
			
			VAR RowBorderColor        = "#ECECEC"
			VAR AlternateRowColor     = "#F8F8F8"
			VAR HoverRowColor         = "#EEF7FF"
			
			VAR CellPadding           = "8px"
			
			VAR ImageWidth            = 80
			VAR ImageHeight           = 60
			VAR ImageBorderRadius     = 6
			
			VAR SwatchSize            = 14
			VAR SwatchGap             = 2
			VAR SwatchRadius          = 3
			VAR SwatchBorderColor     = "#BBBBBB"
			
			VAR HeaderBorderWidth  = 2
			VAR RowBorderWidth     = 1
			VAR HeaderAlign        = "left"
			VAR CellAlign          = "left"
			VAR HeaderShadow       = "0 2px 4px rgba(0,0,0,.08)"
			VAR TableBorderRadius  = 8
			
			//==================================================================================================
			// SECTION 2 - CSS
			//==================================================================================================
			
			VAR CSS =
			
			"<style>
			
			html, body{ height:100%; margin:0; padding:0; overflow:hidden; }
			
			table{
			width:100%;
			border-collapse:collapse;
			font-family:" & FontFamily & ";
			font-size:" & FontSize & "px;
			border-collapse:separate;
			border-spacing:0;
			border-radius:" & TableBorderRadius & "px;
			overflow:hidden;
			}
			
			thead th{
			background:" & HeaderBackground & ";
			color:" & HeaderTextColor & ";
			font-size:" & HeaderFontSize & "px;
			font-weight:" & HeaderFontWeight & ";
			padding:" & CellPadding & ";
			text-align:left;
			border-bottom:2px solid " & HeaderBorderColor & ";
			z-index:999;
			box-shadow:" & HeaderShadow & ";
			position:relative;
			will-change:transform;
			}
			
			tbody td{
			padding:" & CellPadding & ";
			border-bottom:1px solid " & RowBorderColor & ";
			vertical-align:middle;
			}
			
			tbody tr:nth-child(even){
			background:" & AlternateRowColor & ";
			}
			
			tbody tr:hover{
			background:" & HoverRowColor & ";
			}
			
			</style>"
			
			
			
			//==================================================================================================
			// SECTION 3 - TABLE BODY
			//==================================================================================================
			
			VAR TableRows =
			
			CONCATENATEX(
			
			    decade_lego_set_color_rgb,
			
			    VAR CurrentColors = decade_lego_set_color_rgb[Colors]
			    VAR CurrentColorNames = decade_lego_set_color_rgb[Colors Name]
			
			    VAR CleanColors0 =
			        SUBSTITUTE(
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    CurrentColors,
			                    "||||","|"
			                ),
			                "|||","|"
			            ),
			            "||","|"
			        )
			    VAR CleanColorNames0 =
			        SUBSTITUTE(
			            SUBSTITUTE(
			                SUBSTITUTE(
			                    CurrentColorNames,
			                    "||||","|"
			                ),
			                "|||","|"
			            ),
			            "||","|"
			        )
			
			    VAR CleanColors1 =
			        IF( LEFT(CleanColors0,1)="|", MID(CleanColors0, 2, LEN(CleanColors0)-1), CleanColors0 )
			    VAR CleanColors =
			        IF( RIGHT(CleanColors1,1)="|", LEFT(CleanColors1, LEN(CleanColors1)-1), CleanColors1 )
			
			    VAR CleanColorNames1 =
			        IF( LEFT(CleanColorNames0,1)="|", MID(CleanColorNames0, 2, LEN(CleanColorNames0)-1), CleanColorNames0 )
			    VAR CleanColorNames =
			        IF( RIGHT(CleanColorNames1,1)="|", LEFT(CleanColorNames1, LEN(CleanColorNames1)-1), CleanColorNames1 )
			
			    VAR ColorCount =
			        IF(
			            ISBLANK(CleanColors) || CleanColors="",
			            0,
			            PATHLENGTH(CleanColors)
			        )
			    VAR Swatches =
			        CONCATENATEX(
			            GENERATESERIES(1,ColorCount),
			            VAR Hex =
			                TRIM(
			                    PATHITEM(
			                        CleanColors,
			                        [Value],
			                        TEXT
			                    )
			                )
			            VAR ColorName =
			                TRIM(
			                    PATHITEM(
			                        CleanColorNames,
			                        [Value],
			                        TEXT
			                    )
			                )
			            RETURN
			                IF(
			                    LEN(Hex)=6,
			                    "<span style='display:inline-block;
			                    width:" & SwatchSize & "px;
			                    height:" & SwatchSize & "px;
			                    background:#" & Hex & ";
			                    border:1px solid " & SwatchBorderColor & ";
			                    border-radius:" & SwatchRadius & "px;
			                    margin-right:" & SwatchGap & "px;
			                    margin-bottom:" & SwatchGap & "px;'
			                    title='" &
			                        IF(
			                            ColorName <> "",
			                            ColorName & " (#" & Hex & ")",
			                            "#" & Hex
			                        ) &
			                    "'></span>",
			                    ""
			                ),
			            ""
			        )
			    RETURN
			
			    "<tr>
			
			        <td>" & decade_lego_set_color_rgb[Decade] & "</td>
			        <td>" & decade_lego_set_color_rgb[Color Variety Tier] & "</td>
			        <td>" & decade_lego_set_color_rgb[SetName] & "</td>
			        <td style='text-align:center;'>
			            <img src='" &
			                decade_lego_set_color_rgb[Image] &
			            "' style='
			                max-width:" & ImageWidth & "px;
			                max-height:" & ImageHeight & "px;
			                border-radius:" & ImageBorderRadius & "px;'>
			        </td>
			        <td>" & Swatches & "</td>
			
			    </tr>",
			    "",
			
			    decade_lego_set_color_rgb[Decade Order], DESC,
			    decade_lego_set_color_rgb[Color Variety Order], ASC
			)
			
			//==================================================================================================
			// SECTION 4 - SCROLL-DRIVEN HEADER FREEZE (replaces position:sticky, which fails under a transformed ancestor)
			//==================================================================================================
			
			VAR ScrollScript =
			"<script>
			(function(){
			    var scroller = document.currentScript.previousElementSibling;
			    if(!scroller) return;
			    function sync(){
			        var y = scroller.scrollTop;
			        scroller.querySelectorAll('thead th').forEach(function(el){
			            el.style.transform = 'translateY(' + y + 'px)';
			        });
			    }
			    scroller.addEventListener('scroll', sync);
			    sync();
			})();
			</script>"
			
			//==================================================================================================
			// SECTION 5 - FINAL HTML
			//==================================================================================================
			
			RETURN
			
			CSS &
			
			"<div class='scroll-area' style='position:absolute;top:0;right:0;bottom:0;left:0;overflow:auto;'>
			    <table>
			
			        <thead>
			            <tr>
			                <th style='width:90px;text-align:center;'>Decade</th>
			                <th style='width:200px;text-align:center;'>Color Variety Tier</th>
			                <th style='width:200px;text-align:center'>Representative Set</th>
			                <th style='width:0px;text-align:left;'></th>
			                <th style='width:260px;text-align:center;'>Colors Used</th>
			            </tr>
			        </thead>
			
			        <tbody>
			            " & TableRows & "
			        </tbody>
			    </table>
			</div>" &
			ScrollScript
		displayFolder: Page 3 Color
		lineageTag: 1384263b-337b-4be9-9ab3-cec2f80f7d6e
		dataCategory: ImageUrl

	measure 'HTML Matrix Color Timeline' =
			
			
			VAR FontFamily        = "'Segoe UI'"
			VAR FontSize          = 17
			VAR HeaderFontSize    = 17
			VAR HeaderFontWeight  = "bold"
			VAR HeaderBackground  = "#FFFFFF"
			VAR HeaderTextColor   = "#333333"
			VAR HeaderBorderColor = "#D9D9D9"
			VAR RowBorderColor    = "#ECECEC"
			VAR AlternateRowColor = "#F8F8F8"
			VAR HoverRowColor     = "#EEF7FF"
			VAR GroupHeaderBg     = "#EFEFEF"
			VAR SubHeaderBg       = "#F5F5F5"
			VAR RowVerticalPadding   = 1
			VAR RowHorizontalPadding = 6
			VAR LabelColWidth     = 220
			VAR YearColWidth      = 28
			VAR SwatchSize        = 20
			VAR SwatchCellPadding = 2
			VAR MiniSwatchSize    = 10
			VAR MaxMiniSwatches   = 6
			VAR TableBorderRadius = 8
			VAR HeaderShadow      = "0 2px 4px rgba(0,0,0,.08)"
			VAR InactiveColor     = "#FFFFFF"
			VAR IndentPerLevel    = 18
			VAR YearLabelFontSize = 16
			
			VAR YearCols = SUMMARIZE(dim_year, dim_year[year], dim_year[decade])
			VAR DecadeGroups = SUMMARIZE(dim_year, dim_year[decade])
			VAR MinYearAll = MINX(YearCols, dim_year[year])
			VAR YearColCount = COUNTROWS(YearCols)
			
			VAR CSS =
			"<style>
			html, body{ height:100%; margin:0; padding:0; overflow:hidden; }
			table{
			border-collapse:separate;border-spacing:0;table-layout:fixed;
			font-family:" & FontFamily & ";font-size:" & FontSize & "px;
			border-radius:" & TableBorderRadius & "px;overflow:hidden;
			}
			thead th{
			background:" & HeaderBackground & ";color:" & HeaderTextColor & ";
			font-size:" & HeaderFontSize & "px;font-weight:" & HeaderFontWeight & ";
			padding:" & RowVerticalPadding & "px " & RowHorizontalPadding & "px;text-align:center;
			border-bottom:2px solid " & HeaderBorderColor & ";z-index:999;box-shadow:" & HeaderShadow & ";
			overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
			position:relative;will-change:transform;
			}
			th.lbl, td.lbl{ position:relative; text-align:left; will-change:transform; }
			th.lbl{ z-index:1000; background:" & HeaderBackground & "; }
			tbody td{
			padding:" & RowVerticalPadding & "px " & RowHorizontalPadding & "px; border-bottom:1px solid " & RowBorderColor & ";vertical-align:middle;color:" & HeaderTextColor & ";
			overflow:hidden;
			}
			tbody tr:nth-child(even) td{ background:" & AlternateRowColor & "; }
			tbody tr:nth-child(even) td.lbl{ background:" & AlternateRowColor & "; }
			tbody tr:hover td{ background:" & HoverRowColor & "; }
			tr.group-header td{ background:" & GroupHeaderBg & " !important;font-weight:bold; }
			tr.subgroup-header td{ background:" & SubHeaderBg & " !important;font-weight:600;cursor:pointer;user-select:none; }
			tr.subgroup-header:hover td{ background:#EBEBEB !important; }
			tr.leaf-row{ display:none; }
			tr.leaf-row.expanded{ display:table-row; }
			td.lbl{ background:#FFFFFF; white-space:nowrap; z-index:2; }
			td.cell{ text-align:center; padding:" & SwatchCellPadding & "px; }
			td.timeline{ padding:0; position:relative; height:" & SwatchSize & "px; }
			div.timeline-track{ position:relative; width:100%; height:100%; }
			span.swatch{ display:inline-block;width:" & SwatchSize & "px;height:" & SwatchSize & "px;border-radius:3px;border:1px solid #DDDDDD; }
			span.mini-swatch{ display:inline-block;width:" & MiniSwatchSize & "px;height:" & MiniSwatchSize & "px;border-radius:2px;margin:1px; }
			div.mini-swatch-row{ display:flex;flex-wrap:wrap;justify-content:center;align-items:center;max-width:" & YearColWidth & "px; }
			span.toggle-icon{ display:inline-block;width:14px;font-size:10px;color:#666666; }
			</style>"
			
			VAR ColGroup =
			    "<colgroup>
			        <col style='width:" & LabelColWidth & "px;'>" &
			    CONCATENATEX(YearCols, "<col style='width:" & YearColWidth & "px;'>", "", dim_year[year], ASC) &
			    "</colgroup>"
			
			VAR DecadeHeaderRow =
			    "<tr>
			        <th class='lbl' rowspan='2'>Color Hierarchy</th>" &
			    CONCATENATEX(
			        DecadeGroups,
			        VAR ThisDecade = dim_year[decade]
			        VAR SpanCount = CALCULATE(DISTINCTCOUNT(dim_year[year]), ALLEXCEPT(dim_year, dim_year[decade]))
			        RETURN "<th colspan='" & SpanCount & "'>" & ThisDecade & "</th>",
			        "",
			        dim_year[decade], ASC
			    ) &
			    "</tr>"
			
			VAR YearHeaderRow =
			    "<tr>" &
			    CONCATENATEX(
			        YearCols,
			        "<th style='font-size:" & YearLabelFontSize & "px;font-weight:normal;'>" & RIGHT(dim_year[year], 2) & "</th>",
			        "",
			        dim_year[year], ASC
			    ) &
			    "</tr>"
			
			//VAR AllColors = ALL(colors)
			VAR AllColors = CALCULATETABLE(colors, ALL(dim_year))
			
			VAR SuperGroups = SUMMARIZE(AllColors, colors[color_super_group])
			
			VAR TableRows =
			    CONCATENATEX(
			        SuperGroups,
			        VAR ThisSuperGroup = colors[color_super_group]
			        VAR SuperGroupIndex = COUNTROWS(FILTER(SuperGroups, colors[color_super_group] <= ThisSuperGroup))
			
			        VAR HeaderRow =
			            "<tr class='group-header'>
			                <td class='lbl' style='padding-left:" & RowHorizontalPadding & "px;'>" & ThisSuperGroup & "</td>" &
			            CONCATENATEX(YearCols, "<td></td>", "", dim_year[year], ASC) &
			            "</tr>"
			
			        VAR GroupsInSuperGroup =
			            SUMMARIZE(
			                FILTER(AllColors, colors[color_super_group] = ThisSuperGroup),
			                colors[color_group]
			            )
			
			        VAR GroupBlocks =
			            CONCATENATEX(
			                GroupsInSuperGroup,
			                VAR ThisGroup = colors[color_group]
			                VAR GroupId = "g" & SuperGroupIndex & "_" & COUNTROWS(FILTER(GroupsInSuperGroup, colors[color_group] <= ThisGroup))
			
			                VAR ColorsInGroup =
			                    SUMMARIZE(
			                        FILTER(AllColors, colors[color_group] = ThisGroup),
			                        colors[Color], colors[rgb]
			                    )
			
			                VAR GroupCells =
			                    CONCATENATEX(
			                        YearCols,
			                        VAR ThisYear = dim_year[year]
			                        VAR ActiveColorsThisYear =
			                            FILTER(
			                                ColorsInGroup,
			                                VAR ThisColorInLoop = colors[Color]
			                                RETURN
			                                    COUNTROWS(
			                                        FILTER(
			                                            AllColors,
			                                            colors[Color] = ThisColorInLoop &&
			                                            colors[color_group] = ThisGroup &&
			                                            colors[year_release] <= ThisYear &&
			                                            (colors[year_stop] >= ThisYear || ISBLANK(colors[year_stop]))
			                                        )
			                                    ) > 0
			                            )
			                        VAR SwatchesToShow = TOPN(MaxMiniSwatches, ActiveColorsThisYear, colors[Color], ASC)
			                        VAR MiniSwatches =
			                            CONCATENATEX(
			                                SwatchesToShow,
			                                "<span class='mini-swatch' style='background:#" & colors[rgb] & ";' title='" & colors[Color] & "'></span>",
			                                "",
			                                colors[Color], ASC
			                            )
			                        RETURN
			                            "<td class='cell'><div class='mini-swatch-row'>" & MiniSwatches & "</div></td>",
			                        "",
			                        dim_year[year], ASC
			                    )
			
			                VAR SubHeaderRow =
			                    "<tr class='subgroup-header' onclick=""
			                        var rows=document.querySelectorAll('.leaf-" & GroupId & "');
			                        var icon=document.getElementById('icon-" & GroupId & "');
			                        var isOpen=rows.length>0 && rows[0].classList.contains('expanded');
			                        rows.forEach(function(r){ r.classList.toggle('expanded', !isOpen); });
			                        icon.textContent = isOpen ? '\u25B8' : '\u25BE';
			                    "">
			                        <td class='lbl' style='padding-left:" & (IndentPerLevel + 8) & "px;'>
			                            <span class='toggle-icon' id='icon-" & GroupId & "'>" & UNICHAR(9656) & "</span>" & ThisGroup &
			                        "</td>" &
			                    GroupCells &
			                    "</tr>"
			
			                -- leaf rows: compute contiguous active-year islands, render one bar segment per island
			                VAR ColorRows =
			                    CONCATENATEX(
			                        ColorsInGroup,
			                        VAR ThisColorName = colors[Color]
			                        VAR ThisHex = "#" & colors[rgb]
			
			                        VAR ActiveYearsTable =
			                            FILTER(
			                                YearCols,
			                                COUNTROWS(
			                                    FILTER(
			                                        AllColors,
			                                        colors[Color] = ThisColorName &&
			                                        colors[year_release] <= dim_year[year] &&
			                                        (colors[year_stop] >= dim_year[year] || ISBLANK(colors[year_stop]))
			                                    )
			                                ) > 0
			                            )
			                        VAR IndexedActiveYears =
			                            ADDCOLUMNS(
			                                ActiveYearsTable,
			                                "idx", RANKX(ActiveYearsTable, dim_year[year], , ASC, DENSE)
			                            )
			                        VAR WithGrp =
			                            ADDCOLUMNS(
			                                IndexedActiveYears,
			                                "grp", dim_year[year] - [idx]
			                            )
			                        VAR Islands =
			                            GROUPBY(
			                                WithGrp,
			                                [grp],
			                                "start_year", MINX(CURRENTGROUP(), dim_year[year]),
			                                "end_year", MAXX(CURRENTGROUP(), dim_year[year])
			                            )
			                        VAR SegmentsHtml =
			                            CONCATENATEX(
			                                Islands,
			                                VAR LeftPx = ([start_year] - MinYearAll) * YearColWidth
			                                VAR WidthPx = ([end_year] - [start_year] + 1) * YearColWidth
			                                VAR Tooltip = ThisColorName & ": " & [start_year] & "-" & [end_year]
			                                RETURN
			                                    "<div style='position:absolute;left:" & LeftPx & "px;top:2px;bottom:2px;width:" & (WidthPx - 2) & "px;background:" & ThisHex & ";border-radius:3px;border:1px solid #DDDDDD;' title='" & Tooltip & "'></div>",
			                                "",
			                                [start_year], ASC
			                            )
			
			                        RETURN
			                            "<tr class='leaf-row leaf-" & GroupId & "'>
			                                <td class='lbl' style='padding-left:" & (IndentPerLevel * 2 + 8) & "px;'>" & ThisColorName & "</td>
			                                <td class='timeline' colspan='" & YearColCount & "'>
			                                    <div class='timeline-track'>" & SegmentsHtml & "</div>
			                                </td>
			                            </tr>",
			                        "",
			                        colors[Color], ASC
			                    )
			
			                RETURN SubHeaderRow & ColorRows,
			                "",
			                colors[color_group], ASC
			            )
			
			        RETURN HeaderRow & GroupBlocks,
			        "",
			        colors[color_super_group], ASC
			    )
			
			VAR ScrollScript =
			"<script>
			(function(){
			    var scroller = document.currentScript.previousElementSibling;
			    if(!scroller) return;
			    function sync(){
			        var x = scroller.scrollLeft, y = scroller.scrollTop;
			        scroller.querySelectorAll('thead th:not(.lbl)').forEach(function(el){
			            el.style.transform = 'translateY(' + y + 'px)';
			        });
			        scroller.querySelectorAll('tbody td.lbl').forEach(function(el){
			            el.style.transform = 'translateX(' + x + 'px)';
			        });
			        scroller.querySelectorAll('thead th.lbl').forEach(function(el){
			            el.style.transform = 'translate(' + x + 'px,' + y + 'px)';
			        });
			    }
			    scroller.addEventListener('scroll', sync);
			    sync();
			})();
			</script>"
			
			RETURN
			CSS &
			"<div class='scroll-area' style='position:absolute;top:0;right:0;bottom:0;left:0;overflow:auto;'>
			    <table>" & ColGroup & "
			        <thead>" & DecadeHeaderRow & YearHeaderRow & "</thead>
			        <tbody>" & TableRows & "</tbody>
			    </table>
			</div>" &
			ScrollScript
		displayFolder: Page 3 Color
		lineageTag: 73466580-88a4-4481-b6cd-7f57496e3981
		dataCategory: ImageUrl

	measure 'HTML Barchart Color Lifespan' =
			
			
			//==================================================================================================
			// CONFIGURATION
			//==================================================================================================
			
			VAR RankCount           = COALESCE(MAX('Color TOP N'[Value]), 10)
			VAR FontFamily          = "'Segoe UI'"
			VAR FontSize            = 19
			VAR HeaderFontSize      = 21
			VAR TitleColor          = "#000000"
			VAR RankColWidth        = 46
			VAR ColumnGap           = 28
			VAR BarMaxWidth         = 220
			VAR BarHeight           = 20
			VAR BarRadius           = 10
			VAR BarBorderColor      = "#DDDDDD"
			VAR MinBarWidth         = 5
			VAR RowGap              = 10
			VAR AnimDuration        = 0.9
			VAR AnimStagger         = 0.06
			VAR LabelFontSize       = 16
			VAR RankTextColor       = "#000000"
			VAR LeftTitle           = "Longest-Living Colors"
			VAR RightTitle          = "Shortest-Living Colors"
			VAR LeftAccent          = "#0055BF"
			VAR RightAccent         = "#C91A09"
			
			//==================================================================================================
			// DATA
			//==================================================================================================
			
			VAR EffectiveEndYear = MAX(dim_year[year])
			
			VAR FilteredColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_release] <= EffectiveEndYear
			    )
			
			VAR ColorsWithLifespan =
			    ADDCOLUMNS(
			        FilteredColors,
			        "Lifespan", MIN(colors[year_stop], EffectiveEndYear) - colors[year_release]
			    )
			
			-- Longest: tie-break by color_id (unique) ascending, unchanged
			VAR LongestRanked =
			    ADDCOLUMNS(
			        ColorsWithLifespan,
			        "RankNum",
			            VAR ThisLifespan = [Lifespan]
			            VAR ThisColorId = colors[color_id]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        ColorsWithLifespan,
			                        [Lifespan] > ThisLifespan ||
			                        ([Lifespan] = ThisLifespan && colors[color_id] < ThisColorId)
			                    )
			                ) + 1
			    )
			VAR LongestTop = FILTER(LongestRanked, [RankNum] <= RankCount)
			
			-- Shortest: tie-break by year_release DESCENDING (as requested), then color_id ASC as a final
			-- guaranteed-unique tiebreaker so two colors can never compute the same RankNum
			VAR ShortestRanked =
			    ADDCOLUMNS(
			        ColorsWithLifespan,
			        "RankNum",
			            VAR ThisLifespan = [Lifespan]
			            VAR ThisRelease = colors[year_release]
			            VAR ThisColorId = colors[color_id]
			            RETURN
			                COUNTROWS(
			                    FILTER(
			                        ColorsWithLifespan,
			                        [Lifespan] < ThisLifespan ||
			                        ([Lifespan] = ThisLifespan && colors[year_release] > ThisRelease) ||
			                        ([Lifespan] = ThisLifespan && colors[year_release] = ThisRelease && colors[color_id] < ThisColorId)
			                    )
			                ) + 1
			    )
			VAR ShortestTop = FILTER(ShortestRanked, [RankNum] <= RankCount)
			
			VAR MaxLongestLifespan = MAXX(LongestTop, [Lifespan])
			VAR MaxShortestLifespan = MAX(MAXX(ShortestTop, [Lifespan]), 1)
			
			//==================================================================================================
			// CSS
			//==================================================================================================
			
			VAR CSS =
			"<style>
			html, body{ height:100%; margin:0; padding:0; overflow:hidden; }
			.tornado-wrap{ font-family:" & FontFamily & "; font-size:" & FontSize & "px; position:absolute; top:0; right:0; bottom:0; left:0; display:flex; flex-direction:column; }
			.tornado-header{
			display:grid; grid-template-columns:1fr " & RankColWidth & "px 1fr; column-gap:" & ColumnGap & "px;
			font-size:" & HeaderFontSize & "px; font-weight:700; color:" & TitleColor & ";
			padding-bottom:8px; border-bottom:1px solid #EEEEEE; flex-shrink:0;
			}
			.tornado-header .left{ text-align:right; color:" & LeftAccent & "; }
			.tornado-header .right{ text-align:left; color:" & RightAccent & "; }
			.tornado-header .mid{ text-align:center; }
			.tornado-scroll{ flex:1 1 auto; overflow-y:auto; padding-top:8px; }
			.tornado-row{
			display:grid; grid-template-columns:1fr " & RankColWidth & "px 1fr; column-gap:" & ColumnGap & "px;
			align-items:center; margin-bottom:" & RowGap & "px;
			}
			.side{ display:flex; align-items:center; height:" & BarHeight & "px; }
			.side.left{ justify-content:flex-end; }
			.side.right{ justify-content:flex-start; }
			.bar{
			height:" & BarHeight & "px; border-radius:" & BarRadius & "px; border:1px solid " & BarBorderColor & ";
			flex-shrink:0;
			}
			.lbl{ font-size:" & LabelFontSize & "px; white-space:nowrap; color:" & TitleColor & "; }
			.lbl.left{ margin-right:6px; text-align:right; }
			.lbl.right{ margin-left:6px; text-align:left; }
			.rank{
			display:flex; align-items:center; justify-content:center;
			width:" & RankColWidth & "px;
			color:" & RankTextColor & ";
			font-weight:700; font-size:" & LabelFontSize & "px; margin:0 auto;
			}
			</style>"
			
			//==================================================================================================
			// ROWS
			//==================================================================================================
			
			VAR RankSeries = GENERATESERIES(1, RankCount, 1)
			
			VAR RowsMarkup =
			    CONCATENATEX(
			        RankSeries,
			        VAR ThisRank = [Value]
			        VAR AnimDelay = (ThisRank - 1) * AnimStagger
			
			        VAR LRow = FILTER(LongestTop, [RankNum] = ThisRank)
			        VAR LHasData = NOT ISEMPTY(LRow)
			        VAR LName = MAXX(LRow, colors[Color])
			        VAR LHex = "#" & MAXX(LRow, colors[rgb])
			        VAR LLifespan = MAXX(LRow, [Lifespan])
			        VAR LWidth = IF(LHasData, MAX(DIVIDE(LLifespan, MaxLongestLifespan) * BarMaxWidth, MinBarWidth), 0)
			        VAR LKeyframe = "gL" & ThisRank
			        VAR LBar =
			            IF(
			                LHasData,
			                "<style>@keyframes " & LKeyframe & "{from{width:0px}to{width:" & LWidth & "px}}</style>" &
			                "<div class='side left'>" &
			                    "<span class='lbl left'>" & LName & " &middot; " & FORMAT(LLifespan,"0") & " yrs</span>" &
			                    "<div class='bar' style='background:" & LHex & ";width:0px;animation:" & LKeyframe & " " & AnimDuration & "s ease-out " & AnimDelay & "s both;'></div>" &
			                "</div>",
			                "<div class='side left'></div>"
			            )
			
			        VAR RRow = FILTER(ShortestTop, [RankNum] = ThisRank)
			        VAR RHasData = NOT ISEMPTY(RRow)
			        VAR RName = MAXX(RRow, colors[Color])
			        VAR RHex = "#" & MAXX(RRow, colors[rgb])
			        VAR RLifespan = MAXX(RRow, [Lifespan])
			        VAR RWidth = IF(RHasData, MAX(DIVIDE(RLifespan, MaxShortestLifespan) * BarMaxWidth, MinBarWidth), 0)
			        VAR RKeyframe = "gR" & ThisRank
			        VAR RBar =
			            IF(
			                RHasData,
			                "<style>@keyframes " & RKeyframe & "{from{width:0px}to{width:" & RWidth & "px}}</style>" &
			                "<div class='side right'>" &
			                    "<div class='bar' style='background:" & RHex & ";width:0px;animation:" & RKeyframe & " " & AnimDuration & "s ease-out " & AnimDelay & "s both;'></div>" &
			                    "<span class='lbl right'>" & RName & " &middot; " & FORMAT(RLifespan,"0") & " yrs</span>" &
			                "</div>",
			                "<div class='side right'></div>"
			            )
			
			        RETURN
			            IF(
			                LHasData || RHasData,
			                "<div class='tornado-row'>" &
			                    LBar &
			                    "<div class='rank'>#" & ThisRank & "</div>" &
			                    RBar &
			                "</div>",
			                ""
			            ),
			        "",
			        [Value], ASC
			    )
			
			//==================================================================================================
			// FINAL
			//==================================================================================================
			
			RETURN
			CSS &
			"<div class='tornado-wrap'>
			    <div class='tornado-header'>
			        <div class='left'>" & LeftTitle & "</div>
			        <div class='mid'>Rank</div>
			        <div class='right'>" & RightTitle & "</div>
			    </div>
			    <div class='tornado-scroll'>" & RowsMarkup & "</div>
			</div>"
		displayFolder: Page 3 Color
		lineageTag: d6396070-9456-4005-949a-c0825d9edc0b

	measure 'HTML Card Total Color Active' =
			
			VAR EffectiveEndYear = MAX(dim_year[year])
			VAR CurrentDecadeStart = INT(EffectiveEndYear / 10) * 10          -- e.g. 2020
			VAR PriorDecadeNaturalEnd = CurrentDecadeStart - 1                  -- e.g. 2019 (true end of 2010s)
			VAR PriorDecadeWindowStart = PriorDecadeNaturalEnd - 10              -- e.g. 2009
			
			VAR FilteredColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_stop] >= EffectiveEndYear - 10 &&
			        colors[year_release] <= EffectiveEndYear
			    )
			
			VAR ColorsWithLifespan =
			    ADDCOLUMNS(
			        FilteredColors,
			        "Lifespan", MIN(colors[year_stop], EffectiveEndYear) - colors[year_release]
			    )
			
			VAR _FormattedValue = COUNTROWS(ColorsWithLifespan)
			
			VAR PreviousFilteredColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_stop] >= PriorDecadeWindowStart &&
			        colors[year_release] <= PriorDecadeNaturalEnd
			    )
			VAR _PreviousValue = COUNTROWS(PreviousFilteredColors)
			
			VAR _Delta = _FormattedValue - _PreviousValue
			VAR _DeltaPct = DIVIDE(_Delta, _PreviousValue)
			VAR _IsFlat = _Delta = 0
			VAR _IsUp = _Delta > 0
			
			VAR _DeltaColor =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "#5F6368",
			        _IsUp,   "#1E8E3E",
			        "#D93025"
			    )
			VAR _DeltaBg =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "#F1F3F4",
			        _IsUp,   "#E6F4EA",
			        "#FCE8E6"
			    )
			VAR _DeltaArrow =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "&#9679;",
			        _IsUp,   "&#9650;",
			        "&#9660;"
			    )
			VAR _DeltaText =
			    SWITCH(
			        TRUE(),
			        MAX('dim_year'[decade]) = "1950s", "",
			        _IsFlat, _DeltaArrow & " (" & FORMAT(ABS(_Delta), "#,##0") & ")" & " No change vs last decade",
			        _DeltaArrow & " " & FORMAT(ABS(_Delta), "#,##0") & " (" & FORMAT(ABS(_DeltaPct), "0.0%") & ") vs last decade"
			    )
			
			VAR _UID = "c" & RANDBETWEEN( 10000000, 99999999 )
			VAR fontsize = 50
			VAR deltafontsize = 16
			VAR ValueToDeltaGap = 0
			VAR DeltaPillPaddingV = 2
			VAR DeltaPillPaddingH = 10
			VAR DeltaPillRadius = 12
			
			VAR _HTML =
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    align-items:flex-start;
			    justify-content:center;
			    font-family:Segoe UI, sans-serif;
			'>
			  <div id='" & _UID & "' style='
			      font-size:"& fontsize &"px;
			      font-weight:700;
			      color:#000000;
			      letter-spacing:1px;
			  '>0</div>
			
			  <div style='
			      margin-top:" & ValueToDeltaGap & "px;
			      display:inline-block;
			      font-size:" & deltafontsize & "px;
			      font-weight:600;
			      color:" & _DeltaColor & ";
			      background:" & _DeltaBg & ";
			      padding:" & DeltaPillPaddingV & "px " & DeltaPillPaddingH & "px;
			      border-radius:" & DeltaPillRadius & "px;
			  '>" & _DeltaText & "</div>
			
			  <img src='x' style='display:none' onerror=""
			    (function(){
			      var el = document.getElementById('" & _UID & "');
			      if (!el || el.getAttribute('data-animated') === 'true') return;
			      el.setAttribute('data-animated', 'true');
			
			      var target = " & _FormattedValue & ";
			      var duration = 1000;
			      var startTime = null;
			
			      function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
			      function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
			
			      function step(timestamp){
			        if (!startTime) startTime = timestamp;
			        var progress = Math.min((timestamp - startTime) / duration, 1);
			        var eased = easeOutCubic(progress);
			        el.textContent = formatNum(target * eased);
			        if (progress < 1) {
			          requestAnimationFrame(step);
			        } else {
			          el.textContent = '" & _FormattedValue & "';
			        }
			      }
			      requestAnimationFrame(step);
			    })();
			  "" />
			</div>"
			
			RETURN _HTML
		displayFolder: Page 3 Color
		lineageTag: c2efd650-30b0-41fb-aa7d-700aaaf8be2d

	measure 'HTML Card Total Color Release' =
			
			VAR EffectiveEndYear = MAX(dim_year[year])
			VAR CurrentDecadeStart = INT(EffectiveEndYear / 10) * 10          -- e.g. 2020
			VAR PriorDecadeStart = CurrentDecadeStart - 10                     -- e.g. 2010
			VAR PriorDecadeEnd = CurrentDecadeStart - 1                        -- e.g. 2019
			
			VAR FilteredColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_release] >= CurrentDecadeStart &&
			        colors[year_release] <= EffectiveEndYear                   -- <-- caps it to THIS decade only
			    )
			
			VAR _FormattedValue = COUNTROWS(FilteredColors)
			
			VAR PreviousFilteredColors =
			    FILTER(
			        ALL(colors),
			        colors[color_id] <> -1 &&
			        colors[color_id] <> 9999 &&
			        colors[year_release] >= PriorDecadeStart &&
			        colors[year_release] <= PriorDecadeEnd                     -- <-- same metric, prior decade
			    )
			VAR _PreviousValue = COUNTROWS(PreviousFilteredColors)
			
			VAR _Delta = _FormattedValue - _PreviousValue
			VAR _DeltaPct = DIVIDE(_Delta, _PreviousValue)
			VAR _IsFlat = _Delta = 0
			VAR _IsUp = _Delta > 0
			
			VAR _DeltaColor =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "#5F6368",
			        _IsUp,   "#1E8E3E",
			        "#D93025"
			    )
			VAR _DeltaBg =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "#F1F3F4",
			        _IsUp,   "#E6F4EA",
			        "#FCE8E6"
			    )
			VAR _DeltaArrow =
			    SWITCH(
			        TRUE(),
			        _IsFlat, "&#9679;",
			        _IsUp,   "&#9650;",
			        "&#9660;"
			    )
			VAR _DeltaText =
			    SWITCH(
			        TRUE(),
			        MAX('dim_year'[decade]) = "1950s", "",
			        _IsFlat, _DeltaArrow & " (" & FORMAT(ABS(_Delta), "#,##0") & ")" & " No change vs last decade",
			        _DeltaArrow & " " & FORMAT(ABS(_Delta), "#,##0") & " (" & FORMAT(ABS(_DeltaPct), "0.0%") & ") vs last decade"
			    )
			
			VAR _UID = "c" & RANDBETWEEN( 10000000, 99999999 )
			VAR fontsize = 50
			VAR deltafontsize = 16
			VAR ValueToDeltaGap = 0
			VAR DeltaPillPaddingV = 2
			VAR DeltaPillPaddingH = 10
			VAR DeltaPillRadius = 12
			
			VAR _HTML =
			"<div style='
			    width:100%;
			    height:100%;
			    display:flex;
			    flex-direction:column;
			    align-items:flex-start;
			    justify-content:center;
			    font-family:Segoe UI, sans-serif;
			'>
			  <div id='" & _UID & "' style='
			      font-size:"& fontsize &"px;
			      font-weight:700;
			      color:#000000;
			      letter-spacing:1px;
			  '>0</div>
			
			  <div style='
			      margin-top:" & ValueToDeltaGap & "px;
			      display:inline-block;
			      font-size:" & deltafontsize & "px;
			      font-weight:600;
			      color:" & _DeltaColor & ";
			      background:" & _DeltaBg & ";
			      padding:" & DeltaPillPaddingV & "px " & DeltaPillPaddingH & "px;
			      border-radius:" & DeltaPillRadius & "px;
			  '>" & _DeltaText & "</div>
			
			  <img src='x' style='display:none' onerror=""
			    (function(){
			      var el = document.getElementById('" & _UID & "');
			      if (!el || el.getAttribute('data-animated') === 'true') return;
			      el.setAttribute('data-animated', 'true');
			
			      var target = " & _FormattedValue & ";
			      var duration = 1000;
			      var startTime = null;
			
			      function easeOutCubic(t){ return 1 - Math.pow(1 - t, 3); }
			      function formatNum(n){ return Math.round(n).toLocaleString('en-US'); }
			
			      function step(timestamp){
			        if (!startTime) startTime = timestamp;
			        var progress = Math.min((timestamp - startTime) / duration, 1);
			        var eased = easeOutCubic(progress);
			        el.textContent = formatNum(target * eased);
			        if (progress < 1) {
			          requestAnimationFrame(step);
			        } else {
			          el.textContent = '" & _FormattedValue & "';
			        }
			      }
			      requestAnimationFrame(step);
			    })();
			  "" />
			</div>"
			
			RETURN _HTML
		displayFolder: Page 3 Color
