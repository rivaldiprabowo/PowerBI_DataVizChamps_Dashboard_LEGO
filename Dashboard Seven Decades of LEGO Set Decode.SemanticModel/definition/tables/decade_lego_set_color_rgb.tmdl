	partition decade_lego_set_color_rgb = calculated
		mode: import
		source =
				
				
				SELECTCOLUMNS (
				    SUMMARIZE (
				        sets,
				        sets[decade],
				        sets[decade_order],
				        sets[color_variety_tier],
				        sets[color_variety_order]
				    ),
				    "Decade", sets[decade],
				    "Decade Order", sets[decade_order],
				    "Color Variety Tier", sets[color_variety_tier],
				    "Color Variety Order",sets[color_variety_order],
				    "SetName",[Color Set Name],
				    "Image",[Color Set Image],
				    "Colors",CALCULATE(MAX(sets[set_colors_rgb])),
				    "Colors Name",CALCULATE(MAX(sets[set_colors]))
				)

	annotation PBI_Id = 057f5a8f80e24cf580c0d282688d0e36

