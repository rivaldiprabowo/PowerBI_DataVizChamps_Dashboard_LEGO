model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["inventories","inventory_sets","sets","themes","inventory_parts","parts","colors","part_categories","inventory_minifigs","minifigures"]

annotation PBI_ProTooling = ["CopilotTooling","Copilot","CopilotMeasureDescriptions","DevMode"]

ref table inventories
ref table sets
ref table themes
ref table inventory_parts
ref table parts
ref table colors
ref table inventory_minifigs
ref table minifigures
ref table _Measures
ref table inventory_sets
ref table part_categories
ref table dim_year
ref table decade_theme_highlights
ref table decade_lego_summary
ref table decade_lego_set_complex
ref table 'Matrix Complex Set'
ref table dim_set_complexity
ref table decade_lego_set_color_rgb
ref table HTML_Color_Rows
ref table 'Color TOP N'

ref cultureInfo en-US

